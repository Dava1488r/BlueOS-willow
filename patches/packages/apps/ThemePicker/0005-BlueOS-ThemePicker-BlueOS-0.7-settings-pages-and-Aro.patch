+    // ------------------------------------------------------------------ UI
+
+    private fun attrColor(attr: Int): Int {
+        val tv = TypedValue()
+        theme.resolveAttribute(attr, tv, true)
+        return if (tv.resourceId != 0) getColor(tv.resourceId) else tv.data
+    }
+
+    private val dark get() = (resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES
+    private val accent get() = getColor(if (dark) android.R.color.system_accent1_200 else android.R.color.system_accent1_600)
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val page = intent.getStringExtra(EXTRA_PAGE) ?: LOCK
+        val root = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setBackgroundColor(getColor(if (dark) android.R.color.system_surface_container_dark else android.R.color.system_surface_container_light))
+        }
+        // edge to edge: keep the content off the status and navigation bars
+        root.setOnApplyWindowInsetsListener { v, insets ->
+            val bars = insets.getInsets(android.view.WindowInsets.Type.systemBars())
+            v.setPadding(bars.left, bars.top, bars.right, 0)
+            insets
+        }
+        val bar = LinearLayout(this).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            setPadding((4 * dp).toInt(), (8 * dp).toInt(), (16 * dp).toInt(), (8 * dp).toInt())
+        }
+        bar.addView(ImageButton(this).apply {
+            setImageResource(com.android.wallpaper.R.drawable.ic_arrow_back_24px)
+            imageTintList = android.content.res.ColorStateList.valueOf(attrColor(android.R.attr.textColorPrimary))
+            background = null
+            contentDescription = getString(android.R.string.cancel)
+            setOnClickListener { finish() }
+        }, LinearLayout.LayoutParams((48 * dp).toInt(), (48 * dp).toInt()))
+        bar.addView(TextView(this).apply {
+            setText(when (page) { HOME -> R.string.blueos_s_page_home; WEATHER -> R.string.blueos_s_page_weather; else -> R.string.blueos_s_page_lock })
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 22f)
+            setTextColor(attrColor(android.R.attr.textColorPrimary))
+            setPadding((8 * dp).toInt(), 0, 0, 0)
+        })
+        root.addView(bar)
+        val list = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL; setPadding(0, 0, 0, (32 * dp).toInt()) }
+        val scroll = ScrollView(this).apply { addView(list); clipToPadding = false }
+        scroll.setOnApplyWindowInsetsListener { v, insets ->
+            v.setPadding(0, 0, 0, insets.getInsets(android.view.WindowInsets.Type.navigationBars()).bottom); insets
+        }
+        root.addView(scroll, LinearLayout.LayoutParams(-1, 0, 1f))
+        setContentView(root)
+        val items = when (page) { HOME -> homePage(); WEATHER -> weatherPage(); else -> lockPage() }
+        items.forEach { list.addView(build(it)) }
+        refresh()
+    }
+
+    override fun onResume() { super.onResume(); refresh() }
+
+    private fun refresh() = rows.forEach { (item, update) ->
+        update()
+    }
+
+    private fun build(item: Item): View {
+        val pad = (18 * dp).toInt()
+        val start = if (item.sub) (54 * dp).toInt() else pad
+        when (item) {
+            is Item.Header -> return TextView(this).apply {
+                setText(item.text)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                setTypeface(typeface, android.graphics.Typeface.BOLD)
+                setTextColor(accent)
+                setPadding(pad, (18 * dp).toInt(), pad, (6 * dp).toInt())
+            }
+            is Item.Divider -> return View(this).apply {
+                setBackgroundColor(attrColor(android.R.attr.textColorSecondary) and 0x22ffffff)
+                layoutParams = LinearLayout.LayoutParams(-1, (1 * dp).toInt()).apply { setMargins(pad, (8 * dp).toInt(), pad, (8 * dp).toInt()) }
+            }
+            else -> {}
+        }
+        val row = LinearLayout(this).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            setPadding(start, (12 * dp).toInt(), pad, (12 * dp).toInt())
+            minimumHeight = (56 * dp).toInt()
+            isClickable = item !is Item.Info
+            if (isClickable) {
+                val tv = TypedValue()
+                theme.resolveAttribute(android.R.attr.selectableItemBackground, tv, true)
+                setBackgroundResource(tv.resourceId)
+            }
+        }
+        val texts = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL }
+        val title = TextView(this).apply { setTextSize(TypedValue.COMPLEX_UNIT_SP, 16f); setTextColor(attrColor(android.R.attr.textColorPrimary)) }
+        val desc = TextView(this).apply { setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f); setTextColor(attrColor(android.R.attr.textColorSecondary)) }
+        texts.addView(title); texts.addView(desc)
+
+        fun setTexts(t: Int, d: CharSequence?) {
+            title.setText(t)
+            desc.text = d ?: ""
+            desc.visibility = if (d.isNullOrEmpty()) View.GONE else View.VISIBLE
+        }
+        val update: () -> Unit
+        when (item) {
+            is Item.Sw -> {
+                setTexts(item.title, item.desc?.let { getString(it) })
+                val sw = Switch(this).apply { isClickable = false; isFocusable = false }
+                row.addView(texts, LinearLayout.LayoutParams(0, -2, 1f))
+                row.addView(sw)
+                row.setOnClickListener { put(item.key, if (on(item.key)) 0 else 1) }
+                update = { sw.isChecked = on(item.key) }
+            }
+            is Item.Radio -> {
+                setTexts(item.title, item.desc?.let { getString(it) })
+                val rb = RadioButton(this).apply { isClickable = false; isFocusable = false }
+                row.addView(rb); row.addView(texts, LinearLayout.LayoutParams(0, -2, 1f))
+                row.setOnClickListener { put(item.key, item.value) }
+                update = { rb.isChecked = int(item.key) == item.value }
+            }
+            is Item.RadioStr -> {
+                setTexts(item.title, null)
+                val rb = RadioButton(this).apply { isClickable = false; isFocusable = false }
+                row.addView(rb); row.addView(texts, LinearLayout.LayoutParams(0, -2, 1f))
+                row.setOnClickListener { put(item.key, item.value) }
+                update = { rb.isChecked = K.string(contentResolver, item.key, item.def) == item.value }
+            }
+            is Item.Slider -> {
+                row.isClickable = false
+                row.background = null
+                setTexts(item.title, item.desc(int(item.key)))
+                val bar = SeekBar(this).apply { max = 100 }
+                texts.addView(bar, LinearLayout.LayoutParams(-1, -2).apply { topMargin = (6 * dp).toInt() })
+                row.addView(texts, LinearLayout.LayoutParams(0, -2, 1f))
+                bar.setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
+                    override fun onProgressChanged(s: SeekBar, p: Int, fromUser: Boolean) { if (fromUser) desc.text = item.desc(p) }
+                    override fun onStartTrackingTouch(s: SeekBar) {}
+                    override fun onStopTrackingTouch(s: SeekBar) { put(item.key, s.progress) }   // icons are redrawn once, on release
+                })
+                update = { bar.progress = int(item.key); desc.text = item.desc(int(item.key)) }
+            }
+            is Item.Btn -> {
+                setTexts(item.title, item.desc?.let { getString(it) })
+                row.addView(texts, LinearLayout.LayoutParams(0, -2, 1f))
+                row.setOnClickListener { item.onClick() }
+                update = {}
+            }
+            is Item.Info -> {
+                setTexts(item.title, getString(item.desc))
+                row.addView(texts, LinearLayout.LayoutParams(0, -2, 1f))
+                update = {}
+            }
+            else -> update = {}
+        }
+        rows += item to {
+            update()
+            val enabled = item.dep()
+            row.alpha = if (enabled) 1f else 0.38f
+            row.isEnabled = enabled
+            for (i in 0 until row.childCount) row.getChildAt(i).isEnabled = enabled
+        }
+        return row
+    }
+}

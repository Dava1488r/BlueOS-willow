diff --git a/src/com/android/customization/blueos/BlueOSAronaEditorActivity.kt b/src/com/android/customization/blueos/BlueOSAronaEditorActivity.kt
new file mode 100644
index 00000000..5491687f
--- /dev/null
+++ b/src/com/android/customization/blueos/BlueOSAronaEditorActivity.kt
@@ -0,0 +1,133 @@
+package com.android.customization.blueos
+
+import android.app.Activity
+import android.app.WallpaperManager
+import android.graphics.Color
+import android.graphics.drawable.GradientDrawable
+import android.os.Bundle
+import android.provider.Settings
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.MotionEvent
+import android.view.ScaleGestureDetector
+import android.view.View
+import android.widget.Button
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextView
+import com.android.themepicker.R
+import java.util.Locale
+import org.blueos.arona.AronaView
+import org.blueos.arona.BlueOSSettings as K
+
+/**
+ * BlueOS 0.7: where Arona stands in the "Свой" mode. Over the lock screen wallpaper: drag her with a finger,
+ * pinch to resize; «Готово» saves "cx;top;h" (fractions of the screen) and switches the mode to custom.
+ * (The lock screen itself can't be used: its long press belongs to Android, a swipe unlocks.)
+ */
+class BlueOSAronaEditorActivity : Activity() {
+    private lateinit var root: FrameLayout
+    private lateinit var arona: AronaView
+    private lateinit var frame: View
+    private var cx = 0.52f
+    private var top = 0.46f
+    private var h = 0.46f
+    private var lastX = 0f
+    private var lastY = 0f
+    private val dp get() = resources.displayMetrics.density
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        K.string(contentResolver, K.ARONA_CUSTOM, "").split(';').mapNotNull { it.toFloatOrNull() }
+            .takeIf { it.size == 3 }?.let { cx = it[0]; top = it[1]; h = it[2] }
+
+        root = FrameLayout(this).apply { setBackgroundColor(Color.BLACK) }
+        // the lock screen wallpaper (or the home one if there is no separate lock wallpaper)
+        val wm = WallpaperManager.getInstance(this)
+        val wallpaper = runCatching { wm.getDrawable(WallpaperManager.FLAG_LOCK) ?: wm.drawable }.getOrNull()
+        root.addView(ImageView(this).apply { setImageDrawable(wallpaper); scaleType = ImageView.ScaleType.CENTER_CROP },
+            FrameLayout.LayoutParams(-1, -1))
+        arona = AronaView(this)
+        root.addView(arona, FrameLayout.LayoutParams(0, 0))
+        frame = View(this).apply {
+            background = GradientDrawable().apply {
+                cornerRadius = 10 * dp
+                setStroke((2 * dp).toInt(), Color.WHITE, 8 * dp, 6 * dp)
+            }
+        }
+        root.addView(frame, FrameLayout.LayoutParams(0, 0))
+        root.addView(TextView(this).apply {
+            setText(R.string.blueos_s_ed_hint)
+            setTextColor(Color.WHITE)
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+            gravity = Gravity.CENTER
+            setPadding((12 * dp).toInt(), (8 * dp).toInt(), (12 * dp).toInt(), (8 * dp).toInt())
+            background = GradientDrawable().apply { cornerRadius = 14 * dp; setColor(0x8c000000.toInt()) }
+        }, FrameLayout.LayoutParams(-2, -2, Gravity.TOP or Gravity.CENTER_HORIZONTAL).apply { topMargin = (56 * dp).toInt() })
+        val buttons = LinearLayout(this).apply {
+            orientation = LinearLayout.HORIZONTAL
+            addView(Button(this@BlueOSAronaEditorActivity).apply {
+                setText(R.string.blueos_s_ed_reset)
+                setOnClickListener { reset() }
+            })
+            addView(Button(this@BlueOSAronaEditorActivity).apply {
+                setText(R.string.blueos_s_ed_done)
+                setOnClickListener { save(); finish() }
+            }, LinearLayout.LayoutParams(-2, -2).apply { marginStart = (12 * dp).toInt() })
+        }
+        root.addView(buttons, FrameLayout.LayoutParams(-2, -2, Gravity.BOTTOM or Gravity.CENTER_HORIZONTAL).apply { bottomMargin = (48 * dp).toInt() })
+        setContentView(root)
+        root.post { place() }
+
+        val scale = ScaleGestureDetector(this, object : ScaleGestureDetector.SimpleOnScaleGestureListener() {
+            override fun onScale(d: ScaleGestureDetector): Boolean {
+                val c = top + h / 2
+                h = (h * d.scaleFactor).coerceIn(0.12f, 1.35f)
+                top = c - h / 2
+                place()
+                return true
+            }
+        })
+        root.setOnTouchListener { _, e ->
+            scale.onTouchEvent(e)
+            when (e.actionMasked) {
+                MotionEvent.ACTION_DOWN -> { lastX = e.x; lastY = e.y }
+                MotionEvent.ACTION_MOVE -> if (!scale.isInProgress && e.pointerCount == 1) {
+                    cx += (e.x - lastX) / root.width
+                    top += (e.y - lastY) / root.height
+                    lastX = e.x; lastY = e.y
+                    place()
+                }
+                MotionEvent.ACTION_POINTER_UP -> { lastX = e.getX(0); lastY = e.getY(0) }
+            }
+            true
+        }
+    }
+
+    private fun reset() {
+        cx = 0.52f; top = 0.46f; h = 0.46f
+        place()
+    }
+
+    private fun place() {
+        if (root.width == 0) return
+        cx = cx.coerceIn(-0.2f, 1.2f)
+        top = top.coerceIn(-0.5f, 0.95f)
+        val vp = arona.viewport
+        val hh = (h * root.height).toInt()
+        val ww = (hh * vp.w / vp.h).toInt()
+        for (v in listOf(arona, frame)) {
+            v.layoutParams = (v.layoutParams as FrameLayout.LayoutParams).apply {
+                width = ww; height = hh
+                leftMargin = (cx * root.width - ww / 2f).toInt()
+                topMargin = (top * root.height).toInt()
+            }
+        }
+    }
+
+    private fun save() {
+        Settings.Secure.putString(contentResolver, K.ARONA_CUSTOM, String.format(Locale.US, "%.4f;%.4f;%.4f", cx, top, h))
+        Settings.Secure.putInt(contentResolver, K.ARONA_MODE, 4)
+    }
+}

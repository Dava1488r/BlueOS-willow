+
+/** BlueOS 0.7 entries in the «Обои и стиль» lists; each opens a [BlueOSSettingsActivity] page. */
+enum class BlueOSCustomizationOption(val page: String, val title: Int, val desc: Int) :
+    com.android.wallpaper.picker.customization.ui.util.CustomizationOptionUtil.CustomizationOption {
+    ARONA(BlueOSSettingsActivity.LOCK, R.string.blueos_s_entry_lock, R.string.blueos_s_entry_lock_desc),
+    HOME(BlueOSSettingsActivity.HOME, R.string.blueos_s_entry_home, R.string.blueos_s_entry_home_desc),
+    WEATHER(BlueOSSettingsActivity.WEATHER, R.string.blueos_s_entry_weather, R.string.blueos_s_entry_weather_desc);
+
+    /** A list entry styled like the stock ones ("More lock screen settings" layout). */
+    fun entry(inflater: android.view.LayoutInflater, parent: android.view.ViewGroup): Pair<BlueOSCustomizationOption, View> {
+        val v = inflater.inflate(R.layout.customization_option_entry_more_lock_settings, parent, false)
+        v.findViewById<TextView>(R.id.option_entry_title).setText(title)
+        v.findViewById<TextView>(R.id.option_entry_description).setText(desc)
+        v.setOnClickListener { BlueOSSettingsActivity.open(it.context, page) }
+        return this to v
+    }
+}
+
+/**
+ * BlueOS 0.7 settings in «Обои и стиль» (approved mockup 2): «Экран блокировки» (Arona, replies, live clock,
+ * weather by the clock, fall, motion, shake), «Рабочий стол» (materials, icons, live widgets, tilt) and «Погода».
+ * Every feature has its own switch; values live in Settings.Secure (see org.blueos.arona.BlueOSSettings).
+ */
+class BlueOSSettingsActivity : Activity() {
+    companion object {
+        private const val EXTRA_PAGE = "blueos_page"
+        const val LOCK = "lock"
+        const val HOME = "home"
+        const val WEATHER = "weather"
+
+        fun open(context: Context, page: String) =
+            context.startActivity(Intent(context, BlueOSSettingsActivity::class.java).putExtra(EXTRA_PAGE, page))
+    }
+
+    private sealed class Item {
+        open val dep: () -> Boolean = { true }
+        open val sub = false
+        class Header(val text: Int) : Item()
+        object Divider : Item()
+        class Sw(val key: String, val title: Int, val desc: Int? = null, override val sub: Boolean = false,
+                 override val dep: () -> Boolean = { true }) : Item()
+        class Radio(val key: String, val value: Int, val title: Int, val desc: Int? = null, override val sub: Boolean = false,
+                    override val dep: () -> Boolean = { true }) : Item()
+        class RadioStr(val key: String, val value: String, val def: String, val title: Int, override val sub: Boolean = false,
+                       override val dep: () -> Boolean = { true }) : Item()
+        class Slider(val key: String, val title: Int, val desc: (Int) -> String) : Item()
+        class Btn(val title: Int, val desc: Int?, override val sub: Boolean = false, override val dep: () -> Boolean,
+                  val onClick: () -> Unit) : Item()
+        class Info(val title: Int, val desc: Int) : Item()
+    }
+
+    private val rows = mutableListOf<Pair<Item, () -> Unit>>()
+    private val dp get() = resources.displayMetrics.density
+
+    private fun int(key: String) = K.int(contentResolver, key)
+    private fun on(key: String) = int(key) != 0
+    private fun put(key: String, v: Int) { Settings.Secure.putInt(contentResolver, key, v); refresh() }
+    private fun put(key: String, v: String) { Settings.Secure.putString(contentResolver, key, v); refresh() }
+
+    // ------------------------------------------------------------------ pages (= the mockup's settings phones)
+
+    private fun lockPage(): List<Item> {
+        val show = { on(K.ARONA_SHOW) }
+        val sfxOnly = { int(K.ARONA_VOICE) == 1 && on(K.ARONA_EMO_ONLY) }
+        val text = { show() && on(K.ARONA_TEXT) && !sfxOnly() }
+        val halo = { on(K.HALO_LIVE) }
+        val fall = { on(K.FALL) }
+        val shake = { on(K.SHAKE) }
+        val inertia = { on(K.INERTIA) }
+        return listOf(
+            Item.Header(R.string.blueos_s_h_arona),
+            Item.Sw(K.ARONA_SHOW, R.string.blueos_s_arona_show, R.string.blueos_s_arona_show_d),
+            Item.Header(R.string.blueos_s_h_where),
+            Item.Radio(K.ARONA_MODE, 0, R.string.blueos_s_mode_clock, R.string.blueos_s_mode_clock_d, dep = show),
+            Item.Radio(K.ARONA_MODE, 1, R.string.blueos_s_mode_fp, R.string.blueos_s_mode_fp_d, dep = show),
+            Item.Radio(K.ARONA_MODE, 2, R.string.blueos_s_mode_lobby, R.string.blueos_s_mode_lobby_d, dep = show),
+            Item.Radio(K.ARONA_MODE, 3, R.string.blueos_s_mode_dyn, R.string.blueos_s_mode_dyn_d, dep = show),
+            Item.Radio(K.ARONA_MODE, 4, R.string.blueos_s_mode_custom, R.string.blueos_s_mode_custom_d, dep = show),
+            Item.Btn(R.string.blueos_s_edit, R.string.blueos_s_edit_d, sub = true, dep = { show() && int(K.ARONA_MODE) == 4 }) {
+                startActivity(Intent(this, BlueOSAronaEditorActivity::class.java))
+            },
+            Item.Header(R.string.blueos_s_h_touch),
+            Item.Sw(K.ARONA_LOOK, R.string.blueos_s_look, dep = show),
+            Item.Sw(K.ARONA_PAT, R.string.blueos_s_pat, dep = show),
+            Item.Header(R.string.blueos_s_h_replies),
+            Item.Radio(K.ARONA_VOICE, 0, R.string.blueos_s_voice, R.string.blueos_s_voice_d, dep = show),
+            Item.Radio(K.ARONA_VOICE, 1, R.string.blueos_s_sfx, R.string.blueos_s_sfx_d, dep = show),
+            Item.Radio(K.ARONA_VOICE, 2, R.string.blueos_s_mute, dep = show),
+            Item.Sw(K.ARONA_EMO_ONLY, R.string.blueos_s_emo_only, R.string.blueos_s_emo_only_d, sub = true,
+                dep = { show() && int(K.ARONA_VOICE) == 1 }),
+            Item.Sw(K.ARONA_TEXT, R.string.blueos_s_text, dep = { show() && !sfxOnly() }),
+            Item.RadioStr(K.ARONA_LANG, "ru", "ru", R.string.blueos_s_lang_ru, sub = true, dep = text),
+            Item.RadioStr(K.ARONA_LANG, "en", "ru", R.string.blueos_s_lang_en, sub = true, dep = text),
+            Item.RadioStr(K.ARONA_LANG, "ja", "ru", R.string.blueos_s_lang_ja, sub = true, dep = text),
+            Item.Sw(K.ARONA_NOTIF, R.string.blueos_s_notif, R.string.blueos_s_notif_d, dep = show),
+            Item.Header(R.string.blueos_s_h_more),

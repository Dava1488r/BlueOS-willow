     private fun roles(vararg r: Int) = r.map { roleNames.getValue(it) to it }
+
+    // 0.8.1: every part of the lock screen offers the same colours in the same order; on the lock screen TEXT is plain white
+    private val lockRoles = listOf(R.string.blueos_s_role_white to C.TEXT, R.string.blueos_s_role_tint to C.TINT,
+        R.string.blueos_s_role_accent to C.ACCENT, R.string.blueos_s_role_second to C.SECOND,
+        R.string.blueos_s_role_third to C.THIRD, R.string.blueos_s_role_custom to C.CUSTOM)
+
+    /** «Цвет текста на блокировке» leaves the roles working (the same rule as ClockEventController). */
+    private fun lockLight() = int(K.LOCK_TEXT_COLOR).let { it == 2 || (it == 0 && C.isDark()) }
+
+    private fun clockFace() = runCatching {
+        org.json.JSONObject(Settings.Secure.getString(contentResolver, CLOCK_FACE))
+    }.getOrNull()
+
+    /** The colour picked in «Часы» → «Цвет»: it paints the whole clock and beats the roles while it is set. */
+    private fun clockSeed(): Int? = clockFace()?.takeUnless { it.isNull("seedColor") }?.getInt("seedColor")
+
+    private fun clearClockSeed() {
+        val face = clockFace() ?: return
+        if (face.isNull("seedColor")) return
+        face.remove("seedColor")
+        face.optJSONObject("metadata")?.put("metadataSelectedColorId", "DEFAULT")
+        Settings.Secure.putString(contentResolver, CLOCK_FACE, face.toString())
+    }
+
+    /**
+     * A part of the lock screen: the last choice wins (one picked here replaces the clock's own colour), «Свой цвет»
+     * opens the colour picker right here and belongs to this part alone.
+     */
+    private fun lockRow(key: String, title: Int, sub: Boolean = false, clock: Boolean = false, sameAsHours: Boolean = false,
+                        dep: () -> Boolean = { true }) = Item.Choice(key, title,
+        lockRoles + if (sameAsHours) listOf(R.string.blueos_s_minutes_same to C.SAME_AS_HOURS) else emptyList(), sub,
+        dep = { lockLight() && dep() },
+        dot = { if (it == C.SAME_AS_HOURS) C.lockDigits(this) else C.lockRoleColor(this, key, it) },
+        seed = if (clock) ({ clockSeed() }) else null,
+        pick = { role ->
+            fun save() {
+                if (clock) clearClockSeed()
+                put(key, role)
+            }
+            if (role != C.CUSTOM) save()
+            else pickCustom(title, C.lockRoleColor(this, key, C.CUSTOM)) { color ->
+                Settings.Secure.putInt(contentResolver, key + K.COLOR_OWN, color)
+                save()
+            }
+        })
+
     private fun lockDot(role: Int) = C.lockColor(this, role)

diff --git a/res/layout/blueos_settings_slider.xml b/res/layout/blueos_settings_slider.xml
new file mode 100644
index 00000000..d320619b
--- /dev/null
+++ b/res/layout/blueos_settings_slider.xml
@@ -0,0 +1,15 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- BlueOS 0.8: the slider of the BlueOS pages — the Material 3 slider of «Обои и стиль» (clock colour) -->
+<com.google.android.material.slider.Slider
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:minHeight="@dimen/touch_target_min_height"
+    android:stepSize="1"
+    android:valueFrom="0"
+    android:valueTo="100"
+    app:labelBehavior="gone"
+    app:trackHeight="@dimen/slider_track_height"
+    app:thumbHeight="@dimen/slider_thumb_height"
+    android:theme="@style/Theme.Material3.DynamicColors.DayNight" />
diff --git a/res/layout/blueos_settings_switch.xml b/res/layout/blueos_settings_switch.xml
new file mode 100644
index 00000000..d03ad8c5
--- /dev/null
+++ b/res/layout/blueos_settings_switch.xml
@@ -0,0 +1,10 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- BlueOS 0.8: the switch of the BlueOS pages — the same Material 3 switch (check / cross) as Android's Settings -->
+<com.google.android.material.materialswitch.MaterialSwitch
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    style="@style/SettingslibSwitchStyle.Expressive"
+    android:layout_width="wrap_content"
+    android:layout_height="wrap_content"
+    android:clickable="false"
+    android:focusable="false"
+    android:theme="@style/Theme.Material3.DynamicColors.DayNight" />

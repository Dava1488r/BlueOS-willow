@@ -123,10 +123,9 @@ constructor(
                                 false,
                             )
                     )
-                    // BlueOS 0.7.1: Arona, the live clock, phone motion (one page per subject); 0.8: «Персонаж» only
-                    // when this build has a character (a public build without the game's files has none)
-                    if (org.blueos.arona.Character.anyAvailable)
-                        add(com.android.customization.blueos.BlueOSCustomizationOption.ARONA.entry(layoutInflater, optionContainer))
+                    // BlueOS 0.7.1: Arona, the live clock, phone motion (one page per subject); 0.8.1: «Персонаж» is
+                    // always there — without the game's files it tells how to add them
+                    add(com.android.customization.blueos.BlueOSCustomizationOption.ARONA.entry(layoutInflater, optionContainer))
                     add(com.android.customization.blueos.BlueOSCustomizationOption.CLOCK.entry(layoutInflater, optionContainer))
                     // 0.8: «Цвета» — a role per element (clock, halo, AOD, icons)
                     add(com.android.customization.blueos.BlueOSCustomizationOption.COLORS.entry(layoutInflater, optionContainer))
@@ -207,8 +206,7 @@ constructor(
                     }
                     // BlueOS 0.7.1: widgets and icons, Arona (and her widget), weather, phone motion
                     add(com.android.customization.blueos.BlueOSCustomizationOption.HOME.entry(layoutInflater, optionContainer))
-                    if (org.blueos.arona.Character.anyAvailable)
-                        add(com.android.customization.blueos.BlueOSCustomizationOption.ARONA.entry(layoutInflater, optionContainer))
+                    add(com.android.customization.blueos.BlueOSCustomizationOption.ARONA.entry(layoutInflater, optionContainer))
                     add(com.android.customization.blueos.BlueOSCustomizationOption.WEATHER.entry(layoutInflater, optionContainer))
                     add(com.android.customization.blueos.BlueOSCustomizationOption.MOTION.entry(layoutInflater, optionContainer))
                 }

diff --git a/src/com/android/customization/blueos/BlueOSSettingsActivity.kt b/src/com/android/customization/blueos/BlueOSSettingsActivity.kt
index 9f2ee7e3..a1db70ce 100644
--- a/src/com/android/customization/blueos/BlueOSSettingsActivity.kt
+++ b/src/com/android/customization/blueos/BlueOSSettingsActivity.kt
@@ -95,7 +95,16 @@ class BlueOSSettingsActivity : Activity() {
 
     // ------------------------------------------------------------------ pages
 
+    /** 0.8.1: Settings → «Файлы персонажа» (only Settings may write them, sepolicy blueos_media_file). */
+    private fun openAssets() = startActivity(Intent().setClassName("com.android.settings",
+        "com.android.settings.blueos.BlueOSAssetsActivity"))
+
     private fun aronaPage(): List<Item> {
+        // 0.8.1: a build without the game's files — how to add them (the page is always there for this)
+        if (!org.blueos.arona.Character.anyAvailable) return listOf(
+            Item.Info(R.string.blueos_s_files_none, R.string.blueos_s_files_none_d),
+            Item.Btn(R.string.blueos_s_files_add, R.string.blueos_s_files_add_d, dep = { true }) { openAssets() },
+        )
         val show = { on(K.ARONA_SHOW) }
         val sfxOnly = { int(K.ARONA_VOICE) == 1 && on(K.ARONA_EMO_ONLY) }
         val text = { on(K.ARONA_TEXT) && !sfxOnly() }
@@ -142,6 +151,9 @@ class BlueOSSettingsActivity : Activity() {
                 dep = { on(K.LIVE_WIDGETS) && int(K.CHARACTER) == 0 }),
             Item.Sw(K.ARONA_DESK_VOICE, R.string.blueos_s_desk_voice, R.string.blueos_s_desk_voice_d, sub = true,
                 dep = { on(K.ARONA_DESK) && on(K.LIVE_WIDGETS) && int(K.CHARACTER) == 0 }),
+            // 0.8.1: add, update or remove the files added on this phone
+            Item.Header(R.string.blueos_s_h_files),
+            Item.Btn(R.string.blueos_s_files_add, R.string.blueos_s_files_more_d, dep = { true }) { openAssets() },
         )
     }
 
@@ -539,7 +551,15 @@ class BlueOSSettingsActivity : Activity() {
             android.content.res.ColorStateList.valueOf(attrColor(android.R.attr.colorControlHighlight)), shape, null)
     }
 
-    override fun onResume() { super.onResume(); refresh() }
+    // 0.8.1: back from «Файлы персонажа» with a character added (or removed) — the page has other rows now
+    private val hadCharacter = org.blueos.arona.Character.anyAvailable
+
+    override fun onResume() {
+        super.onResume()
+        val page = intent.getStringExtra(EXTRA_PAGE) ?: ARONA
+        if (page == ARONA && org.blueos.arona.Character.anyAvailable != hadCharacter) { recreate(); return }
+        refresh()
+    }
 
     private fun refresh() = rows.forEach { (item, update) ->
         update()
diff --git a/src/com/android/wallpaper/customization/ui/util/ThemePickerCustomizationOptionViewUtil.kt b/src/com/android/wallpaper/customization/ui/util/ThemePickerCustomizationOptionViewUtil.kt

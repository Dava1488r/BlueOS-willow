@@ -138,6 +138,13 @@
     <string name="blueos_s_toggles">Переключатели пружинят при нажатии</string>
     <string name="blueos_s_toggles_d">Пружинка при нажатии</string>
     <string name="blueos_s_h_aw">Виджет «Персонаж»</string>
+    <!-- 0.8.1: the characters' files added on the phone (Settings → BlueOSAssetsActivity) -->
+    <string name="blueos_s_h_files">Файлы персонажа</string>
+    <string name="blueos_s_files_none">Персонажа пока нет</string>
+    <string name="blueos_s_files_none_d">В прошивке нет файлов из Blue Archive — их нельзя распространять. Арону и Плану можно добавить из своих файлов игры: модели, голоса, звуки.</string>

+    // BlueOS: "Bright colors" switch. On = VIBRANT, off = TONAL_SPOT; options with another style of
+    // their own (monochrome, neutral, expressive) keep it and the switch is disabled for them.
+    private val previewingStyleState =
+        previewingStyle.stateIn(viewModelScope, SharingStarted.Eagerly, null)
+    val previewingIsBright: Flow<Boolean> =
+        previewingStyleState.map { it == ThemeStyle.VIBRANT }.distinctUntilChanged()
+    val isBrightColorsToggleEnabled: Flow<Boolean> =
+        previewingStyleState
+            .map { it == ThemeStyle.TONAL_SPOT || it == ThemeStyle.VIBRANT }
+            .distinctUntilChanged()
+
+    fun toggleBrightColors() {
+        _overridingStyle.value =
+            if (previewingStyleState.value == ThemeStyle.VIBRANT) ThemeStyle.TONAL_SPOT
+            else ThemeStyle.VIBRANT
+    }
+
+    /** Called when another color option is picked: keeps the bright-colors switch as it was. */
+    private fun keepBrightColorsFor(colorOption: ColorOption, wasBright: Boolean) {
+        when {
+            colorOption.style != ThemeStyle.TONAL_SPOT -> resetStyleOptionSelection()
+            wasBright -> _overridingStyle.value = ThemeStyle.VIBRANT
+        }
+    }

+    private fun cityName() = K.string(contentResolver, K.WEATHER_CITY, "").substringBefore(';').ifEmpty { null }
+
+    private class City(val name: String, val label: String, val lat: Double, val lon: Double)
+
+    /** 0.8.1: Open-Meteo's own search, the service the weather comes from. On a background thread. */
+    private fun findCities(query: String): List<City> {
+        val url = java.net.URL("https://geocoding-api.open-meteo.com/v1/search?count=6&format=json" +
+            "&language=" + java.util.Locale.getDefault().language + "&name=" + java.net.URLEncoder.encode(query, "UTF-8"))
+        val conn = url.openConnection() as java.net.HttpURLConnection
+        conn.connectTimeout = 10_000
+        conn.readTimeout = 10_000
+        val body = try { conn.inputStream.bufferedReader().use { it.readText() } } finally { conn.disconnect() }
+        val found = org.json.JSONObject(body).optJSONArray("results") ?: return emptyList()
+        return (0 until found.length()).map { i ->
+            val c = found.getJSONObject(i)
+            val name = c.getString("name")
+            val label = listOf(name, c.optString("admin1"), c.optString("country")).filter { it.isNotEmpty() }.distinct().joinToString(", ")
+            City(name, label, c.getDouble("latitude"), c.getDouble("longitude"))
+        }
+    }
+
+    /** 0.8.1: weather for a city typed by hand, when the phone can't tell where it is. */
+    private fun pickCity() {
+        val field = android.widget.EditText(this).apply {
+            setHint(R.string.blueos_s_wx_city_hint)
+            isSingleLine = true
+            setText(cityName().orEmpty())
+        }
+        val box = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding((18 * dp).toInt(), (8 * dp).toInt(), (18 * dp).toInt(), 0)
+            addView(field)
+        }
+        val builder = AlertDialog.Builder(this)
+            .setTitle(R.string.blueos_s_wx_city)
+            .setMessage(R.string.blueos_s_wx_city_d)
+            .setView(box)
+            .setPositiveButton(R.string.blueos_s_wx_city_find, null)    // set below: a failed search keeps the dialog
+            .setNegativeButton(android.R.string.cancel, null)
+        if (cityName() != null) builder.setNeutralButton(R.string.blueos_s_wx_city_clear) { _, _ ->
+            Settings.Secure.putString(contentResolver, K.WEATHER_CITY, null)
+            refresh()
+        }
+        val dialog = builder.show()
+        val find = dialog.getButton(AlertDialog.BUTTON_POSITIVE)
+        find.setOnClickListener {
+            val query = field.text.toString().trim()
+            if (query.isEmpty()) return@setOnClickListener
+            find.isEnabled = false
+            Thread {
+                val found = runCatching { findCities(query) }
+                runOnUiThread {
+                    find.isEnabled = true
+                    val cities = found.getOrNull()
+                    when {
+                        isFinishing || !dialog.isShowing -> {}
+                        cities == null -> field.error = getString(R.string.blueos_s_wx_city_err)
+                        cities.isEmpty() -> field.error = getString(R.string.blueos_s_wx_city_none)
+                        else -> {
+                            dialog.dismiss()
+                            AlertDialog.Builder(this)
+                                .setTitle(R.string.blueos_s_wx_city)
+                                .setItems(cities.map { it.label }.toTypedArray()) { _, i ->
+                                    val c = cities[i]
+                                    put(K.WEATHER_CITY, "${c.name};${c.lat};${c.lon}")
+                                }
+                                .setNegativeButton(android.R.string.cancel, null)
+                                .show()
+                        }
+                    }
+                }
+            }.start()
+        }
+    }
+

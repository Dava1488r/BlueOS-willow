+import android.content.Context;
+import android.content.Intent;
+import android.text.TextUtils;
+import android.text.format.DateFormat;
+import android.view.View;
+import android.widget.RemoteViews;
+
+import com.android.deskclock.DeskClock;
+import com.android.deskclock.R;
+import com.android.deskclock.Utils;
+
+import java.util.Locale;
+
+/**
+ * BlueOS clock widgets: a card, a halo clock without a card and a 2x2 tile. Their colors are
+ * system palette resources, so they follow the accent color and the dark theme. The time itself
+ * is drawn by TextClocks; the provider only refreshes the date format, the next alarm and (halo)
+ * the text color picked from the home wallpaper.
+ */
+public abstract class BlueOSClockWidgetProvider extends AppWidgetProvider {
+
+    /** Sent by SystemUI (ThemeOverlayController) when the home wallpaper colors change. */
+    private static final String ACTION_WALLPAPER_COLORS_CHANGED =
+            "org.blueos.intent.action.WALLPAPER_COLORS_CHANGED";
+
+    protected abstract int getLayoutId();
+
+    /** Whether the layout has the date / next alarm row. */
+    protected boolean hasDateRow() {
+        return true;
+    }
+
+    /** Last touches on the views, after the common setup. */
+    protected void style(Context context, RemoteViews rv) {
+    }
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        super.onReceive(context, intent);
+        final String action = intent.getAction();
+        if (AlarmManager.ACTION_NEXT_ALARM_CLOCK_CHANGED.equals(action)
+                || Intent.ACTION_LOCALE_CHANGED.equals(action)
+                || Intent.ACTION_TIME_CHANGED.equals(action)
+                || Intent.ACTION_TIMEZONE_CHANGED.equals(action)
+                || ACTION_WALLPAPER_COLORS_CHANGED.equals(action)) {
+            final AppWidgetManager wm = AppWidgetManager.getInstance(context);
+            onUpdate(context, wm, wm.getAppWidgetIds(new ComponentName(context, getClass())));
+        }
+    }
+
+    @Override
+    public void onUpdate(Context context, AppWidgetManager wm, int[] widgetIds) {
+        for (int widgetId : widgetIds) {
+            wm.updateAppWidget(widgetId, buildViews(context, wm, widgetId));
+        }
+    }
+
+    private RemoteViews buildViews(Context context, AppWidgetManager wm, int widgetId) {
+        final RemoteViews rv = new RemoteViews(context.getPackageName(), getLayoutId());
+
+        // Tapping on the widget opens the app (if not on the lock screen).
+        if (Utils.isWidgetClickable(wm, widgetId)) {
+            final Intent openApp = new Intent(context, DeskClock.class);
+            final PendingIntent pi = PendingIntent.getActivity(context, 0, openApp, FLAG_IMMUTABLE);
+            rv.setOnClickPendingIntent(android.R.id.background, pi);
+        }
+
+        if (hasDateRow()) {
+            final String dateFormat =
+                    DateFormat.getBestDateTimePattern(Locale.getDefault(), "EEEMMMd");
+            rv.setCharSequence(R.id.blueos_date, "setFormat12Hour", dateFormat);
+            rv.setCharSequence(R.id.blueos_date, "setFormat24Hour", dateFormat);
+
+            final String nextAlarm = Utils.getNextAlarm(context);
+            final int alarmVisibility = TextUtils.isEmpty(nextAlarm) ? View.GONE : View.VISIBLE;
+            rv.setViewVisibility(R.id.blueos_alarm_icon, alarmVisibility);
+            rv.setViewVisibility(R.id.blueos_next_alarm, alarmVisibility);
+            rv.setTextViewText(R.id.blueos_next_alarm, nextAlarm);
+        }
+
+        style(context, rv);
+        return rv;
+    }
+
+    /** A: time, date and the next alarm on a card. */
+    public static class Card extends BlueOSClockWidgetProvider {
+        @Override
+        protected int getLayoutId() {
+            return R.layout.blueos_clock_widget_card;
+        }
+    }
+
+    /**
+     * B: no card, the halo over the minutes. Without a card the text has to contrast with the
+     * wallpaper itself, so dark or light text is picked from the wallpaper colors.
+     */
+    public static class Halo extends BlueOSClockWidgetProvider {
+        @Override
+        protected int getLayoutId() {
+            return R.layout.blueos_clock_widget_halo;
+        }
+
+        @Override
+        protected void style(Context context, RemoteViews rv) {
+            final WallpaperColors colors = WallpaperManager.getInstance(context)
+                    .getWallpaperColors(WallpaperManager.FLAG_SYSTEM);
+            final boolean darkText = colors != null
+                    && (colors.getColorHints() & WallpaperColors.HINT_SUPPORTS_DARK_TEXT) != 0;
+
+            final int text = context.getColor(darkText
+                    ? android.R.color.system_on_surface_light
+                    : android.R.color.system_on_surface_dark);
+            final int secondary = context.getColor(darkText
+                    ? android.R.color.system_on_surface_variant_light
+                    : android.R.color.system_on_surface_variant_dark);
+            final int accent = context.getColor(darkText
+                    ? android.R.color.system_primary_light
+                    : android.R.color.system_primary_dark);
+
+            rv.setTextColor(R.id.blueos_hours, text);
+            rv.setTextColor(R.id.blueos_colon, text);
+            rv.setTextColor(R.id.blueos_minutes, accent);
+            rv.setInt(R.id.blueos_halo, "setColorFilter", accent);
+            rv.setTextColor(R.id.blueos_date, secondary);
+            rv.setTextColor(R.id.blueos_next_alarm, secondary);
+            rv.setInt(R.id.blueos_alarm_icon, "setColorFilter", secondary);
+        }
+    }
+
+    /** C: 2x2 tile, hours over minutes, the halo on top. */
+    public static class Tile extends BlueOSClockWidgetProvider {
+        @Override
+        protected int getLayoutId() {
+            return R.layout.blueos_clock_widget_tile;
+        }
+
+        @Override
+        protected boolean hasDateRow() {
+            return false;
+        }
+    }
+}

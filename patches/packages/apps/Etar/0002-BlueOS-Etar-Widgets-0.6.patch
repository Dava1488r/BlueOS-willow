+package com.android.calendar.widget;
+
+import android.app.Activity;
+import android.appwidget.AppWidgetManager;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.os.Bundle;
+import android.widget.DatePicker;
+import android.widget.EditText;
+import android.widget.Switch;
+
+import java.time.LocalDate;
+import java.time.ZoneId;
+
+import ws.xsoh.etar.R;
+
+/** BlueOS countdown widget setup: a title, a date and whether it comes back every year. */
+public class BlueOSCountdownConfigActivity extends Activity {
+
+    private int mWidgetId = AppWidgetManager.INVALID_APPWIDGET_ID;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        // Backing out leaves no half-made widget
+        setResult(RESULT_CANCELED);
+        mWidgetId = getIntent().getIntExtra(AppWidgetManager.EXTRA_APPWIDGET_ID,
+                AppWidgetManager.INVALID_APPWIDGET_ID);
+        if (mWidgetId == AppWidgetManager.INVALID_APPWIDGET_ID) {
+            finish();
+            return;
+        }
+        setContentView(R.layout.blueos_countdown_config);
+
+        final EditText title = findViewById(R.id.blueos_countdown_title_input);
+        final DatePicker date = findViewById(R.id.blueos_countdown_date);
+        final Switch yearly = findViewById(R.id.blueos_countdown_yearly);
+
+        // Editing an existing one starts from what it shows
+        final SharedPreferences prefs = BlueOSCountdownWidgetProvider.prefs(this);
+        title.setText(prefs.getString(BlueOSCountdownWidgetProvider.keyTitle(mWidgetId), ""));
+        yearly.setChecked(prefs.getBoolean(
+                BlueOSCountdownWidgetProvider.keyYearly(mWidgetId), false));
+        final long saved = prefs.getLong(
+                BlueOSCountdownWidgetProvider.keyDate(mWidgetId), Long.MIN_VALUE);
+        final LocalDate start = saved == Long.MIN_VALUE
+                ? LocalDate.now(ZoneId.systemDefault()).plusDays(7)
+                : LocalDate.ofEpochDay(saved);
+        date.updateDate(start.getYear(), start.getMonthValue() - 1, start.getDayOfMonth());
+
+        findViewById(R.id.blueos_countdown_done).setOnClickListener(v -> {
+            final LocalDate picked = LocalDate.of(date.getYear(), date.getMonth() + 1,
+                    date.getDayOfMonth());
+            prefs.edit()
+                    .putString(BlueOSCountdownWidgetProvider.keyTitle(mWidgetId),
+                            title.getText().toString().trim())
+                    .putLong(BlueOSCountdownWidgetProvider.keyDate(mWidgetId), picked.toEpochDay())
+                    .putBoolean(BlueOSCountdownWidgetProvider.keyYearly(mWidgetId),
+                            yearly.isChecked())
+                    .commit();
+            BlueOSCountdownWidgetProvider.update(this, AppWidgetManager.getInstance(this),
+                    mWidgetId);
+            setResult(RESULT_OK, new Intent()
+                    .putExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, mWidgetId));
+            finish();
+        });
+    }
+}
diff --git a/app/src/main/java/com/android/calendar/widget/BlueOSCountdownWidgetProvider.java b/app/src/main/java/com/android/calendar/widget/BlueOSCountdownWidgetProvider.java

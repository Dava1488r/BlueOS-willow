                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="8dp"
+                android:ellipsize="end"
                 android:maxLines="2"
                 android:text="@string/blueos_date_widget_no_events"
                 android:fontFamily="google-sans-text"

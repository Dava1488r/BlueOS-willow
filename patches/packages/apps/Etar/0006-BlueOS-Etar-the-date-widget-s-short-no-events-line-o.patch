 .../calendar/widget/BlueOSDateWidgetProvider.java  | 14 ++++++++------
 app/src/main/res/layout/blueos_date_widget.xml     |  1 +
 app/src/main/res/values-ru/blueos_strings.xml      |  2 ++
 app/src/main/res/values/blueos_strings.xml         |  2 ++
 4 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/app/src/main/java/com/android/calendar/widget/BlueOSDateWidgetProvider.java b/app/src/main/java/com/android/calendar/widget/BlueOSDateWidgetProvider.java
index 67fe05f2..a9f5ebb0 100644
--- a/app/src/main/java/com/android/calendar/widget/BlueOSDateWidgetProvider.java
+++ b/app/src/main/java/com/android/calendar/widget/BlueOSDateWidgetProvider.java
@@ -115,10 +115,12 @@ public class BlueOSDateWidgetProvider extends AppWidgetProvider {
         }
         final List<Event> events = loadEvents(context);
         // One row (106.7 dp inside the card) fits the date and one event on one line; two rows
-        // show both events with their times
+        // show both events with their times. 0.8.1: a card narrower than the full «no events»
+        // line (142 dp of text + 24 padding + 16 margin) gets the short one: it was cut to «Ближайших»
         final Map<SizeF, RemoteViews> sized = new LinkedHashMap<>();
-        sized.put(new SizeF(90f, 90f), buildViews(context, events, 1));
-        sized.put(new SizeF(90f, 180f), buildViews(context, events, MAX_EVENTS));
+        sized.put(new SizeF(90f, 90f), buildViews(context, events, 1, true));
+        sized.put(new SizeF(185f, 90f), buildViews(context, events, 1, false));
+        sized.put(new SizeF(90f, 180f), buildViews(context, events, MAX_EVENTS, false));
         final RemoteViews rv = new RemoteViews(sized);
         for (int widgetId : widgetIds) {
             wm.updateAppWidget(widgetId, rv);
@@ -131,7 +133,7 @@ public class BlueOSDateWidgetProvider extends AppWidgetProvider {
         context.getSystemService(AlarmManager.class).cancel(refreshIntent(context));
     }
 
-    private RemoteViews buildViews(Context context, List<Event> events, int maxShown) {
+    private RemoteViews buildViews(Context context, List<Event> events, int maxShown, boolean shortEmpty) {
         final RemoteViews rv = new RemoteViews(context.getPackageName(),
                 R.layout.blueos_date_widget);
         rv.setInt(R.id.blueos_widget_bg, "setImageAlpha",
@@ -163,8 +165,8 @@ public class BlueOSDateWidgetProvider extends AppWidgetProvider {
         rv.setViewVisibility(R.id.blueos_no_events, events.isEmpty() ? View.VISIBLE : View.GONE);
         rv.setInt(R.id.blueos_no_events, "setMaxLines", maxShown == 1 ? 1 : 2);
         rv.setTextViewText(R.id.blueos_no_events, context.getString(canRead
-                ? R.string.blueos_date_widget_no_events
-                : R.string.blueos_date_widget_no_access));
+                ? (shortEmpty ? R.string.blueos_date_widget_no_events_short : R.string.blueos_date_widget_no_events)
+                : (shortEmpty ? R.string.blueos_date_widget_no_access_short : R.string.blueos_date_widget_no_access)));
         setWeather(context, rv);
 
         // Tapping opens the calendar at today

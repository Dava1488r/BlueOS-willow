+    private fun deskWanted() = arona.character.hasDesk && K.on(cr, K.ARONA_DESK) && K.on(cr, K.LIVE_WIDGETS)
+
+    private fun sitDown() {
+        val d = desk ?: AronaDeskView(context).also {
+            desk = it
+            it.alpha = 0f
+            it.visibility = INVISIBLE
+            it.onReady = { if (seated) showDesk() }
+            content.addView(it, FrameLayout.LayoutParams(0, 0, (arona.layoutParams as FrameLayout.LayoutParams).gravity)
+                .apply { marginEnd = (6 * dp).toInt() })
+        }
+        seated = true
+        d.asleep = night()
+        d.deskTint = context.getColor(if (BlueOSColors.dark(context)) android.R.color.system_accent1_300
+            else android.R.color.system_accent1_200)

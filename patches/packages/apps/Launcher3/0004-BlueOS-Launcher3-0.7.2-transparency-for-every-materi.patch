+        if (!d.asleep) handler.postDelayed({ if (seated) touch.say(AronaReplies.Kind.SIT, silent = true, at = d) }, 900)
+    }
+
+    private fun standUp(say: Boolean) {
+        val d = desk ?: return
+        if (!seated) return
+        seated = false
+        lastTouch = SystemClock.uptimeMillis()
+        val wasAsleep = d.asleep
+        arona.visibility = VISIBLE
+        arona.animate().alpha(1f).setDuration(300).start()
+        d.animate().alpha(0f).setDuration(300).withEndAction { if (!seated) d.visibility = INVISIBLE }.start()
+        if (say) handler.postDelayed({
+            touch.say(if (wasAsleep) AronaReplies.Kind.SLEEP_WAKE else AronaReplies.Kind.SIT_EXIT)
+        }, 250)
+    }

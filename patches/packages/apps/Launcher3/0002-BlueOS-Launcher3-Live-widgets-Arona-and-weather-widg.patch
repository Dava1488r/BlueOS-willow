@@ -0,0 +1,29 @@
+package com.android.launcher3.blueos
+
+import android.content.Context
+import java.util.Locale
+import org.blueos.arona.BlueOSSettings as K
+
+/**
+ * BlueOS 0.7: "Скругление значков" (Обои и стиль → Рабочий стол). 100 % = the shape picked in
+ * «Форма значков» (a circle by default, as before); below that, a square with that much rounding.
+ * The plate material is applied where the themed icon colours are made (ThemedIconDelegate).
+ */
+object BlueOSIcons {
+    fun roundness(context: Context): Int = K.int(context.contentResolver, K.ICON_ROUNDNESS).coerceIn(0, 100)
+
+    /** A rounded square on the 100×100 icon viewport; [percent] 0 = square … 100 = circle. */
+    fun roundedPath(percent: Int): String {
+        val r = percent.coerceIn(0, 100) / 2f
+        if (r <= 0f) return "M0,0 H100 V100 H0 Z"
+        fun f(v: Float) = String.format(Locale.US, "%.2f", v)
+        val a = f(r)
+        val b = f(100 - r)
+        return "M$a,0 H$b A$a,$a 0 0 1 100,$a V$b A$a,$a 0 0 1 $b,100 H$a A$a,$a 0 0 1 0,$b V$a A$a,$a 0 0 1 $a,0 Z"
+    }
+
+    /** The icon mask to use, or null to keep the picked shape. */
+    fun mask(context: Context): String? = roundness(context).let { if (it >= 100) null else roundedPath(it) }
+
+    val KEYS = listOf(K.ICON_ROUNDNESS, K.ICON_MATERIAL, K.WIDGET_MATERIAL)
+}
diff --git a/src/com/android/launcher3/blueos/BlueOSWeatherWidget.kt b/src/com/android/launcher3/blueos/BlueOSWeatherWidget.kt

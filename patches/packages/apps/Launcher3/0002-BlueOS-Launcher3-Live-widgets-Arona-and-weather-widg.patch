diff --git a/src/com/android/launcher3/blueos/BlueOSAronaWidget.kt b/src/com/android/launcher3/blueos/BlueOSAronaWidget.kt
new file mode 100644
index 0000000000..f335e4c001
--- /dev/null
+++ b/src/com/android/launcher3/blueos/BlueOSAronaWidget.kt
@@ -0,0 +1,184 @@
+package com.android.launcher3.blueos
+
+import android.appwidget.AppWidgetHostView
+import android.appwidget.AppWidgetProviderInfo
+import android.content.Context
+import android.graphics.Outline
+import android.graphics.Typeface
+import android.media.AudioManager
+import android.os.Handler
+import android.os.Looper
+import android.util.TypedValue
+import android.view.Choreographer
+import android.view.Gravity
+import android.view.MotionEvent
+import android.view.View
+import android.view.ViewOutlineProvider
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.TextView
+import com.android.launcher3.R
+import com.android.launcher3.widget.LauncherAppWidgetHostView
+import com.android.launcher3.widget.LauncherAppWidgetProviderInfo
+import com.android.launcher3.widget.custom.CustomWidget
+import java.util.Calendar
+import org.blueos.arona.AronaReplies
+import org.blueos.arona.AronaTouch
+import org.blueos.arona.AronaView
+import org.blueos.arona.BlueOSMotion
+import org.blueos.arona.BlueOSSettings as K
+import org.blueos.arona.ReplyChip
+
+/** BlueOS 0.7: the launcher's own "Арона" widget, 2×1 (resizable). */
+object BlueOSAronaWidget : CustomWidget {
+    override val id: String = "blueos-arona"
+
+    override fun updateWidgetInfo(context: Context, info: LauncherAppWidgetProviderInfo) {
+        info.label = context.getString(R.string.blueos_widget_arona)
+        info.widgetFeatures = 0
+        info.configure = null
+        // the info is cloned from another provider: drop its previews
+        info.previewImage = 0
+        info.previewLayout = 0
+        info.resizeMode = AppWidgetProviderInfo.RESIZE_BOTH
+        info.spanX = 2; info.spanY = 1
+        info.minSpanX = 2; info.minSpanY = 1
+        info.maxSpanX = Int.MAX_VALUE; info.maxSpanY = Int.MAX_VALUE
+    }
+
+    override fun createView(context: Context, info: LauncherAppWidgetProviderInfo): AppWidgetHostView =
+        BlueOSAronaWidgetView(context)
+}
+
+/** A card like every BlueOS widget (8 dp margin, the shared material) with Arona and her status. */
+class BlueOSAronaWidgetView(context: Context) : LauncherAppWidgetHostView(context),
+    BlueOSMotion.Listener, Choreographer.FrameCallback {
+    private val cr = context.contentResolver
+    private val dp = resources.displayMetrics.density
+    private val handler = Handler(Looper.getMainLooper())
+    private val card = FrameLayout(context)
+    private val content = FrameLayout(context)
+    private val arona = AronaView(context).apply { viewport = AronaView.UPPER_BODY }
+    private val chip = ReplyChip(context)
+    private val title = text(11f, false)
+    private val status = text(17f, true)
+    private val sub = text(11f, false)
+    private val touch = AronaTouch(arona, this, chip, isNight = ::night)
+    private var motion: (() -> Unit)? = null
+    private var unobserve: (() -> Unit)? = null
+
+    private fun text(sp: Float, bold: Boolean) = TextView(context).apply {
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, sp)
+        typeface = Typeface.create(if (bold) "google-sans-text-medium" else "google-sans-text", if (bold) Typeface.BOLD else Typeface.NORMAL)
+        maxLines = 2
+    }
+
+    init {
+        val m = (8 * dp).toInt()                                   // every BlueOS widget carries its own 8 dp margin
+        setPadding(m, m, m, m)
+        card.clipToOutline = true
+        card.outlineProvider = object : ViewOutlineProvider() {
+            override fun getOutline(v: View, o: Outline) = o.setRoundRect(0, 0, v.width, v.height, BlueOSColors.radius(context))
+        }
+        addView(card, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT))
+        card.addView(content, FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT))
+        val texts = LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            gravity = Gravity.CENTER_VERTICAL
+            addView(title); addView(status); addView(sub)
+        }
+        content.addView(texts, FrameLayout.LayoutParams(FrameLayout.LayoutParams.WRAP_CONTENT, FrameLayout.LayoutParams.MATCH_PARENT).apply {
+            marginStart = (16 * dp).toInt()
+        })
+        content.addView(arona, FrameLayout.LayoutParams(0, 0, Gravity.END or Gravity.BOTTOM).apply { marginEnd = (6 * dp).toInt() })
+        addView(chip, LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT))
+        content.setOnTouchListener { _, e -> onAronaTouch(e) }
+        title.text = context.getString(R.string.blueos_widget_arona)
+        arona.tilt = { if (K.on(cr, K.HOME_TILT) && K.on(cr, K.TILT_ARONA)) BlueOSMotion.tilt else null }
+        applyColors()
+    }
+
+    private fun onAronaTouch(e: MotionEvent): Boolean {
+        val local = MotionEvent.obtain(e)
+        local.offsetLocation(-arona.left.toFloat() - arona.translationX, -arona.top.toFloat() - arona.translationY)
+        val handled = touch.onTouch(local)
+        local.recycle()
+        return handled
+    }
+
+    private fun night(): Boolean {
+        if (!K.on(cr, K.ARONA_SLEEP)) return false
+        val h = Calendar.getInstance().get(Calendar.HOUR_OF_DAY)
+        return h >= 23 || h < 7
+    }
+
+    private fun applyColors() {
+        card.background = BlueOSMaterial.background(card, K.int(cr, K.WIDGET_MATERIAL))
+        title.setTextColor(BlueOSColors.onSurfaceVariant(context))
+        status.setTextColor(BlueOSColors.onSurface(context))
+        sub.setTextColor(BlueOSColors.onSurfaceVariant(context))
+        chip.applyColors()
+    }
+
+    override fun onSizeChanged(w: Int, h: Int, oldw: Int, oldh: Int) {
+        super.onSizeChanged(w, h, oldw, oldh)
+        post {
+            val ch = card.height
+            val vp = arona.viewport
+            arona.layoutParams = (arona.layoutParams as FrameLayout.LayoutParams).apply {
+                height = (ch * 0.96f).toInt()
+                width = (height * vp.w / vp.h).toInt()
+            }
+        }
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        applyColors()                                          // glass needs the window for the blur
+        unobserve = K.observe(context, listOf(K.WIDGET_MATERIAL, K.ARONA_SLEEP, "blueos_widget_transparency")) { applyColors() }
+        motion = BlueOSMotion.acquire(context, this)
+        Choreographer.getInstance().postFrameCallback(this)
+        tick.run()
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        unobserve?.invoke(); unobserve = null
+        motion?.invoke(); motion = null
+        Choreographer.getInstance().removeFrameCallback(this)
+        handler.removeCallbacks(tick)
+    }
+
+    /** Status once a second: asleep at night, listening while music plays (she sways, not on the beat). */
+    private val tick = object : Runnable {
+        override fun run() {
+            val asleep = night()
+            if (arona.sleeping != asleep) arona.setSleeping(asleep)
+            val playing = context.getSystemService(AudioManager::class.java).isMusicActive
+            arona.music = playing && K.on(cr, K.LIVE_WIDGETS) && K.on(cr, K.ARONA_MUSIC)
+            status.setText(when { asleep -> R.string.blueos_arona_sleeping; playing -> R.string.blueos_arona_listening; else -> R.string.blueos_arona_waiting })
+            sub.text = when { asleep -> context.getString(R.string.blueos_arona_shh); playing -> ""; else -> context.getString(R.string.blueos_arona_pat_me) }
+            sub.visibility = if (sub.text.isNullOrEmpty()) GONE else VISIBLE
+            handler.postDelayed(this, 1000)
+        }
+    }
+
+    override fun doFrame(frameTimeNanos: Long) {
+        if (motion == null) return
+        val on = K.on(cr, K.LIVE_WIDGETS) && K.on(cr, K.HOME_INERTIA)
+        arona.translationX = if (on) BlueOSMotion.jigX * 0.6f * dp else 0f
+        arona.translationY = if (on) BlueOSMotion.jigY * 0.6f * dp else 0f
+        Choreographer.getInstance().postFrameCallback(this)
+    }
+
+    override fun onShake() {
+        if (!K.on(cr, K.SHAKE_ARONA) || !isShown) return
+        arona.dizzy()
+        handler.postDelayed({ touch.say(AronaReplies.Kind.SHAKE) }, 600)
+    }
+
+    override fun onFall() {
+        if (!K.on(cr, K.FALL_ARONA) || !isShown) return
+        arona.startle()
+    }
+}

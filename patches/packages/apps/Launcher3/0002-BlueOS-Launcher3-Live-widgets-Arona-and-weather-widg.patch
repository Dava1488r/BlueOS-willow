@@ -0,0 +1,152 @@
+package com.android.launcher3.blueos
+
+import android.appwidget.AppWidgetHostView
+import android.appwidget.AppWidgetProviderInfo
+import android.content.Context
+import android.graphics.Outline
+import android.graphics.Typeface
+import android.util.TypedValue
+import android.view.Choreographer
+import android.view.Gravity
+import android.view.View
+import android.view.ViewOutlineProvider
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.TextView
+import com.android.launcher3.R
+import com.android.launcher3.widget.LauncherAppWidgetHostView
+import com.android.launcher3.widget.LauncherAppWidgetProviderInfo
+import com.android.launcher3.widget.custom.CustomWidget
+import org.blueos.arona.BlueOSMotion
+import org.blueos.arona.BlueOSSettings as K
+import org.blueos.arona.Weather
+import org.blueos.arona.WeatherIconView
+
+/** BlueOS 0.7: the launcher's own "Погода" widget, 2×1 (resizable). */
+object BlueOSWeatherWidget : CustomWidget {
+    override val id: String = "blueos-weather"
+
+    override fun updateWidgetInfo(context: Context, info: LauncherAppWidgetProviderInfo) {
+        info.label = context.getString(R.string.blueos_widget_weather)
+        info.widgetFeatures = 0
+        info.configure = null
+        // the info is cloned from another provider: drop its previews
+        info.previewImage = 0
+        info.previewLayout = 0
+        info.resizeMode = AppWidgetProviderInfo.RESIZE_BOTH
+        info.spanX = 2; info.spanY = 1
+        info.minSpanX = 2; info.minSpanY = 1
+        info.maxSpanX = Int.MAX_VALUE; info.maxSpanY = Int.MAX_VALUE
+    }
+
+    override fun createView(context: Context, info: LauncherAppWidgetProviderInfo): AppWidgetHostView =
+        BlueOSWeatherWidgetView(context)
+}
+
+/**
+ * Laid out like the «Дата» widget next to it (one big value + small captions): big temperature, the weather and
+ * today's high/low to its right, "feels like" below, a live weather icon. Taps open the phone's weather app.
+ */
+class BlueOSWeatherWidgetView(context: Context) : LauncherAppWidgetHostView(context), Choreographer.FrameCallback {
+    private val cr = context.contentResolver
+    private val dp = resources.displayMetrics.density
+    private val card = FrameLayout(context)
+    private val big = TextView(context)
+    private val name = small()
+    private val hiLo = small()
+    private val feels = small()
+    private val icon = WeatherIconView(context)
+    private var unobserve: (() -> Unit)? = null
+    private var motion: (() -> Unit)? = null
+
+    private fun small() = TextView(context).apply {
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+        typeface = Typeface.create("google-sans-text", Typeface.NORMAL)
+        maxLines = 1
+    }
+
+    init {
+        val m = (8 * dp).toInt()
+        setPadding(m, m, m, m)
+        card.clipToOutline = true
+        card.outlineProvider = object : ViewOutlineProvider() {
+            override fun getOutline(v: View, o: Outline) = o.setRoundRect(0, 0, v.width, v.height, BlueOSColors.radius(context))
+        }
+        addView(card, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT))
+        big.setTextSize(TypedValue.COMPLEX_UNIT_SP, 44f)
+        big.typeface = Typeface.create("blueos-clock", Typeface.BOLD)   // the digits font of the BlueOS widgets
+        big.includeFontPadding = false
+        val captions = LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            addView(name); addView(hiLo)
+        }
+        val top = LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            addView(big)
+            addView(captions, LinearLayout.LayoutParams(-2, -2).apply { marginStart = (12 * dp).toInt() })
+        }
+        val column = LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            gravity = Gravity.CENTER_VERTICAL
+            addView(top)
+            addView(feels, LinearLayout.LayoutParams(-2, -2).apply { topMargin = (6 * dp).toInt() })
+        }
+        card.addView(column, FrameLayout.LayoutParams(-2, -1).apply { marginStart = (16 * dp).toInt() })
+        card.addView(icon, FrameLayout.LayoutParams((40 * dp).toInt(), (40 * dp).toInt(), Gravity.END or Gravity.CENTER_VERTICAL).apply { marginEnd = (14 * dp).toInt() })
+        card.setOnClickListener {
+            context.packageManager.getLaunchIntentForPackage("com.google.android.apps.weather")?.let { context.startActivity(it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK)) }
+        }
+        bind()
+    }
+
+    private fun bind() {
+        card.background = BlueOSMaterial.background(card, K.int(cr, K.WIDGET_MATERIAL))
+        val onS = BlueOSColors.onSurface(context)
+        val variant = BlueOSColors.onSurfaceVariant(context)
+        big.setTextColor(onS); name.setTextColor(onS); hiLo.setTextColor(variant); feels.setTextColor(variant)
+        icon.color = onS
+        icon.live = K.on(cr, K.LIVE_WIDGETS) && K.on(cr, K.WEATHER_LIVE)
+        val w = Weather.read(cr)
+        if (w == null) {
+            big.text = "—"; name.setText(R.string.blueos_weather_none); hiLo.text = ""; feels.text = ""
+            icon.weather = null
+            return
+        }
+        big.text = Weather.format(cr, w.temp)
+        name.setText(when (w.kind) {
+            Weather.Kind.CLEAR -> R.string.blueos_weather_clear
+            Weather.Kind.CLOUDY -> R.string.blueos_weather_cloudy
+            Weather.Kind.RAIN -> R.string.blueos_weather_rain
+            Weather.Kind.SNOW -> R.string.blueos_weather_snow
+            Weather.Kind.STORM -> R.string.blueos_weather_storm
+        })
+        hiLo.text = "${Weather.format(cr, w.high)} / ${Weather.format(cr, w.low)}"
+        feels.text = context.getString(R.string.blueos_weather_feels, Weather.format(cr, w.feels))
+        icon.weather = w
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        bind()
+        unobserve = K.observe(context, listOf(K.WEATHER, K.WEATHER_F, K.WEATHER_LIVE, K.LIVE_WIDGETS, K.WIDGET_MATERIAL, "blueos_widget_transparency")) { bind() }
+        motion = BlueOSMotion.acquire(context)
+        Choreographer.getInstance().postFrameCallback(this)
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        unobserve?.invoke(); unobserve = null
+        motion?.invoke(); motion = null
+        Choreographer.getInstance().removeFrameCallback(this)
+    }
+
+    // inertia: the live icon lags behind the phone's motion and springs back
+    override fun doFrame(frameTimeNanos: Long) {
+        if (motion == null) return
+        val on = K.on(cr, K.LIVE_WIDGETS) && K.on(cr, K.HOME_INERTIA)
+        icon.translationX = if (on) BlueOSMotion.jigX * 0.8f * dp else 0f
+        icon.translationY = if (on) BlueOSMotion.jigY * 0.8f * dp else 0f
+        Choreographer.getInstance().postFrameCallback(this)
+    }
+}

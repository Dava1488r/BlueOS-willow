+package com.android.launcher3.blueos
+
+import android.appwidget.AppWidgetHostView
+import android.content.Context
+import android.content.res.ColorStateList
+import android.content.res.Configuration
+import android.graphics.BlurMaskFilter
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Matrix
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RadialGradient
+import android.graphics.Rect
+import android.graphics.RectF
+import android.graphics.Shader
+import android.graphics.drawable.Drawable
+import android.graphics.drawable.GradientDrawable
+import android.graphics.drawable.LayerDrawable
+import android.media.AudioManager
+import android.os.PowerManager
+import android.os.SystemClock
+import android.provider.Settings
+import android.view.Choreographer
+import android.view.MotionEvent
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.TextView
+import org.blueos.arona.BlueOSMotion
+import org.blueos.arona.BlueOSSettings as K
+import org.blueos.arona.Weather
+import org.blueos.arona.WeatherIconView
+import kotlin.math.PI
+import kotlin.math.exp
+import kotlin.math.sin
+
+/** Monet roles for BlueOS widget cards — never fixed colours, so any wallpaper works. */
+object BlueOSColors {
+    fun dark(c: Context) = (c.resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES
+    fun card(c: Context) = c.getColor(if (dark(c)) android.R.color.system_surface_container_dark else android.R.color.system_surface_container_light)
+    fun onSurface(c: Context) = c.getColor(if (dark(c)) android.R.color.system_on_surface_dark else android.R.color.system_on_surface_light)
+    fun onSurfaceVariant(c: Context) = c.getColor(if (dark(c)) android.R.color.system_on_surface_variant_dark else android.R.color.system_on_surface_variant_light)
+    fun accent(c: Context) = c.getColor(if (dark(c)) android.R.color.system_accent1_200 else android.R.color.system_accent1_600)
+    fun withAlpha(color: Int, a: Float) = (color and 0x00ffffff) or ((a.coerceIn(0f, 1f) * 255).toInt() shl 24)
+    fun mix(a: Int, b: Int, f: Float) = Color.rgb(
+        (Color.red(a) * f + Color.red(b) * (1 - f)).toInt(),
+        (Color.green(a) * f + Color.green(b) * (1 - f)).toInt(),
+        (Color.blue(a) * f + Color.blue(b) * (1 - f)).toInt())
+    /** The widgets' transparency slider (Обои и стиль → Палитра), 0…1 opacity of the card. */
+    fun cardOpacity(c: Context) = 1f - Settings.Secure.getInt(c.contentResolver, "blueos_widget_transparency", 15) / 100f
+    fun radius(c: Context) = c.resources.getDimension(android.R.dimen.system_app_widget_background_radius)
+}
+
+/** The five card materials: 0 matte (as before), 1 glass, 2 solid, 3 outline, 4 accent. */
+object BlueOSMaterial {
+    /** A drawable for a card of [material] (glass needs the view, for the cross-window blur of the wallpaper). */
+    fun background(view: View, material: Int): Drawable {
+        val c = view.context
+        val r = BlueOSColors.radius(c)
+        val onS = BlueOSColors.onSurface(c)
+        fun shape(fill: Int, stroke: Int = 0, strokeW: Float = 0f) = GradientDrawable().apply {
+            cornerRadius = r
+            setColor(fill)
+            if (stroke != 0) setStroke(strokeW.toInt().coerceAtLeast(1), stroke)
+        }
+        val dp = c.resources.displayMetrics.density
+        return when (material) {
+            1 -> {
+                val edge = shape(BlueOSColors.withAlpha(onS, 0.07f), BlueOSColors.withAlpha(onS, 0.14f), dp)
+                blur(view, r)?.let { LayerDrawable(arrayOf(it, edge)) } ?: shape(BlueOSColors.withAlpha(BlueOSColors.card(c), 0.55f), BlueOSColors.withAlpha(onS, 0.14f), dp)
+            }
+            2 -> shape(BlueOSColors.card(c))
+            3 -> shape(BlueOSColors.withAlpha(Color.BLACK, 0.15f), BlueOSColors.withAlpha(onS, 0.24f), 1.5f * dp)
+            4 -> shape(BlueOSColors.withAlpha(BlueOSColors.mix(BlueOSColors.accent(c), BlueOSColors.card(c), 0.26f), BlueOSColors.cardOpacity(c)))
+            else -> shape(BlueOSColors.withAlpha(BlueOSColors.card(c), BlueOSColors.cardOpacity(c)))
+        }
+    }
+
+    /** Cross-window blur of what is behind the launcher window (the wallpaper); null if unavailable. */
+    private fun blur(view: View, r: Float): Drawable? = try {
+        val root = View::class.java.getMethod("getViewRootImpl").invoke(view) ?: return null
+        val d = root.javaClass.getMethod("createBackgroundBlurDrawable").invoke(root) as Drawable
+        d.javaClass.getMethod("setBlurRadius", Int::class.javaPrimitiveType).invoke(d, (30 * view.resources.displayMetrics.density).toInt())
+        d.javaClass.getMethod("setCornerRadius", Float::class.javaPrimitiveType).invoke(d, r)
+        d.javaClass.getMethod("setColor", Int::class.javaPrimitiveType).invoke(d, BlueOSColors.withAlpha(BlueOSColors.card(view.context), 0.3f))
+        d
+    } catch (t: Throwable) {
+        null
+    }
+}
+
+/**
+ * BlueOS 0.7 live layer for BlueOS's own RemoteViews widgets (SystemUI, Clock, Calendar, Gallery), drawn
+ * by the launcher: card materials, a shine over the greeting / the day number, the live halo of the clock
+ * card, a seconds line, the play button's pulse and rising notes, a springy bounce of the quick toggles,
+ * a glare that follows the phone's tilt, inertia of live objects and live weather icons.
+ * Everything only while the home screen is on and "Живые виджеты" is on (and not in battery saver if chosen).
+ */
+class BlueOSWidgetDecorator(private val host: AppWidgetHostView) : Choreographer.FrameCallback, BlueOSMotion.Listener {
+    private val ctx = host.context
+    private val cr = ctx.contentResolver
+    private val dp = ctx.resources.displayMetrics.density
+    private var attached = false
+    private var running = false
+    private var motion: (() -> Unit)? = null
+    private var unobserve: (() -> Unit)? = null
+    private var t = 0f
+    private var last = 0L
+
+    private var cards = listOf<View>()
+    private var greeting: TextView? = null
+    private var day: TextView? = null
+    private var halo: ImageView? = null
+    private var play: View? = null
+    private var note: View? = null
+    private var toggles = listOf<View>()
+    private val weatherIcons = mutableListOf<Pair<View, WeatherIconView>>()
+    private var deskClock = false
+
+    private var haloSwingA = 0f
+    private var haloSwingV = 0f
+    private var sparkleT = -1f
+    private var minute = -1
+    private var blackoutT = -1f
+    private var playing = false
+    private var playingCheckedAt = 0L
+
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val tmp = Rect()
+    private val rectF = RectF()
+    private val path = Path()
+
+    private val ourPackages = setOf("com.android.systemui", "com.android.deskclock", "org.lineageos.etar", "org.lineageos.glimpse")
+    private val pkg get() = host.appWidgetInfo?.provider?.packageName
+    val isOurs get() = pkg in ourPackages
+
+    private fun id(name: String): Int {
+        val p = pkg ?: return 0
+        return try { ctx.packageManager.getResourcesForApplication(p).getIdentifier(name, "id", p) } catch (e: Exception) { 0 }
+    }
+    private fun <T : View> find(name: String): T? = id(name).takeIf { it != 0 }?.let { host.findViewById<T>(it) }
+    private fun findAll(name: String): List<View> {
+        val i = id(name)
+        if (i == 0) return emptyList()
+        val out = mutableListOf<View>()
+        fun walk(v: View) { if (v.id == i) out += v; if (v is ViewGroup) for (k in 0 until v.childCount) walk(v.getChildAt(k)) }
+        walk(host)
+        return out
+    }
+
+    private fun live() = K.on(cr, K.LIVE_WIDGETS) &&
+        !(K.on(cr, K.LIVE_SAVER) && ctx.getSystemService(PowerManager::class.java).isPowerSaveMode)
+
+    /** After every RemoteViews apply: find our views again and apply the material. */
+    fun onUpdated() {
+        if (!isOurs) return
+        deskClock = pkg == "com.android.deskclock"
+        cards = findAll("blueos_widget_bg")
+        greeting = find("blueos_summary_greeting")
+        day = find("blueos_day")
+        halo = find("blueos_halo")
+        play = find("blueos_media_play_pause")
+        note = find("blueos_media_placeholder")
+        toggles = listOf("blueos_toggle_flashlight", "blueos_toggle_dnd", "blueos_toggle_rotate", "blueos_toggle_dark", "blueos_toggle_saver").mapNotNull { find<View>(it) }
+        applyMaterial()
+        attachWeatherIcons()
+        updateRunning()
+    }
+
+    private fun applyMaterial() {
+        val m = K.int(cr, K.WIDGET_MATERIAL)
+        for (card in cards) {
+            val iv = card as? ImageView ?: continue
+            if (m == 0) {
+                // matte = exactly as the widget itself draws it
+                (iv.getTag(TAG_ORIGINAL) as? Drawable)?.let { iv.background = it; iv.setTag(TAG_ORIGINAL, null) }
+                iv.imageAlpha = (BlueOSColors.cardOpacity(ctx) * 255).toInt()   // the transparency slider
+                continue
+            }
+            if (iv.getTag(TAG_ORIGINAL) == null) iv.setTag(TAG_ORIGINAL, iv.background ?: GradientDrawable())
+            iv.imageAlpha = 0                                   // the widget's own card shape is replaced
+            iv.alpha = 1f
+            iv.background = BlueOSMaterial.background(iv, m)
+        }
+    }
+
+    /** Live weather icons over the widgets' static ones (Сводка / Дата). */
+    private fun attachWeatherIcons() {
+        weatherIcons.forEach { (_, w) -> host.removeView(w) }
+        weatherIcons.clear()
+        if (!K.on(cr, K.WEATHER_LIVE)) return
+        val w = Weather.read(cr) ?: return
+        for (name in listOf("blueos_summary_weather_icon", "blueos_weather_icon")) {
+            val src = find<ImageView>(name) ?: continue
+            if (src.visibility != View.VISIBLE) continue
+            val icon = WeatherIconView(ctx).apply { weather = w; color = src.imageTintList?.defaultColor ?: BlueOSColors.onSurface(ctx) }
+            host.addView(icon, FrameLayout.LayoutParams(0, 0))
+            weatherIcons += src to icon
+            src.imageAlpha = 0
+            src.addOnLayoutChangeListener { _, _, _, _, _, _, _, _, _ -> place(src, icon) }
+            host.post { place(src, icon) }
+        }
+    }
+
+    private fun place(src: View, icon: View) {
+        if (!src.isAttachedToWindow) return
+        tmp.set(0, 0, src.width, src.height)
+        host.offsetDescendantRectToMyCoords(src, tmp)
+        val lp = icon.layoutParams as FrameLayout.LayoutParams
+        if (lp.width == tmp.width() && lp.height == tmp.height() && lp.leftMargin == tmp.left && lp.topMargin == tmp.top) return
+        lp.width = tmp.width(); lp.height = tmp.height(); lp.leftMargin = tmp.left; lp.topMargin = tmp.top
+        icon.layoutParams = lp
+    }
+
+    fun onAttached(on: Boolean) {
+        attached = on
+        if (on && unobserve == null) {
+            unobserve = K.observe(ctx, listOf(K.LIVE_WIDGETS, K.LIVE_SAVER, K.WIDGET_MATERIAL, K.WEATHER, K.WEATHER_LIVE,
+                "blueos_widget_transparency")) { if (isOurs) onUpdated() }
+        } else if (!on) {
+            unobserve?.invoke(); unobserve = null
+        }
+        updateRunning()
+    }
+
+    private fun updateRunning() {
+        val want = attached && isOurs && live()
+        if (want == running) return
+        running = want
+        if (want) {
+            last = 0L
+            Choreographer.getInstance().postFrameCallback(this)
+            if (motion == null) motion = BlueOSMotion.acquire(ctx, this)
+        } else {
+            Choreographer.getInstance().removeFrameCallback(this)
+            motion?.invoke(); motion = null
+            halo?.apply { rotation = 0f; translationX = 0f; translationY = 0f; alpha = 1f }
+            greeting?.paint?.shader = null; day?.paint?.shader = null
+            greeting?.invalidate(); day?.invalidate()
+            weatherIcons.forEach { (_, w) -> w.translationX = 0f; w.translationY = 0f }
+            host.invalidate()
+        }
+    }
+
+    override fun doFrame(frameTimeNanos: Long) {
+        if (!running) return
+        val dt = if (last == 0L) 0f else ((frameTimeNanos - last) / 1e9f).coerceIn(0f, 0.05f)
+        last = frameTimeNanos
+        t += dt
+        if (host.isShown && ctx.getSystemService(PowerManager::class.java).isInteractive) step(dt)
+        Choreographer.getInstance().postFrameCallback(this)
+    }
+
+    private fun step(dt: Float) {
+        val inertia = K.on(cr, K.HOME_INERTIA)
+        val jx = if (inertia) BlueOSMotion.jigX * dp else 0f
+        val jy = if (inertia) BlueOSMotion.jigY * dp else 0f
+        // shine on the real glyphs of the greeting and the day number
+        shine(greeting, K.SUMMARY_SHIMMER, 0f)
+        shine(day, K.DATE_SHIMMER, 2.2f)
+        // live halo of the clock card
+        halo?.let { h ->
+            if (K.on(cr, K.CLOCK_HALO)) {
+                haloSwingV += (-haloSwingA * 90f - haloSwingV * 3.4f) * dt
+                haloSwingA += haloSwingV * dt
+                val tilt = if (K.on(cr, K.HOME_TILT) && K.on(cr, K.TILT_HALO)) BlueOSMotion.tilt[0] * 7f else 0f
+                h.rotation = sin(t * 2 * PI.toFloat() / 7f) * 2f + haloSwingA + tilt - jx / dp * 1.5f
+                h.translationX = (jx * 0.6f).coerceIn(-5 * dp, 5 * dp)
+                h.translationY = sin(t * 2 * PI.toFloat() / 5.5f) * 1.4f * dp + (jy * 0.6f).coerceIn(-4 * dp, 4 * dp)
+                h.alpha = blackout(dt) * (0.9f + 0.1f * sin(t * 2 * PI.toFloat() / 4f))
+                val m = (System.currentTimeMillis() / 60_000L).toInt()
+                if (minute != -1 && m != minute) sparkleT = 0f
+                minute = m
+                if (sparkleT >= 0f) { sparkleT += dt / 1.1f; if (sparkleT > 1f) sparkleT = -1f }
+            } else { h.rotation = 0f; h.translationX = 0f; h.translationY = 0f; h.alpha = 1f }
+        }
+        weatherIcons.forEach { (_, w) -> w.translationX = jx * 0.8f; w.translationY = jy * 0.8f }
+        val now = SystemClock.uptimeMillis()
+        if (now - playingCheckedAt > 500) { playingCheckedAt = now; playing = ctx.getSystemService(AudioManager::class.java).isMusicActive }
+        host.invalidate()
+    }
+
+    private fun blackout(dt: Float): Float {
+        if (blackoutT < 0f) return 1f
+        blackoutT += dt
+        val p = blackoutT / 2.3f
+        return when {
+            p > 1f -> { blackoutT = -1f; 1f }
+            p < 0.42f -> 0f
+            p < 0.5f -> 0.85f
+            p < 0.56f -> 0.1f
+            p < 0.66f -> 0.9f
+            p < 0.72f -> 0.25f
+            else -> 1f
+        }
+    }
+
+    private fun shine(tv: TextView?, key: String, delay: Float) {
+        tv ?: return
+        if (!K.on(cr, key)) { if (tv.paint.shader != null) { tv.paint.shader = null; tv.invalidate() }; return }
+        val p = ((t + 7f - delay) % 7f) / 2.1f                       // a sweep every 7 s, 2.1 s long
+        if (p > 1f) { if (tv.paint.shader != null) { tv.paint.shader = null; tv.invalidate() }; return }
+        val base = tv.currentTextColor
+        val shineColor = BlueOSColors.mix(ctx.getColor(android.R.color.system_accent1_50), base, 0.85f)
+        val w = tv.width.toFloat().coerceAtLeast(1f)
+        val band = w * 0.45f
+        val g = LinearGradient(0f, 0f, band, 0f, intArrayOf(base, shineColor, base), null, Shader.TileMode.CLAMP)
+        g.setLocalMatrix(Matrix().apply { setTranslate(-band + p * (w + band * 2) - band / 2, 0f) })
+        tv.paint.shader = g
+        tv.invalidate()
+    }
+
+    /** After the children: glare, seconds line, play pulse and notes, halo gleam. */
+    fun drawOverlay(canvas: Canvas) {
+        if (!running) return
+        if (K.on(cr, K.HOME_TILT) && K.on(cr, K.TILT_GLARE)) for (card in cards) {
+            if (!card.isShown) continue
+            bounds(card)
+            canvas.save()
+            path.reset(); path.addRoundRect(rectF, BlueOSColors.radius(ctx), BlueOSColors.radius(ctx), Path.Direction.CW)
+            canvas.clipPath(path)
+            val cx = rectF.left + rectF.width() * (0.5f + BlueOSMotion.tilt[0] * 0.55f)
+            val cy = rectF.top + rectF.height() * (0.2f + BlueOSMotion.tilt[1] * 0.6f)
+            paint.style = Paint.Style.FILL
+            paint.shader = RadialGradient(cx, cy, rectF.width() * 0.75f, BlueOSColors.withAlpha(BlueOSColors.onSurface(ctx), 0.075f), Color.TRANSPARENT, Shader.TileMode.CLAMP)
+            canvas.drawRect(rectF, paint)
+            paint.shader = null
+            canvas.restore()
+        }
+        if (deskClock && K.on(cr, K.CLOCK_SECONDS)) cards.firstOrNull { it.isShown }?.let { card ->
+            bounds(card)
+            val y = rectF.bottom - 14 * dp
+            val l = rectF.left + rectF.width() * 0.14f
+            val r = rectF.right - rectF.width() * 0.14f
+            val s = (System.currentTimeMillis() % 60_000L) / 60_000f
+            paint.style = Paint.Style.STROKE; paint.strokeCap = Paint.Cap.ROUND; paint.strokeWidth = 2 * dp
+            paint.color = BlueOSColors.withAlpha(BlueOSColors.onSurface(ctx), 0.10f)
+            canvas.drawLine(l, y, r, y, paint)
+            paint.color = BlueOSColors.accent(ctx)
+            canvas.drawLine(l, y, l + (r - l) * s, y, paint)
+        }
+        if (playing && K.on(cr, K.MUSIC_LIVE)) {
+            play?.takeIf { it.isShown }?.let { b ->
+                bounds(b)
+                val p = (t % 1.6f) / 1.6f
+                paint.style = Paint.Style.STROKE; paint.strokeWidth = 2 * dp
+                paint.color = BlueOSColors.withAlpha(BlueOSColors.onSurface(ctx), 0.32f * (1 - p))
+                canvas.drawCircle(rectF.centerX(), rectF.centerY(), rectF.width() / 2 + p * 7 * dp, paint)
+            }
+            note?.takeIf { it.isShown }?.let { n ->
+                bounds(n)
+                paint.style = Paint.Style.FILL; paint.textSize = 13 * dp
+                for (i in 0..2) {
+                    val p = ((t / 2.6f) + i / 3f) % 1f
+                    paint.color = BlueOSColors.withAlpha(BlueOSColors.onSurface(ctx), 0.85f * sin(p * PI.toFloat()))
+                    canvas.drawText(if (i == 1) "♫" else "♪", rectF.right + (i - 1) * 6 * dp, rectF.top - p * 34 * dp + 8 * dp, paint)
+                }
+            }
+        }
+        halo?.takeIf { sparkleT >= 0f && it.isShown && K.on(cr, K.CLOCK_HALO) }?.let { h ->
+            bounds(h)
+            canvas.save()
+            canvas.rotate(h.rotation - 10f, rectF.centerX(), rectF.centerY())
+            rectF.inset(rectF.width() * 0.08f, rectF.height() * 0.25f)
+            paint.style = Paint.Style.STROKE; paint.strokeCap = Paint.Cap.ROUND; paint.strokeWidth = 2.5f * dp
+            paint.maskFilter = BlurMaskFilter(1.5f * dp, BlurMaskFilter.Blur.NORMAL)
+            paint.color = BlueOSColors.withAlpha(ctx.getColor(android.R.color.system_accent1_10), sin(sparkleT * PI.toFloat()))
+            canvas.drawArc(rectF, -200f + sparkleT * 360f, 32f, false, paint)
+            paint.maskFilter = null
+            canvas.restore()
+        }
+    }
+
+    private fun bounds(v: View) {
+        tmp.set(0, 0, v.width, v.height)
+        host.offsetDescendantRectToMyCoords(v, tmp)
+        rectF.set(tmp)
+    }
+
+    /** Taps (observed, never consumed): toggles bounce, the halo swings. */
+    fun onTouch(e: MotionEvent) {
+        if (!running || e.actionMasked != MotionEvent.ACTION_UP) return
+        if (K.on(cr, K.TOGGLES_LIVE)) for (tg in toggles) {
+            bounds(tg)
+            if (rectF.contains(e.x, e.y)) {
+                tg.animate().scaleX(0.9f).scaleY(0.9f).setDuration(120).withEndAction {
+                    tg.animate().scaleX(1f).scaleY(1f).setDuration(220).start()
+                }.start()
+            }
+        }
+        halo?.let { h -> bounds(h); if (rectF.contains(e.x, e.y)) haloSwingV += 220f * if (e.x < rectF.centerX()) -1 else 1 }
+    }
+
+    override fun onFall() { if (K.on(cr, K.FALL_HALO) && halo != null) blackoutT = 0f }
+
+    companion object {
+        private val TAG_ORIGINAL = com.android.launcher3.R.id.blueos_original_bg
+    }
+}

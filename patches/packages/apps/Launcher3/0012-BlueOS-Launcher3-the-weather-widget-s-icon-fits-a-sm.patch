+/**
+ * 0.8.1: the icon takes what the text leaves: it stood at 40 dp over the captions of a small card. Beside the text it
+ * shrinks to 28 dp; with less room than that the captions go under the temperature and the icon sits next to the
+ * temperature. What still doesn't fit is hidden: «Ощущается как», then the high/low. Sizes in px; [cardW]/[cardH] = the card.
+ */
+internal fun fitWeatherWidget(dp: Float, cardW: Int, cardH: Int, top: LinearLayout, big: View, captions: View, hiLo: View,
+    feels: View?, icon: View?) {
+    val unspecified = View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED)
+    val start = (16 * dp).toInt()
+    val end = (14 * dp).toInt()
+    val feelsGap = (6 * dp).toInt()
+    fun measure(v: View) = v.measure(unspecified, unspecified)
+    fun visible(v: View, on: Boolean) {
+        val want = if (on) View.VISIBLE else View.GONE
+        if (v.visibility != want) v.visibility = want
+    }
+    fun arrange(vertical: Boolean) {
+        val orientation = if (vertical) LinearLayout.VERTICAL else LinearLayout.HORIZONTAL
+        if (top.orientation != orientation) top.orientation = orientation
+        val gravity = if (vertical) Gravity.START else Gravity.CENTER_VERTICAL
+        if (top.gravity != gravity) top.gravity = gravity
+        val lp = captions.layoutParams as LinearLayout.LayoutParams
+        val ms = if (vertical) 0 else (12 * dp).toInt()
+        val mt = if (vertical) (2 * dp).toInt() else 0
+        if (lp.marginStart != ms || lp.topMargin != mt) {
+            lp.marginStart = ms; lp.topMargin = mt
+            captions.layoutParams = lp
+        }
+    }
+    fun place(size: Int, gravity: Int, topMargin: Int) {
+        val v = icon ?: return
+        val lp = v.layoutParams as FrameLayout.LayoutParams
+        if (lp.width != size || lp.height != size || lp.gravity != gravity || lp.topMargin != topMargin || lp.marginEnd != end) {
+            lp.width = size; lp.height = size; lp.gravity = gravity; lp.topMargin = topMargin; lp.marginEnd = end
+            v.layoutParams = lp
+        }
+    }
+
+    visible(hiLo, true)
+    arrange(vertical = false)
+    measure(top)
+    val free = cardW - start - top.measuredWidth - end - (6 * dp).toInt()
+    if (free >= 28 * dp) {
+        val size = minOf(free, (40 * dp).toInt())
+        place(size, Gravity.END or Gravity.CENTER_VERTICAL, 0)
+        feels?.let {
+            measure(it)
+            visible(it, start + it.measuredWidth <= cardW - end - size && top.measuredHeight + feelsGap + it.measuredHeight <= cardH)
+        }
+        return
+    }
+    arrange(vertical = true)
+    measure(top)
+    if (top.measuredHeight > cardH) {
+        visible(hiLo, false)
+        measure(top)
+    }
+    val contentH = feels?.let {
+        measure(it)
+        val fits = start + it.measuredWidth <= cardW - (8 * dp).toInt() && top.measuredHeight + feelsGap + it.measuredHeight <= cardH
+        visible(it, fits)
+        if (fits) top.measuredHeight + feelsGap + it.measuredHeight else top.measuredHeight
+    } ?: top.measuredHeight
+    val size = (30 * dp).toInt()
+    place(size, Gravity.END or Gravity.TOP, ((cardH - contentH) / 2 + (big.measuredHeight - size) / 2).coerceAtLeast(0))
+}

+    /**
+     * 0.8: a track title too long for its lines runs as a marquee (with «Живые виджеты»). A widget can't do it
+     * itself — a TextView scrolls only while selected (no RemoteViews call), and the music widget re-sets its text
+     * every 3 s for the progress bar, which restarts a marquee from the start. So, like the live weather icons, the
+     * launcher lays its own one-line TextView over the hidden title and changes its text only when the track
+     * changes. Titles that fit (or the idle line) stay the widget's own; without live widgets: «…» as before.
+     */
+    private fun marquee() {
+        val srcs = if (live()) findAll("blueos_media_title").filterIsInstance<TextView>() else emptyList()
+        // keep the overlays of titles that are still there: this runs after every widget update (every 3 s while
+        // music plays), and a new overlay starts its run from the beginning — the text ran a bit and stood still
+        titles.removeAll { (src, t) ->
+            (src !in srcs).also { gone -> if (gone) { host.removeView(t); src.alpha = 1f } }
+        }
+        for (src in srcs) {
+            if (titles.any { it.first === src }) continue
+            val t = TextView(ctx).apply {
+                setSingleLine(true)
+                ellipsize = android.text.TextUtils.TruncateAt.MARQUEE
+                marqueeRepeatLimit = -1
+                isSelected = true
+                gravity = android.view.Gravity.CENTER_VERTICAL or android.view.Gravity.START
+                importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO
+                visibility = View.GONE
+            }
+            host.addView(t, FrameLayout.LayoutParams(0, 0))
+            titles += src to t
+        }
+    }
+
+    /** Before every frame: the overlay follows the hidden title's place and look; shown only while it's cut. */
+    private fun syncTitles() {
+        for ((src, t) in titles) {
+            val l = src.layout
+            val cut = src.isShown && l != null && l.lineCount > 0 && l.getEllipsisCount(l.lineCount - 1) > 0
+            if (!cut) {
+                if (t.visibility != View.GONE) t.visibility = View.GONE
+                if (src.alpha != 1f) src.alpha = 1f
+                continue
+            }
+            val text = src.text.toString()
+            if (t.text.toString() != text) t.text = text                 // only a new track restarts the run
+            if (t.currentTextColor != src.currentTextColor) t.setTextColor(src.currentTextColor)
+            if (t.textSize != src.textSize) t.setTextSize(android.util.TypedValue.COMPLEX_UNIT_PX, src.textSize)
+            if (t.typeface != src.typeface) t.typeface = src.typeface
+            if (t.paddingLeft != src.paddingLeft || t.paddingRight != src.paddingRight)
+                t.setPadding(src.paddingLeft, 0, src.paddingRight, 0)
+            if (t.visibility != View.VISIBLE) t.visibility = View.VISIBLE
+            if (!t.isSelected) t.isSelected = true                    // a parent's setSelected(false) reaches it too
+            if (src.alpha != 0f) src.alpha = 0f
+            place(src, t)
+        }
+    }

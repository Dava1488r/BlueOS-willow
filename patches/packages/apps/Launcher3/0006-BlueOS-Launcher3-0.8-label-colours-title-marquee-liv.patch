 package com.android.launcher3.blueos
 
 import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Rect
+import android.graphics.drawable.Drawable
+import android.view.View
 import java.util.Locale
 import org.blueos.arona.BlueOSSettings as K
 
@@ -25,7 +29,12 @@ object BlueOSIcons {
     /** The icon mask to use, or null to keep the picked shape. */
     fun mask(context: Context): String? = roundness(context).let { if (it >= 100) null else roundedPath(it) }
 
-    val KEYS = listOf(K.ICON_ROUNDNESS, K.ICON_MATERIAL, K.WIDGET_MATERIAL, K.ICON_TRANSPARENCY)
+    val KEYS = listOf(K.ICON_ROUNDNESS, K.ICON_MATERIAL, K.WIDGET_MATERIAL, K.ICON_TRANSPARENCY, K.COLOR_ICONS,
+        K.WIDGET_TRANSPARENCY, K.WIDGET_BLUR)
+
+    /** 0.8 «Точно как у виджетов» (-2): the blur radius in px under the plates, 0 = none; the corner as a part of the plate. */
+    @Volatile private var blurPx = 0f
+    @Volatile private var cornerPart = 0.5f
 
     /**
      * The plate the icons really use: their own material or the widgets' («как у виджетов», -1), and its
@@ -34,6 +43,36 @@ object BlueOSIcons {
     fun plate(context: Context): String {
         val cr = context.contentResolver
         val m = K.int(cr, K.ICON_MATERIAL)
-        return "${if (m == -1) K.int(cr, K.WIDGET_MATERIAL) else m}/${K.int(cr, K.ICON_TRANSPARENCY)}"
+        // 0.8: «Точно как у виджетов»: their material, transparency and blur (ThemedIconDelegate makes the colour)
+        if (m == -2) {
+            val wm = K.int(cr, K.WIDGET_MATERIAL)
+            blurPx = if (wm == 2) 0f else BlueOSMaterial.blurRadius(context, wm)
+            cornerPart = roundness(context) / 200f
+            return "exact/$wm/${K.int(cr, K.WIDGET_TRANSPARENCY)}/${K.int(cr, K.WIDGET_BLUR)}/${K.int(cr, K.COLOR_ICONS)}"
+        }
+        blurPx = 0f
+        // 0.8: and the glyph's role («Цвет значков» in «Цвета»)
+        return "${if (m == -1) K.int(cr, K.WIDGET_MATERIAL) else m}/${K.int(cr, K.ICON_TRANSPARENCY)}/${K.int(cr, K.COLOR_ICONS)}"
+    }
+
+    private val blurs = java.util.WeakHashMap<View, Pair<String, Drawable>>()
+
+    /**
+     * 0.8: the wallpaper blurred under a home screen icon's plate [plate] (in [v]'s coordinates), like under the widget
+     * cards — drawn by BubbleTextView before the icon. Only on a hardware canvas: a software one (a drag preview) can't.
+     */
+    @JvmStatic
+    fun drawBlur(v: View, canvas: Canvas, plate: Rect) {
+        val r = blurPx
+        if (r < 1f || !canvas.isHardwareAccelerated || !v.isAttachedToWindow || plate.isEmpty) return
+        val corner = plate.width() * cornerPart
+        val key = "$r/$corner"
+        var e = blurs[v]
+        if (e == null || e.first != key) {
+            e = key to (BlueOSMaterial.blur(v, corner, r) ?: return)
+            blurs[v] = e
+        }
+        e.second.bounds = plate
+        e.second.draw(canvas)
     }
 }

-            sub.visibility = if (sub.text.isNullOrEmpty()) GONE else VISIBLE
-            handler.postDelayed(this, 1000)
+            val (s, hint) = phrase(asleep, playing)
+            if (status.text != s) status.text = s
+            if (sub.text != hint) sub.text = hint
+            sub.visibility = if (hint.isEmpty() || K.int(cr, K.ARONA_WIDGET_TEXT) != 0) GONE else VISIBLE
+            if (isAttachedToWindow) handler.postDelayed(this, 1000)
         }
     }
 

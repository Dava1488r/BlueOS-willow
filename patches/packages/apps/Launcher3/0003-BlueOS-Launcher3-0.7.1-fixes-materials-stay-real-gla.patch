+    /** One status: from the phrases of the time of day (changes every 20 min), or the three fixed ones. */
+    private fun phrase(asleep: Boolean, playing: Boolean): Pair<String, String> {
+        if (!K.on(cr, K.ARONA_WIDGET_PHRASES)) return when {
+            asleep -> context.getString(R.string.blueos_arona_sleeping) to context.getString(R.string.blueos_arona_shh)
+            playing -> context.getString(R.string.blueos_arona_listening) to ""
+            else -> context.getString(R.string.blueos_arona_waiting) to context.getString(R.string.blueos_arona_pat_me)
+        }
+        val c = Calendar.getInstance()
+        val h = c.get(Calendar.HOUR_OF_DAY)
+        val pool = when {
+            asleep -> R.array.blueos_arona_phr_night
+            playing -> R.array.blueos_arona_phr_music
+            h in 7..10 -> R.array.blueos_arona_phr_morning
+            h in 11..17 -> R.array.blueos_arona_phr_day
+            else -> R.array.blueos_arona_phr_evening
+        }
+        val all = resources.getStringArray(pool)
+        val line = all[(h * 3 + c.get(Calendar.MINUTE) / 20) % all.size].split('|')
+        return line[0] to line.getOrElse(1) { "" }
+    }

     override fun createView(context: Context, info: LauncherAppWidgetProviderInfo): AppWidgetHostView =
         BlueOSAronaWidgetView(context)
+
+    /**
+     * 0.8: the picker's preview — the chosen one (Arona or Plana) in her idle pose on the card, her name and a line
+     * of the time of day. Her model loads on its own thread; until then (≤ 5 s) this waits.
+     */
+    override fun preview(context: Context, width: Int, height: Int): android.graphics.Bitmap? {
+        val cr = context.contentResolver
+        val dp = context.resources.displayMetrics.density
+        val arona = BlueOSWidgetPreview.onMain {
+            AronaView(context).apply { character = Character.current(cr); viewport = character.upperBody }
+        } ?: return null
+        repeat(50) {
+            val bmp = BlueOSWidgetPreview.onMain<android.graphics.Bitmap> {
+                if (!arona.still()) return@onMain null
+                val root = FrameLayout(context).apply { val m = (8 * dp).toInt(); setPadding(m, m, m, m) }
+                val card = FrameLayout(context).apply { background = BlueOSWidgetPreview.card(context) }
+                root.addView(card, FrameLayout.LayoutParams(-1, -1))
+                val ch = height - (16 * dp).toInt()
+                val vp = arona.viewport
+                val ah = (ch * 0.96f).toInt()
+                val aw = (ah * vp.w / vp.h).toInt()
+                card.addView(arona, FrameLayout.LayoutParams(aw, ah, Gravity.END or Gravity.BOTTOM).apply { marginEnd = (6 * dp).toInt() })
+                fun text(sp: Float, bold: Boolean, color: Int) = TextView(context).apply {
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, sp)
+                    typeface = Typeface.create(if (bold) "google-sans-text-medium" else "google-sans-text", if (bold) Typeface.BOLD else Typeface.NORMAL)
+                    maxLines = 2
+                    ellipsize = android.text.TextUtils.TruncateAt.END
+                    setTextColor(color)
+                }
+                val plana = arona.character == Character.PLANA
+                val h = Calendar.getInstance().get(Calendar.HOUR_OF_DAY)
+                val pool = when {
+                    h in 7..10 -> if (plana) R.array.blueos_plana_phr_morning else R.array.blueos_arona_phr_morning
+                    h in 11..17 -> if (plana) R.array.blueos_plana_phr_day else R.array.blueos_arona_phr_day
+                    else -> if (plana) R.array.blueos_plana_phr_evening else R.array.blueos_arona_phr_evening
+                }
+                val line = context.resources.getStringArray(pool).firstOrNull()?.split('|').orEmpty()
+                val texts = LinearLayout(context).apply {
+                    orientation = LinearLayout.VERTICAL
+                    gravity = Gravity.CENTER_VERTICAL
+                    addView(text(12f, false, BlueOSColors.primary(context)).apply {
+                        setText(if (plana) R.string.blueos_widget_plana else R.string.blueos_widget_arona)
+                    })
+                    addView(text(17f, true, BlueOSColors.onSurface(context)).apply { text = line.getOrElse(0) { "" } })
+                    addView(text(12f, false, BlueOSColors.onSurfaceVariant(context)).apply { text = line.getOrElse(1) { "" } })
+                }
+                val tw = (width - (16 * dp).toInt() - aw - (28 * dp).toInt()).coerceAtLeast(0)
+                card.addView(texts, FrameLayout.LayoutParams(tw, -1).apply { marginStart = (16 * dp).toInt() })
+                BlueOSWidgetPreview.draw(root, width, height)
+            }
+            if (bmp != null) return bmp
+            Thread.sleep(100)
+        }
+        return null
+    }
 }
 

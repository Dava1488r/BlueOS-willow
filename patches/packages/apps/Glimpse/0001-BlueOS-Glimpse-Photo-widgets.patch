+/*
+ * SPDX-FileCopyrightText: 2026 BlueOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.glimpse.widgets
+
+import android.app.PendingIntent
+import android.appwidget.AppWidgetManager
+import android.appwidget.AppWidgetProvider
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.widget.RemoteViews
+import java.io.File
+import org.lineageos.glimpse.MainActivity
+import org.lineageos.glimpse.R
+
+/**
+ * BlueOS photo widget: one picture the user picked, rounded, round with an accent ring, or a
+ * sticker as is. The four providers only differ in the size they start at; all resize freely.
+ * The picture is a copy in our files, served to the launcher by [BlueOSPhotoProvider].
+ */
+open class BlueOSPhotoWidgetProvider : AppWidgetProvider() {
+    class Small : BlueOSPhotoWidgetProvider()
+
+    class Square : BlueOSPhotoWidgetProvider()
+
+    class Portrait : BlueOSPhotoWidgetProvider()
+
+    class Wide : BlueOSPhotoWidgetProvider()
+
+    override fun onUpdate(context: Context, wm: AppWidgetManager, widgetIds: IntArray) {
+        widgetIds.forEach { update(context, wm, it) }
+    }
+
+    override fun onDeleted(context: Context, widgetIds: IntArray) {
+        widgetIds.forEach { id ->
+            photoFile(context, id)?.delete()
+            prefs(context).edit().remove(keyFile(id)).remove(keyShape(id)).apply()
+        }
+    }
+
+    enum class Shape(val layout: Int) {
+        ROUNDED(R.layout.blueos_photo_widget_rounded),
+        CIRCLE(R.layout.blueos_photo_widget_circle),
+        STICKER(R.layout.blueos_photo_widget_sticker),
+    }
+
+    companion object {
+        private const val PREFS = "blueos_photo_widgets"
+
+        fun prefs(context: Context) = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+        fun keyFile(id: Int) = "file_$id"
+
+        fun keyShape(id: Int) = "shape_$id"
+
+        fun photosDir(context: Context) = File(context.filesDir, "widget_photos").apply { mkdirs() }
+
+        fun photoFile(context: Context, id: Int): File? =
+            prefs(context).getString(keyFile(id), null)?.let { File(photosDir(context), it) }
+
+        fun shape(context: Context, id: Int): Shape =
+            runCatching { Shape.valueOf(prefs(context).getString(keyShape(id), null)!!) }
+                .getOrDefault(Shape.ROUNDED)
+
+        fun update(context: Context, wm: AppWidgetManager, id: Int) {
+            val rv = RemoteViews(context.packageName, shape(context, id).layout)
+            val file = photoFile(context, id)
+            if (file != null && file.exists()) {
+                rv.setImageViewUri(R.id.blueos_photo, BlueOSPhotoProvider.uriFor(file.name))
+                // Tap opens the gallery
+                rv.setOnClickPendingIntent(
+                    android.R.id.background,
+                    PendingIntent.getActivity(
+                        context,
+                        0,
+                        Intent(context, MainActivity::class.java),
+                        PendingIntent.FLAG_IMMUTABLE,
+                    ),
+                )
+            } else {
+                // Not set up: tap opens the setup
+                rv.setImageViewResource(R.id.blueos_photo, R.drawable.blueos_ic_photo_placeholder)
+                rv.setOnClickPendingIntent(
+                    android.R.id.background,
+                    PendingIntent.getActivity(
+                        context,
+                        id,
+                        Intent(context, BlueOSPhotoConfigActivity::class.java)
+                            .setAction(AppWidgetManager.ACTION_APPWIDGET_CONFIGURE)
+                            .putExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, id)
+                            .setData(Uri.parse("blueos-photo-widget:$id")),
+                        PendingIntent.FLAG_IMMUTABLE,
+                    ),
+                )
+            }
+            wm.updateAppWidget(id, rv)
+        }
+    }
+}

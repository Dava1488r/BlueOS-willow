+++ b/app/src/main/java/org/lineageos/glimpse/widgets/BlueOSPhotoConfigActivity.kt
@@ -0,0 +1,243 @@
+/*
+ * SPDX-FileCopyrightText: 2026 BlueOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.glimpse.widgets
+
+import android.appwidget.AppWidgetManager
+import android.content.Intent
+import android.graphics.Bitmap
+import android.graphics.BitmapShader
+import android.graphics.Canvas
+import android.graphics.ImageDecoder
+import android.graphics.Outline
+import android.graphics.Paint
+import android.graphics.Shader
+import android.net.Uri
+import android.os.Bundle
+import android.view.View
+import android.view.ViewOutlineProvider
+import android.widget.Button
+import android.widget.ImageView
+import android.widget.Toast
+import androidx.activity.result.PickVisualMediaRequest
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.appcompat.app.AppCompatActivity
+import androidx.lifecycle.lifecycleScope
+import com.google.android.material.button.MaterialButtonToggleGroup
+import java.io.File
+import java.util.UUID
+import kotlin.math.max
+import kotlin.math.min
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import org.lineageos.glimpse.R
+import org.lineageos.glimpse.widgets.BlueOSPhotoWidgetProvider.Shape
+
+/**
+ * BlueOS photo widget setup: the system photo picker opens right away, then the user picks the
+ * shape. The picture is copied into our files (scaled down; cut round for the circle).
+ */
+class BlueOSPhotoConfigActivity : AppCompatActivity() {
+    private var widgetId = AppWidgetManager.INVALID_APPWIDGET_ID
+    private var picked: Bitmap? = null
+    private var shape = Shape.ROUNDED
+
+    private lateinit var preview: ImageView
+    private lateinit var previewRing: ImageView
+
+    private val pickPhoto =
+        registerForActivityResult(ActivityResultContracts.PickVisualMedia()) { uri ->
+            if (uri != null) {
+                load(uri)
+            } else if (picked == null) {
+                // Nothing picked and nothing to keep: no widget
+                finish()
+            }
+        }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setResult(RESULT_CANCELED)
+        widgetId =
+            intent.getIntExtra(
+                AppWidgetManager.EXTRA_APPWIDGET_ID,
+                AppWidgetManager.INVALID_APPWIDGET_ID,
+            )
+        if (widgetId == AppWidgetManager.INVALID_APPWIDGET_ID) {
+            finish()
+            return
+        }
+        setContentView(R.layout.blueos_photo_config)
+        preview = findViewById(R.id.blueos_photo_preview)
+        previewRing = findViewById(R.id.blueos_photo_preview_ring)
+        preview.clipToOutline = true
+
+        shape = BlueOSPhotoWidgetProvider.shape(this, widgetId)
+        val shapes = findViewById<MaterialButtonToggleGroup>(R.id.blueos_photo_shape)
+        shapes.check(
+            when (shape) {
+                Shape.ROUNDED -> R.id.blueos_photo_shape_rounded
+                Shape.CIRCLE -> R.id.blueos_photo_shape_circle
+                Shape.STICKER -> R.id.blueos_photo_shape_sticker
+            }
+        )
+        shapes.addOnButtonCheckedListener { _, checkedId, isChecked ->
+            if (!isChecked) return@addOnButtonCheckedListener
+            shape =
+                when (checkedId) {
+                    R.id.blueos_photo_shape_circle -> Shape.CIRCLE
+                    R.id.blueos_photo_shape_sticker -> Shape.STICKER
+                    else -> Shape.ROUNDED
+                }
+            showPreview()
+        }
+        findViewById<Button>(R.id.blueos_photo_change).setOnClickListener { pick() }
+        findViewById<Button>(R.id.blueos_photo_done).setOnClickListener { save() }
+
+        // Reconfiguring starts from the current picture; a new widget starts with the picker
+        val existing = BlueOSPhotoWidgetProvider.photoFile(this, widgetId)
+        if (existing != null && existing.exists()) {
+            lifecycleScope.launch {
+                picked =
+                    withContext(Dispatchers.IO) {
+                        runCatching { decode(ImageDecoder.createSource(existing)) }.getOrNull()
+                    }
+                showPreview()
+            }
+        } else if (savedInstanceState == null) {
+            pick()
+        }
+    }
+
+    private fun pick() {
+        pickPhoto.launch(PickVisualMediaRequest(ActivityResultContracts.PickVisualMedia.ImageOnly))
+    }
+
+    private fun load(uri: Uri) {
+        lifecycleScope.launch {
+            val bitmap =
+                withContext(Dispatchers.IO) {
+                    runCatching { decode(ImageDecoder.createSource(contentResolver, uri)) }
+                        .getOrNull()
+                }
+            if (bitmap == null) {
+                Toast.makeText(this@BlueOSPhotoConfigActivity, R.string.blueos_photo_error, Toast.LENGTH_SHORT)
+                    .show()
+                if (picked == null) finish()
+                return@launch
+            }
+            picked = bitmap
+            showPreview()
+        }
+    }
+
+    /** Decoded small enough for a widget (the launcher decodes it again on its main thread). */
+    private fun decode(source: ImageDecoder.Source): Bitmap =
+        ImageDecoder.decodeBitmap(source) { decoder, info, _ ->
+            val longest = max(info.size.width, info.size.height)
+            if (longest > MAX_SIZE_PX) {
+                val scale = MAX_SIZE_PX.toFloat() / longest
+                decoder.setTargetSize(
+                    (info.size.width * scale).toInt().coerceAtLeast(1),
+                    (info.size.height * scale).toInt().coerceAtLeast(1),
+                )
+            }
+            decoder.allocator = ImageDecoder.ALLOCATOR_SOFTWARE
+        }
+
+    private fun showPreview() {
+        val bitmap = picked ?: return
+        val radius = resources.getDimension(android.R.dimen.system_app_widget_background_radius)
+        when (shape) {
+            Shape.ROUNDED -> {
+                preview.scaleType = ImageView.ScaleType.CENTER_CROP
+                preview.setImageBitmap(bitmap)
+                preview.outlineProvider =
+                    object : ViewOutlineProvider() {
+                        override fun getOutline(view: View, outline: Outline) {
+                            outline.setRoundRect(0, 0, view.width, view.height, radius)
+                        }
+                    }
+            }
+            Shape.CIRCLE -> {
+                preview.scaleType = ImageView.ScaleType.FIT_CENTER
+                preview.setImageBitmap(circle(bitmap))
+                preview.outlineProvider = ViewOutlineProvider.BACKGROUND
+            }
+            Shape.STICKER -> {
+                preview.scaleType = ImageView.ScaleType.FIT_CENTER
+                preview.setImageBitmap(bitmap)
+                preview.outlineProvider = ViewOutlineProvider.BACKGROUND
+            }
+        }
+        preview.invalidateOutline()
+        previewRing.visibility = if (shape == Shape.CIRCLE) View.VISIBLE else View.GONE
+    }
+
+    /** The middle square cut round, transparent around. */
+    private fun circle(source: Bitmap): Bitmap {
+        val size = min(source.width, source.height)
+        val out = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
+        val paint =
+            Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                shader =
+                    BitmapShader(source, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP).apply {
+                        setLocalMatrix(
+                            android.graphics.Matrix().apply {
+                                setTranslate(
+                                    -(source.width - size) / 2f,
+                                    -(source.height - size) / 2f,
+                                )
+                            }
+                        )
+                    }
+            }
+        Canvas(out).drawCircle(size / 2f, size / 2f, size / 2f, paint)
+        return out
+    }
+
+    private fun save() {
+        val bitmap = picked ?: return pick()
+        val chosenShape = shape
+        lifecycleScope.launch {
+            val app = applicationContext
+            withContext(Dispatchers.IO) {
+                val image = if (chosenShape == Shape.CIRCLE) circle(bitmap) else bitmap
+                // PNG keeps transparency (stickers, the circle); photos are smaller as JPEG
+                val png = chosenShape != Shape.ROUNDED && image.hasAlpha() ||
+                    chosenShape == Shape.CIRCLE
+                val file = File(
+                    BlueOSPhotoWidgetProvider.photosDir(app),
+                    "${UUID.randomUUID()}.${if (png) "png" else "jpg"}",
+                )
+                file.outputStream().use {
+                    image.compress(
+                        if (png) Bitmap.CompressFormat.PNG else Bitmap.CompressFormat.JPEG,
+                        92,
+                        it,
+                    )
+                }
+                // A new name each time: the launcher never shows a cached old picture
+                BlueOSPhotoWidgetProvider.photoFile(app, widgetId)?.delete()
+                BlueOSPhotoWidgetProvider.prefs(app)
+                    .edit()
+                    .putString(BlueOSPhotoWidgetProvider.keyFile(widgetId), file.name)
+                    .putString(BlueOSPhotoWidgetProvider.keyShape(widgetId), chosenShape.name)
+                    .commit()
+            }
+            BlueOSPhotoWidgetProvider.update(app, AppWidgetManager.getInstance(app), widgetId)
+            setResult(
+                RESULT_OK,
+                Intent().putExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, widgetId),
+            )
+            finish()
+        }
+    }
+
+    private companion object {
+        const val MAX_SIZE_PX = 1440
+    }
+}

@@ -0,0 +1,66 @@
+/*
+ * SPDX-FileCopyrightText: 2026 BlueOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.glimpse.widgets
+
+import android.content.ContentProvider
+import android.content.ContentValues
+import android.database.Cursor
+import android.net.Uri
+import android.os.ParcelFileDescriptor
+import java.io.File
+import java.io.FileNotFoundException
+
+/**
+ * Serves the photo widgets' pictures to the launcher, read-only. The launcher loads them itself,
+ * so this is exported; the file names are random UUIDs and nothing can be listed or written.
+ */
+class BlueOSPhotoProvider : ContentProvider() {
+    override fun onCreate() = true
+
+    override fun openFile(uri: Uri, mode: String): ParcelFileDescriptor {
+        if (mode != "r") throw SecurityException("Read only")
+        val name = uri.lastPathSegment
+        if (uri.pathSegments.size != 1 || name == null || !NAME.matches(name)) {
+            throw FileNotFoundException(uri.toString())
+        }
+        val file = File(BlueOSPhotoWidgetProvider.photosDir(context!!), name)
+        if (!file.exists()) throw FileNotFoundException(uri.toString())
+        return ParcelFileDescriptor.open(file, ParcelFileDescriptor.MODE_READ_ONLY)
+    }
+
+    override fun getType(uri: Uri): String? =
+        when (uri.lastPathSegment?.substringAfterLast('.')) {
+            "png" -> "image/png"
+            "jpg" -> "image/jpeg"
+            else -> null
+        }
+
+    override fun query(
+        uri: Uri,
+        projection: Array<out String>?,
+        selection: String?,
+        selectionArgs: Array<out String>?,
+        sortOrder: String?,
+    ): Cursor? = null
+
+    override fun insert(uri: Uri, values: ContentValues?): Uri? = null
+
+    override fun delete(uri: Uri, selection: String?, selectionArgs: Array<out String>?) = 0
+
+    override fun update(
+        uri: Uri,
+        values: ContentValues?,
+        selection: String?,
+        selectionArgs: Array<out String>?,
+    ) = 0
+
+    companion object {
+        private const val AUTHORITY = "org.lineageos.glimpse.blueos.widgetphotos"
+        private val NAME = Regex("[0-9a-f-]{36}\\.(png|jpg)")
+
+        fun uriFor(name: String): Uri = Uri.parse("content://$AUTHORITY/$name")
+    }
+}
diff --git a/app/src/main/java/org/lineageos/glimpse/widgets/BlueOSPhotoWidgetProvider.kt b/app/src/main/java/org/lineageos/glimpse/widgets/BlueOSPhotoWidgetProvider.kt

+++ b/app/src/main/java/org/lineageos/setupwizard/WelcomeActivity.kt
@@ -18,13 +18,17 @@ import android.widget.ImageView
 import android.widget.TextView
 import androidx.activity.OnBackPressedCallback
 import androidx.core.view.updateLayoutParams
+import com.android.internal.app.LocaleHelper
+import com.android.internal.app.LocalePicker
 import com.google.android.material.button.MaterialButton
 import com.google.android.setupcompat.util.SystemBarHelper
 import com.google.android.setupdesign.R as SudR
 import com.google.android.setupdesign.template.FloatingActionButtonMixin
 import com.google.android.setupdesign.template.FloatingBackButtonMixin
+import java.util.Locale
 import org.lineageos.setupwizard.base.GlifTemplate
 import org.lineageos.setupwizard.base.SubBaseActivity
+import org.lineageos.setupwizard.locale.LocaleActivity
 import org.lineageos.setupwizard.system.DeviceInfoActivity
 import org.lineageos.setupwizard.util.SetupWizardUtils
 
@@ -73,6 +77,19 @@ class WelcomeActivity : SubBaseActivity() {
                 SystemProperties.get(BLUEOS_VERSION_PROP),
                 Build.VERSION.RELEASE_OR_CODENAME,
             )
+        setupLanguageButton()
+    }
+
+    // The activity is recreated after a language change, so the label stays current
+    private fun setupLanguageButton() {
+        val button = findViewById<MaterialButton>(R.id.blueos_language) ?: return
+        val locale = Locale.getDefault()
+        button.text = LocaleHelper.getDisplayName(locale, locale, true)
+        button.contentDescription =
+            getString(R.string.blueos_welcome_language_description, button.text)
+        button.setOnClickListener {
+            startActivity(Intent(this, BlueOSLocalePickerActivity::class.java))
+        }
     }
 
     override fun onResume() {
@@ -171,3 +188,13 @@ class WelcomeActivity : SubBaseActivity() {
         private const val BLUEOS_VERSION_PROP = "ro.blueos.version"
     }
 }
+
+/** BlueOS: language list opened from the welcome screen; goes back instead of advancing. */
+class BlueOSLocalePickerActivity : LocaleActivity() {
+
+    override fun applyLocale(locale: Locale) {
+        LocalePicker.updateLocale(locale)
+        setResult(RESULT_OK)
+        finish()
+    }
+}

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GDmio <zhalin66@gmail.com>
Date: Sat, 24 Oct 2026 17:47:11 +0200
Subject: [PATCH 3/5] BlueOS: SetupWizard: Halo welcome screen

Animated logo (the halo falls in and keeps bobbing), "Welcome, Sensei"
and the BlueOS / Android version. Drawables are generated by
vendor/blueos/tools/make-logo-assets.py.

Change-Id: I91648fe961371cad87810bf1b16e1f678c3a867f
---
 .../lineageos/setupwizard/WelcomeActivity.kt  | 20 +++++++++-
 app/src/main/res/drawable-night/logo_halo.xml | 29 ++++++++++++++
 app/src/main/res/drawable/logo_halo.xml       | 29 ++++++++++++++
 app/src/main/res/drawable/logo_halo_anim.xml  | 40 +++++++++++++++++++
 .../res/layout-w600dp/welcome_activity.xml    | 11 ++++-
 app/src/main/res/layout/welcome_activity.xml  | 20 ++++++++--
 app/src/main/res/values-ru/blueos_welcome.xml |  4 ++
 app/src/main/res/values/blueos_welcome.xml    | 12 ++++++
 8 files changed, 158 insertions(+), 7 deletions(-)
 create mode 100644 app/src/main/res/drawable-night/logo_halo.xml
 create mode 100644 app/src/main/res/drawable/logo_halo.xml
 create mode 100644 app/src/main/res/drawable/logo_halo_anim.xml
 create mode 100644 app/src/main/res/values-ru/blueos_welcome.xml
 create mode 100644 app/src/main/res/values/blueos_welcome.xml

diff --git a/app/src/main/java/org/lineageos/setupwizard/WelcomeActivity.kt b/app/src/main/java/org/lineageos/setupwizard/WelcomeActivity.kt
index 9b80d62..c9acefd 100644
--- a/app/src/main/java/org/lineageos/setupwizard/WelcomeActivity.kt
+++ b/app/src/main/java/org/lineageos/setupwizard/WelcomeActivity.kt
@@ -6,12 +6,15 @@
 package org.lineageos.setupwizard
 
 import android.content.Intent
+import android.graphics.drawable.Animatable
 import android.os.Build
 import android.os.Bundle
+import android.os.SystemProperties
 import android.util.TypedValue
 import android.view.View
 import android.view.ViewGroup
 import android.view.ViewGroup.MarginLayoutParams
+import android.widget.ImageView
 import android.widget.TextView
 import androidx.activity.OnBackPressedCallback
 import androidx.core.view.updateLayoutParams
@@ -62,8 +65,22 @@ class WelcomeActivity : SubBaseActivity() {
             if (SetupWizardUtils.isManagedProfile(this)) {
                 getString(R.string.setup_managed_profile_welcome_message)
             } else {
-                getString(R.string.setup_welcome_message, getString(R.string.os_name))
+                getString(R.string.blueos_welcome_title)
             }
+        findViewById<TextView>(R.id.welcome_subtitle)?.text =
+            getString(
+                R.string.blueos_welcome_subtitle,
+                SystemProperties.get(BLUEOS_VERSION_PROP),
+                Build.VERSION.RELEASE_OR_CODENAME,
+            )
+    }
+
+    override fun onResume() {
+        super.onResume()
+        // Falling halo; the animator duration scale (and "remove animations") applies
+        (findViewById<ImageView>(R.id.brand_logo)?.drawable as? Animatable)?.let {
+            if (!it.isRunning) it.start()
+        }
     }
 
     private fun MaterialButton.applyChipStyle(label: CharSequence) {
@@ -151,5 +168,6 @@ class WelcomeActivity : SubBaseActivity() {
     companion object {
         private const val ACTION_ACCESSIBILITY_SETTINGS =
             "android.settings.ACCESSIBILITY_SETTINGS_FOR_SUW"
+        private const val BLUEOS_VERSION_PROP = "ro.blueos.version"
     }
 }

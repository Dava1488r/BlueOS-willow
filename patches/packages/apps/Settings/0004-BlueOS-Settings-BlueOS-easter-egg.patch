+package com.android.settings.deviceinfo.firmwareversion;
+
+import android.animation.ValueAnimator;
+import android.app.Activity;
+import android.content.Context;
+import android.content.res.Configuration;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.graphics.drawable.Animatable;
+import android.os.Bundle;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.animation.DecelerateInterpolator;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import com.android.settings.R;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+
+/**
+ * BlueOS easter egg (several taps on the BlueOS version in About phone): the logo with the
+ * falling halo, a greeting, and every tap on the screen sends a halo flying up.
+ * Always dark, in the system (Monet) accent colors.
+ */
+public class BlueOSEasterEggActivity extends Activity {
+
+    @Override
+    protected void attachBaseContext(Context newBase) {
+        super.attachBaseContext(newBase);
+        // dark variant of the logo whatever the system theme is
+        final Configuration night = new Configuration();
+        night.uiMode = (newBase.getResources().getConfiguration().uiMode
+                & ~Configuration.UI_MODE_NIGHT_MASK) | Configuration.UI_MODE_NIGHT_YES;
+        applyOverrideConfiguration(night);
+    }
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+
+        final FrameLayout root = new FrameLayout(this);
+        root.setBackgroundColor(getColor(android.R.color.system_neutral1_900));
+        final HaloView halos = new HaloView(this);
+        root.addView(halos, new FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+
+        final LinearLayout column = new LinearLayout(this);
+        column.setOrientation(LinearLayout.VERTICAL);
+        column.setGravity(Gravity.CENTER_HORIZONTAL);
+        final int pad = dp(32);
+        column.setPadding(pad, 0, pad, 0);
+
+        final ImageView logo = new ImageView(this);
+        logo.setImageResource(R.drawable.blueos_logo_halo_anim);
+        logo.setAdjustViewBounds(true);
+        logo.setContentDescription(getString(R.string.blueos_easter_egg_title));
+        column.addView(logo, new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.WRAP_CONTENT, dp(120)));
+
+        final TextView title = new TextView(this);
+        title.setText(R.string.blueos_easter_egg_title);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 24);
+        title.setTextColor(getColor(android.R.color.system_neutral1_50));
+        title.setGravity(Gravity.CENTER);
+        final LinearLayout.LayoutParams titleLp = new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        titleLp.topMargin = dp(32);
+        column.addView(title, titleLp);
+
+        final TextView hint = new TextView(this);
+        hint.setText(R.string.blueos_easter_egg_hint);
+        hint.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        hint.setTextColor(getColor(android.R.color.system_neutral2_300));
+        hint.setGravity(Gravity.CENTER);
+        final LinearLayout.LayoutParams hintLp = new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        hintLp.topMargin = dp(8);
+        column.addView(hint, hintLp);
+
+        root.addView(column, new FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT,
+                Gravity.CENTER));
+        setContentView(root);
+
+        if (logo.getDrawable() instanceof Animatable) {
+            ((Animatable) logo.getDrawable()).start();
+        }
+    }
+
+    private int dp(int value) {
+        return Math.round(value * getResources().getDisplayMetrics().density);
+    }
+
+    /** Halos flying up from wherever the screen is touched. */
+    private static class HaloView extends View {
+        private static final long DURATION_MS = 1400;
+
+        private final List<float[]> mHalos = new ArrayList<>(); // x, y, angle, progress
+        private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF mOval = new RectF();
+        private final Random mRandom = new Random();
+        private final float mDensity;
+
+        HaloView(Context context) {
+            super(context);
+            mDensity = context.getResources().getDisplayMetrics().density;
+            mPaint.setStyle(Paint.Style.STROKE);
+            mPaint.setStrokeWidth(4 * mDensity);
+            mPaint.setColor(context.getColor(android.R.color.system_accent1_200));
+        }
+
+        @Override
+        public boolean onTouchEvent(MotionEvent event) {
+            if (event.getActionMasked() == MotionEvent.ACTION_DOWN) {
+                spawn(event.getX(), event.getY());
+                performClick();
+            }
+            return true;
+        }
+
+        @Override
+        public boolean performClick() {
+            return super.performClick();
+        }
+
+        private void spawn(float x, float y) {
+            final float[] halo = {x, y, mRandom.nextFloat() * 40 - 20, 0};
+            mHalos.add(halo);
+            final ValueAnimator anim = ValueAnimator.ofFloat(0, 1);
+            anim.setDuration(DURATION_MS);
+            anim.setInterpolator(new DecelerateInterpolator());
+            anim.addUpdateListener(a -> {
+                halo[3] = (float) a.getAnimatedValue();
+                invalidate();
+            });
+            anim.addListener(new android.animation.AnimatorListenerAdapter() {
+                @Override
+                public void onAnimationEnd(android.animation.Animator animation) {
+                    mHalos.remove(halo);
+                    invalidate();
+                }
+            });
+            anim.start();
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            final float rx = 28 * mDensity, ry = 8 * mDensity;
+            for (float[] halo : mHalos) {
+                final float p = halo[3];
+                final float y = halo[1] - p * 220 * mDensity;
+                canvas.save();
+                canvas.rotate(halo[2] * (1 + p), halo[0], y);
+                mPaint.setAlpha(Math.round(255 * (1 - p)));
+                mOval.set(halo[0] - rx, y - ry, halo[0] + rx, y + ry);
+                canvas.drawOval(mOval, mPaint);
+                canvas.restore();
+            }
+        }
+    }
+}

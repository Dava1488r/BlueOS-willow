+++ b/src/com/android/settings/deviceinfo/aboutphone/MyDeviceInfoFragment.java
@@ -23,9 +23,12 @@ import android.app.settings.SettingsEnums;
 import android.content.Context;
 import android.content.Intent;
 import android.content.pm.UserInfo;
+import android.os.Build;
 import android.os.Bundle;
+import android.os.SystemProperties;
 import android.os.UserManager;
 import android.view.View;
+import android.widget.TextView;
 
 import androidx.annotation.NonNull;
 import androidx.annotation.Nullable;
@@ -204,6 +207,20 @@ public class MyDeviceInfoFragment extends DashboardFragment
     }
 
     private void initHeader() {
+        // BlueOS: the header shows the BlueOS logo and version instead of the user's name
+        final LayoutPreference blueosHeader =
+                getPreferenceScreen().findPreference(KEY_MY_DEVICE_INFO_HEADER);
+        if (blueosHeader != null) {
+            blueosHeader.setVisible(true);
+            final TextView version = blueosHeader.findViewById(R.id.blueos_version);
+            if (version != null) {
+                version.setText(getString(R.string.blueos_about_header_version,
+                        SystemProperties.get("ro.blueos.version", "?"),
+                        Build.VERSION.RELEASE_OR_PREVIEW_DISPLAY));
+            }
+            return;
+        }
+
         // TODO: Migrate into its own controller.
         final LayoutPreference headerPreference =
                 getPreferenceScreen().findPreference(KEY_MY_DEVICE_INFO_HEADER);

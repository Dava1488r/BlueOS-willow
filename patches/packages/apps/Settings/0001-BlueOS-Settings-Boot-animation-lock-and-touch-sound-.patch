new file mode 100644
index 00000000000..2ec31fcd422
--- /dev/null
+++ b/src/com/android/settings/notification/BlueOSTouchSoundPreferenceController.java
@@ -0,0 +1,73 @@
+/*
+ * SPDX-FileCopyrightText: BlueOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.notification;
+
+import android.content.Context;
+import android.media.AudioManager;
+import android.provider.Settings;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.core.BasePreferenceController;
+import com.android.settingslib.utils.ThreadUtils;
+
+/**
+ * BlueOS: touch sound. Writes Settings.Global blueos_touch_sound (a file path, or "android"
+ * for the stock tick), read by the audio service when it loads the sound effects.
+ */
+public class BlueOSTouchSoundPreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+
+    private static final String SETTING = "blueos_touch_sound";
+    private static final String DEFAULT_SOUND = "/product/media/audio/ui/BlueOS_Touch.ogg";
+    private static final String STOCK = "android";
+    private static final String STOCK_SOUND = "/product/media/audio/ui/Effect_Tick.ogg";
+
+    public BlueOSTouchSoundPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        final Preference preference = screen.findPreference(getPreferenceKey());
+        if (preference != null) {
+            preference.setOnPreferenceChangeListener(this);
+        }
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        final ListPreference list = (ListPreference) preference;
+        final String value = Settings.Global.getString(mContext.getContentResolver(), SETTING);
+        list.setValue(value != null ? value : DEFAULT_SOUND);
+        list.setSummary(list.getEntry());
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        final String value = (String) newValue;
+        Settings.Global.putString(mContext.getContentResolver(), SETTING, value);
+        final ListPreference list = (ListPreference) preference;
+        final int index = list.findIndexOfValue(value);
+        list.setSummary(index >= 0 ? list.getEntries()[index] : null);
+        BlueOSSoundPreview.play(STOCK.equals(value) ? STOCK_SOUND : value);
+        // The audio service picks the file when loading effects, so reload them.
+        final AudioManager audioManager = mContext.getSystemService(AudioManager.class);
+        ThreadUtils.postOnBackgroundThread(() -> {
+            audioManager.unloadSoundEffects();
+            audioManager.loadSoundEffects();
+        });
+        return true;
+    }
+}

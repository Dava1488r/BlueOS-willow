--- /dev/null
+++ b/src/com/android/settings/notification/BlueOSLockSoundPreferenceController.java
@@ -0,0 +1,84 @@
+/*
+ * SPDX-FileCopyrightText: BlueOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.notification;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.provider.Settings;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * BlueOS: screen lock / unlock sound pack.
+ * Writes Settings.Global LOCK_SOUND and UNLOCK_SOUND; SystemUI reloads them on change.
+ */
+public class BlueOSLockSoundPreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+
+    private static final String UI_DIR = "/product/media/audio/ui/";
+    private static final String LOCK_PREFIX = UI_DIR + "BlueOS_Lock_";
+    private static final String UNLOCK_PREFIX = UI_DIR + "BlueOS_Unlock_";
+    private static final String STOCK = "android";
+
+    public BlueOSLockSoundPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        final Preference preference = screen.findPreference(getPreferenceKey());
+        if (preference != null) {
+            preference.setOnPreferenceChangeListener(this);
+        }
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        final ListPreference list = (ListPreference) preference;
+        list.setValue(getCurrentPack());
+        list.setSummary(list.getEntry());
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        final String pack = (String) newValue;
+        final ContentResolver cr = mContext.getContentResolver();
+        Settings.Global.putString(cr, Settings.Global.LOCK_SOUND, getLockPath(pack));
+        Settings.Global.putString(cr, Settings.Global.UNLOCK_SOUND, getUnlockPath(pack));
+        final ListPreference list = (ListPreference) preference;
+        final int index = list.findIndexOfValue(pack);
+        list.setSummary(index >= 0 ? list.getEntries()[index] : null);
+        BlueOSSoundPreview.play(getUnlockPath(pack));
+        return true;
+    }
+
+    private String getCurrentPack() {
+        final String lock = Settings.Global.getString(mContext.getContentResolver(),
+                Settings.Global.LOCK_SOUND);
+        if (lock != null && lock.startsWith(LOCK_PREFIX) && lock.endsWith(".ogg")) {
+            return lock.substring(LOCK_PREFIX.length(), lock.length() - ".ogg".length());
+        }
+        return STOCK;
+    }
+
+    private static String getLockPath(String pack) {
+        return STOCK.equals(pack) ? UI_DIR + "Lock.ogg" : LOCK_PREFIX + pack + ".ogg";
+    }
+
+    private static String getUnlockPath(String pack) {
+        return STOCK.equals(pack) ? UI_DIR + "Unlock.ogg" : UNLOCK_PREFIX + pack + ".ogg";
+    }
+}

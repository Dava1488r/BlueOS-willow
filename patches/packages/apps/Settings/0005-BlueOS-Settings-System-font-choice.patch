+/*
+ * SPDX-FileCopyrightText: BlueOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.display;
+
+import android.content.Context;
+import android.content.DialogInterface;
+import android.graphics.Typeface;
+import android.util.AttributeSet;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ArrayAdapter;
+import android.widget.TextView;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.appcompat.app.AlertDialog.Builder;
+
+import com.android.settings.CustomListPreference;
+
+/**
+ * BlueOS: font list where every font is shown in itself. The previews use the
+ * "blueos-<value>" families from /product/etc/blueos/fonts_customization_*.xml.
+ */
+public class BlueOSFontPreference extends CustomListPreference {
+
+    public BlueOSFontPreference(@NonNull Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+    }
+
+    @Override
+    protected void onPrepareDialogBuilder(Builder builder,
+            DialogInterface.OnClickListener listener) {
+        final CharSequence[] values = getEntryValues();
+        final ArrayAdapter<CharSequence> adapter = new ArrayAdapter<CharSequence>(
+                builder.getContext(), android.R.layout.simple_list_item_single_choice,
+                android.R.id.text1, getEntries()) {
+            @Override
+            public View getView(int position, View convertView, ViewGroup parent) {
+                final View view = super.getView(position, convertView, parent);
+                final TextView text = view.findViewById(android.R.id.text1);
+                text.setTypeface(Typeface.create("blueos-" + values[position], Typeface.NORMAL));
+                return view;
+            }
+        };
+        builder.setSingleChoiceItems(adapter, findIndexOfValue(getValue()), listener);
+    }
+}
diff --git a/src/com/android/settings/display/BlueOSFontPreferenceController.java b/src/com/android/settings/display/BlueOSFontPreferenceController.java
new file mode 100644
index 00000000000..56f20b20ff8
--- /dev/null
+++ b/src/com/android/settings/display/BlueOSFontPreferenceController.java
@@ -0,0 +1,80 @@
+/*
+ * SPDX-FileCopyrightText: BlueOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.display;
+
+import android.content.Context;
+import android.os.PowerManager;
+import android.os.SystemProperties;
+
+import androidx.appcompat.app.AlertDialog;
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * BlueOS: system font. Stored in persist.sys.blueos.font and loaded by SystemFonts
+ * (BlueOS patch in frameworks/base) at the next boot, so a reboot is offered.
+ */
+public class BlueOSFontPreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+
+    private static final String PROP_FONT = "persist.sys.blueos.font";
+    // keep in sync with SystemFonts and vendor/blueos/tools/make-fonts.py
+    private static final String DEFAULT_VALUE = "mplusrounded1c";
+
+    public BlueOSFontPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        final Preference preference = screen.findPreference(getPreferenceKey());
+        if (preference != null) {
+            preference.setOnPreferenceChangeListener(this);
+        }
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        final ListPreference list = (ListPreference) preference;
+        String value = SystemProperties.get(PROP_FONT, DEFAULT_VALUE);
+        if (list.findIndexOfValue(value) < 0) {
+            value = DEFAULT_VALUE;
+        }
+        list.setValue(value);
+        list.setSummary(list.getEntry());
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        final String value = (String) newValue;
+        if (value.equals(SystemProperties.get(PROP_FONT, DEFAULT_VALUE))) {
+            return true;
+        }
+        SystemProperties.set(PROP_FONT, value);
+        final ListPreference list = (ListPreference) preference;
+        final int index = list.findIndexOfValue(value);
+        list.setSummary(index >= 0 ? list.getEntries()[index] : null);
+
+        new AlertDialog.Builder(preference.getContext())
+                .setTitle(R.string.blueos_font_reboot_title)
+                .setMessage(R.string.blueos_font_reboot_message)
+                .setPositiveButton(R.string.blueos_font_reboot_now, (dialog, which) ->
+                        mContext.getSystemService(PowerManager.class).reboot(null))
+                .setNegativeButton(R.string.blueos_font_reboot_later, null)
+                .show();
+        return true;
+    }
+}

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GDmio <zhalin66@gmail.com>
Date: Tue, 3 Nov 2026 06:38:59 +0100
Subject: [PATCH 5/5] BlueOS: the shown version and the zip's name:
 BlueOS-<version>-<device>-<date>

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I5552f0d67e986efc829c7679e9175477bdc4e9d9
---
 build/tasks/bacon.mk | 4 ++++
 config/version.mk    | 5 +++++
 2 files changed, 9 insertions(+)

diff --git a/build/tasks/bacon.mk b/build/tasks/bacon.mk
index 272a4b8e..ea5e2e06 100644
--- a/build/tasks/bacon.mk
+++ b/build/tasks/bacon.mk
@@ -17,6 +17,10 @@
 # Lineage OTA update package
 
 LINEAGE_TARGET_PACKAGE := $(PRODUCT_OUT)/lineage-$(LINEAGE_VERSION).zip
+# BlueOS: the zip is named like the version in «About phone»
+ifneq ($(BLUEOS_VERSION),)
+    LINEAGE_TARGET_PACKAGE := $(PRODUCT_OUT)/$(LINEAGE_DISPLAY_VERSION).zip
+endif
 
 SHA256 := prebuilts/build-tools/path/$(HOST_PREBUILT_TAG)/sha256sum
 
diff --git a/config/version.mk b/config/version.mk
index bc3fc56b..87f988af 100644
--- a/config/version.mk
+++ b/config/version.mk
@@ -36,6 +36,11 @@ LINEAGE_VERSION := $(PRODUCT_VERSION_MAJOR).$(PRODUCT_VERSION_MINOR)-$(LINEAGE_V
 
 # Display version
 LINEAGE_DISPLAY_VERSION := $(PRODUCT_VERSION_MAJOR)-$(LINEAGE_VERSION_SUFFIX)
+# BlueOS: what people see, in «About phone» and as the zip's name: name, version, phone, build date
+# (LINEAGE_VERSION stays: the recovery reads the date out of it, the statistics report it)
+ifneq ($(BLUEOS_VERSION),)
+    LINEAGE_DISPLAY_VERSION := BlueOS-$(BLUEOS_VERSION)-$(LINEAGE_BUILD)-$(LINEAGE_BUILD_DATE)
+endif
 
 # LineageOS version properties
 PRODUCT_PRODUCT_PROPERTIES += \

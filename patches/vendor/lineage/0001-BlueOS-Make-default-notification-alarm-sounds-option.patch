From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BlueOS <blueos@localhost>
Date: Sat, 24 Oct 2026 03:52:56 +0200
Subject: [PATCH 1/5] BlueOS: Make default notification/alarm sounds optional

So a product (vendor/blueos) can set its own ro.config.* sounds without a duplicate sysprop error.

Change-Id: I3bd26b14c66613dfa107ad699c1b8a032e10e6e5
---
 config/common_mobile.mk | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/config/common_mobile.mk b/config/common_mobile.mk
index 83ad397c..7542ac4d 100644
--- a/config/common_mobile.mk
+++ b/config/common_mobile.mk
@@ -8,10 +8,10 @@ include vendor/lineage/config/aosp_audio.mk
 # Include Lineage audio files
 include vendor/lineage/config/lineage_audio.mk
 
-# Default notification/alarm sounds
+# Default notification/alarm sounds (optional, so a product can pick its own)
 PRODUCT_PRODUCT_PROPERTIES += \
-    ro.config.notification_sound=Argon.ogg \
-    ro.config.alarm_alert=Hassium.ogg
+    ro.config.notification_sound?=Argon.ogg \
+    ro.config.alarm_alert?=Hassium.ogg
 
 # Apps
 PRODUCT_PACKAGES += \

-// BlueOS Halo clock: the tilted halo of the BlueOS logo, drawn over the hours.
+// BlueOS Halo clock: the tilted halo of the BlueOS logo. Stacked clock (hours over minutes):
+// on top; one-line clock: over the minutes, the accent part, like over "OS" in the logo.
+// Halos never fly away - like in the game they just disappear and appear.
+
+/** A view that draws a halo; the lock screen fades it out on unlock (see setBlueOSHaloAlpha). */
+interface BlueOSHaloHost {
+    var blueOSHaloAlpha: Float
+}
+
+/** Sets the halo alpha of this view and of every halo view inside it. */
+fun View.setBlueOSHaloAlpha(alpha: Float) {
+    if (this is BlueOSHaloHost) blueOSHaloAlpha = alpha
+    if (this is ViewGroup) {
+        for (i in 0 until childCount) getChildAt(i).setBlueOSHaloAlpha(alpha)
+    }
+}
+
+/**
+ * How visible the halo of [view] is: its own alpha times the square of the alpha of the view and
+ * its parents. When a clock fades (the large <-> small clock switch moves it while fading), the
+ * halo is gone well before the digits instead of moving along, and appears last.
+ */
+internal fun haloVisibility(view: View, haloAlpha: Float): Float {
+    var alpha = 1f
+    var current: Any? = view
+    while (current is View) {
+        alpha *= current.alpha
+        current = current.parent
+    }
+    return (haloAlpha * alpha * alpha).coerceIn(0f, 1f)
+}
+
+/**
+ * Redraws a halo view when the alpha of its parents changes how visible the halo is: a new alpha
+ * alone doesn't redraw a view, so the halo would only fade together with the digits.
+ */
+internal fun View.redrawHaloWhenFading(visibility: () -> Float) {
+    var drawn = -1f
+    val listener =
+        ViewTreeObserver.OnPreDrawListener {
+            val now = visibility()
+            if (abs(now - drawn) > 0.01f) {
+                drawn = now
+                invalidate()
+            }
+            true
+        }
+    addOnAttachStateChangeListener(
+        object : View.OnAttachStateChangeListener {
+            override fun onViewAttachedToWindow(v: View) =
+                v.viewTreeObserver.addOnPreDrawListener(listener)
+
+            override fun onViewDetachedFromWindow(v: View) =
+                v.viewTreeObserver.removeOnPreDrawListener(listener)
+        }
+    )
+}
+
+internal fun withVisibility(color: Int, visibility: Float): Int =
+    Color.argb(
+        (Color.alpha(color) * visibility).toInt(),
+        Color.red(color),
+        Color.green(color),
+        Color.blue(color),
+    )
+
+/**
+ * Halo clock digit color. A clock color picked by the user is used in a tone that reads on the
+ * wallpaper under the clock (the stock clocks use the picked color as is, which can vanish on a
+ * light wallpaper).
+ */
+fun ThemeConfig.blueOSHaloDefaultColor(context: Context): Int {
+    val seed = seedColor ?: return getDefaultColor(context)
+    val palette = ColorScheme(seed, isDarkTheme).accent1
+    return if (isDarkTheme) palette.s100 else palette.s700
+}
 
 /** Horizontal radius of the halo, as a part of the width of the hours */
 internal const val HALO_RX_FRACTION = 0.3f

@@ -140,6 +140,15 @@ class FlexClockViewGroup(clockCtx: FlexClockContext) :
     /** False when the user picked a clock color: then everything uses that color. */
     var haloUsesAccent = true
 
+    /** BlueOS 0.8.1: the clock's theme says the digits are light (see haloAccentFor). */
+    var haloLightDigits = true
+
+    /**
+     * BlueOS 0.8.1: «Цифры минут» (lock screen, AOD colour) on the stacked clock too; null = like the hours. The setting
+     * only reached the one-line clock, so the same setting gave different minutes on the big and the small clock.
+     */
+    var blueOSMinutesColors: Pair<Int, Int>? = null
+
     // Horizontal radius of the halo: 30% of the width of the hours
     private val haloRx: Float
         get() {
@@ -157,6 +166,11 @@ class FlexClockViewGroup(clockCtx: FlexClockContext) :
             id == ClockViewIds.HOUR_FIRST_DIGIT ||
             id == ClockViewIds.HOUR_SECOND_DIGIT
 
+    private fun isMinuteView(id: Int) =
+        id == ClockViewIds.MINUTE_DIGIT_PAIR ||
+            id == ClockViewIds.MINUTE_FIRST_DIGIT ||
+            id == ClockViewIds.MINUTE_SECOND_DIGIT
+
     private fun drawHalo(canvas: Canvas) {
         val hours = children.filter { isHourView(it.id) }.toList()
         if (hours.isEmpty()) return
@@ -184,15 +198,14 @@ class FlexClockViewGroup(clockCtx: FlexClockContext) :
 
     override fun updateColor(lockscreenColor: Int, aodColor: Int) {
         if (isBlueOSHalo) {
-            // BlueOS 0.8: the halo is the one accent; hours and minutes share the digits' colour (approved mockup —
-            // 0.7 painted the minutes in the halo's accent, a second loud colour in the same block)
-            haloLockscreenColor = if (haloUsesAccent) haloAccentFor(context, lockscreenColor, false) else lockscreenColor
-            haloAodColor = if (haloUsesAccent) haloAccentFor(context, aodColor, true) else aodColor
-            children.forEach { view -> view.updateColor(lockscreenColor, aodColor) }
-            invalidate()
-            return
+            haloLockscreenColor = if (haloUsesAccent) haloAccentFor(context, haloLightDigits, false) else lockscreenColor
+            haloAodColor = if (haloUsesAccent) haloAccentFor(context, haloLightDigits, true) else aodColor
+        }
+        val minutes = blueOSMinutesColors
+        children.forEach { view ->
+            if (minutes != null && isMinuteView(view.id)) view.updateColor(minutes.first, minutes.second)
+            else view.updateColor(lockscreenColor, aodColor)
         }
-        children.forEach { view -> view.updateColor(lockscreenColor, aodColor) }
         invalidate()
     }
 

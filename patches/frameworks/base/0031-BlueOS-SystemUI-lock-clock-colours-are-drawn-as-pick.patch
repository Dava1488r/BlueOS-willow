@@ -195,12 +195,15 @@ class FlexClockTextViewController(
             }
 
             override fun onFontSettingChanged(fontSizePx: Float) {
-                view.applyTextSize(fontSizePx, constrainedByHeight = false)
+                // BlueOS 0.8.1: «Размер цифр»
+                view.applyTextSize(fontSizePx *
+                    org.blueos.arona.BlueOSSettings.lockClockScale(clockCtx.context.contentResolver), constrainedByHeight = false)
             }
 
             override fun onThemeChanged(theme: ThemeConfig) {
                 // BlueOS Halo: a clock color picked by the user replaces the accent
                 view.haloUsesAccent = theme.seedColor == null
+                view.haloLightDigits = theme.isDarkTheme
                 val lockscreenColor =
                     if (clockCtx.isBlueOSHalo) theme.blueOSHaloDefaultColor(clockCtx.context)
                     else theme.blueOSDefaultColor(clockCtx.context)
@@ -209,9 +212,14 @@ class FlexClockTextViewController(
                     aodColor = theme.blueOSAodColor(clockCtx.context, lockscreenColor),
                 )
                 // BlueOS 0.8: the minutes in their own role («Минуты» in «Цвета»), unless a clock colour is picked
-                view.blueOSMinutesColor =
-                    if (theme.seedColor == null) org.blueos.arona.BlueOSColorRoles.lockMinutes(clockCtx.context)
+                val minutes =
+                    if (theme.seedColor == null && theme.isDarkTheme) org.blueos.arona.BlueOSColorRoles.lockMinutes(clockCtx.context)
                     else null
+                view.blueOSMinutesColor = minutes
+                // 0.8.1: AOD «Как на блокировке» keeps them apart too, like the stacked clock
+                view.blueOSMinutesAodColor = minutes?.takeIf {
+                    org.blueos.arona.BlueOSColorRoles.aodMode(clockCtx.context) == org.blueos.arona.BlueOSColorRoles.AOD_LOCK
+                }?.let { theme.blueOSAodColor(clockCtx.context, it) }
                 refreshTime()
             }
 
diff --git a/packages/SystemUI/customization/src/com/android/systemui/shared/clocks/controller/FlexClockViewGroupController.kt b/packages/SystemUI/customization/src/com/android/systemui/shared/clocks/controller/FlexClockViewGroupController.kt

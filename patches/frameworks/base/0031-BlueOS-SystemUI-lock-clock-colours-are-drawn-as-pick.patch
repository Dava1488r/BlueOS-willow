diff --git a/packages/SystemUI/customization/src/com/android/systemui/shared/clocks/view/BlueOSHalo.kt b/packages/SystemUI/customization/src/com/android/systemui/shared/clocks/view/BlueOSHalo.kt
index 5729caae14dc..2535f1a91466 100644
--- a/packages/SystemUI/customization/src/com/android/systemui/shared/clocks/view/BlueOSHalo.kt
+++ b/packages/SystemUI/customization/src/com/android/systemui/shared/clocks/view/BlueOSHalo.kt
@@ -351,12 +351,12 @@ internal fun View.liveHalo() {
 }
 
 /**
- * The halo's colour next to [digitColor]. BlueOS 0.8: light digits → the role chosen for the halo in «Цвета» (default
- * the accent, brighter where the wallpaper under it is light); AOD → the AOD halo (grey unless «Нимб акцентом»);
- * dark digits («По обоям» on a light wallpaper) → a deep accent.
+ * The halo's colour. BlueOS 0.8: light digits → the role chosen for the halo in «Цвета»; AOD → the AOD halo (grey unless
+ * «Нимб акцентом»); dark digits («По обоям» on a light wallpaper) → a deep accent. 0.8.1: [lightDigits] comes from the
+ * clock's theme: guessing from the digits' luminance sent the halo to the deep accent with a darker picked colour.
  */
-internal fun haloAccentFor(context: Context, digitColor: Int, dozing: Boolean): Int = when {
+internal fun haloAccentFor(context: Context, lightDigits: Boolean, dozing: Boolean): Int = when {
     dozing -> org.blueos.arona.BlueOSColorRoles.aodHalo(context)
-    Color.luminance(digitColor) > 0.5f -> org.blueos.arona.BlueOSColorRoles.lockHalo(context)
+    lightDigits -> org.blueos.arona.BlueOSColorRoles.lockHalo(context)
     else -> context.getColor(android.R.color.system_accent1_700)
 }

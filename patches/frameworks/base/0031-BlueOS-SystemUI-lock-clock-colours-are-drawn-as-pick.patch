@@ -194,7 +194,14 @@ constructor(
 
             override fun onThemeChanged(theme: ThemeConfig) {
                 // BlueOS Halo: a clock color picked by the user replaces the accent
-                (view as? FlexClockViewGroup)?.haloUsesAccent = theme.seedColor == null
+                (view as? FlexClockViewGroup)?.run {
+                    haloUsesAccent = theme.seedColor == null

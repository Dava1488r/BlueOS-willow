+++ b/packages/SystemUI/customization/clocks/common/src/com/android/systemui/customization/clocks/view/DigitalClockTextView.kt
@@ -374,6 +374,8 @@ abstract class DigitalClockTextView(private val clockCtx: ClockContext) :
             field = value
             invalidate()
         }
+    /** BlueOS 0.8.1: the minutes' colour on AOD when it differs from the hours' («Как на блокировке»); null = they fade. */
+    var blueOSMinutesAodColor: Int? = null
     private val blueOSTint = Paint().apply { xfermode = android.graphics.PorterDuffXfermode(android.graphics.PorterDuff.Mode.SRC_ATOP) }
 
     protected open fun drawAnimators(canvas: Canvas, drawTranslation: VPointF) {
@@ -381,7 +383,8 @@ abstract class DigitalClockTextView(private val clockCtx: ClockContext) :
         val l = layout
         val colon = text?.indexOf(':') ?: -1
         val k = 1f - dozeFraction.coerceIn(0f, 1f)
-        if (minutes == null || l == null || colon < 0 || isVertical || k <= 0f) {
+        val minutesAod = blueOSMinutesAodColor
+        if (minutes == null || l == null || colon < 0 || isVertical || (k <= 0f && minutesAod == null)) {
             textAnimator.draw(canvas)
             return
         }
@@ -395,8 +398,12 @@ abstract class DigitalClockTextView(private val clockCtx: ClockContext) :
             clipRect(split, -BIG, BIG, BIG)
             val layer = saveLayer(null, null)
             textAnimator.draw(this)
-            blueOSTint.color = minutes
-            blueOSTint.alpha = (k * Color.alpha(minutes)).toInt()
+            if (minutesAod != null) {
+                blueOSTint.color = androidx.core.graphics.ColorUtils.blendARGB(minutes, minutesAod, 1f - k)
+            } else {
+                blueOSTint.color = minutes
+                blueOSTint.alpha = (k * Color.alpha(minutes)).toInt()
+            }
             drawPaint(blueOSTint)
             restoreToCount(layer)
         }
diff --git a/packages/SystemUI/customization/src/com/android/systemui/shared/clocks/controller/FlexClockTextViewController.kt b/packages/SystemUI/customization/src/com/android/systemui/shared/clocks/controller/FlexClockTextViewController.kt

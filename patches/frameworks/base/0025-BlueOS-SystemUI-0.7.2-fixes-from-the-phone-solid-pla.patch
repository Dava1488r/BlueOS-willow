--- a/packages/SystemUI/customization/src/com/android/systemui/shared/clocks/view/FlexClockTextView.kt
+++ b/packages/SystemUI/customization/src/com/android/systemui/shared/clocks/view/FlexClockTextView.kt
@@ -101,12 +101,27 @@ class FlexClockTextView(clockCtx: FlexClockContext, private val isLargeClock: Bo
         val rx = minutesWidth * HALO_RX_FRACTION
         val visibility = haloVisibility(this, blueOSHaloAlpha)
         if (rx <= 0f || visibility <= 0f) return
-        val digitColor = if (isDozing) aodColor else lockscreenColor
+        // BlueOS 0.7.2: the colour the digits are really drawn with (the text animator's), not lockscreenColor —
+        // after a theme change in AOD the digits kept their light AOD colour while the halo took the dark one
+        val digitColor = drawnDigitColor() ?: if (isDozing) aodColor else lockscreenColor
         val color = if (haloUsesAccent) haloAccentFor(context, digitColor) else digitColor
         drawHaloShape(canvas, minutesStart + minutesWidth / 2f, extraTopSpace / 2f, rx, isDozing,
             haloPaint, haloOval, withVisibility(color, visibility))
     }
 
+    private fun drawnDigitColor(): Int? = runCatching {
+        val interp = textAnimator.textInterpolator
+        val t = textAnimator.progress.coerceIn(0f, 1f)
+        val a = interp.basePaint.color
+        val b = interp.targetPaint.color
+        fun mix(sa: Int, sb: Int) = (sa + (sb - sa) * t).toInt()
+        android.graphics.Color.argb(
+            mix(android.graphics.Color.alpha(a), android.graphics.Color.alpha(b)),
+            mix(android.graphics.Color.red(a), android.graphics.Color.red(b)),
+            mix(android.graphics.Color.green(a), android.graphics.Color.green(b)),
+            mix(android.graphics.Color.blue(a), android.graphics.Color.blue(b)))
+    }.getOrNull()

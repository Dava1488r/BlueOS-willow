diff --git a/packages/SystemUI/src/com/android/systemui/blueos/lockscreen/BlueOSLockProtection.kt b/packages/SystemUI/src/com/android/systemui/blueos/lockscreen/BlueOSLockProtection.kt
new file mode 100644
index 000000000000..98bd08fb5fb8
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/blueos/lockscreen/BlueOSLockProtection.kt
@@ -0,0 +1,193 @@
+package com.android.systemui.blueos.lockscreen
+
+import android.app.WallpaperColors
+import android.app.WallpaperManager
+import android.content.Context
+import android.content.res.Configuration
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.RectF
+import android.graphics.Shader
+import android.os.Handler
+import android.os.Looper
+import android.view.View
+import android.view.ViewTreeObserver
+import androidx.core.graphics.ColorUtils
+import org.blueos.arona.BlueOSColorRoles as C
+import org.blueos.arona.BlueOSSettings as K
+
+/**
+ * BlueOS 0.8 «Защита читаемости». The lock screen text stays light (the user doesn't want it dark), so where the
+ * wallpaper under it is light, the wallpaper is dimmed: one smooth top-to-bottom gradient in the palette's own deep
+ * tone, exactly as much as each block needs for its contrast — 4.5:1 for the greeting, the date and the line at the
+ * bottom, 3:1 for the big digits — and nothing at all on dark wallpapers (approved mockup blueos-0.8-colors.html).
+ *
+ * The wallpaper under each block comes from its local colours, like RegionSampler's; the bright spots count (90th
+ * percentile of luminance), not the average: light text disappears on the lightest part under it.
+ */
+class BlueOSLockProtection(context: Context) : View(context), WallpaperManager.LocalWallpaperColorConsumer {
+    private val wm = context.getSystemService(WallpaperManager::class.java)
+    private val main = Handler(Looper.getMainLooper())
+    private val paint = Paint()
+    /** The wallpaper's bright spots (luminance) under: the greeting + date, the big clock, the line at the bottom. */
+    private val bright = floatArrayOf(0f, 0f, 0f)
+    private val sampled = booleanArrayOf(false, false, false)
+    private val dimming = floatArrayOf(0f, 0f, 0f)
+    private var listening = false
+    private var unobserve: (() -> Unit)? = null
+
+    /** On the lock screen and awake: only then it samples and draws. */
+    var active = false
+        set(v) {
+            if (field == v) return
+            field = v
+            updateListening()
+            fadeTo(if (v) 1f else 0f)
+        }
+
+    /**
+     * 0.8: the dimming fades with the screen going to AOD and back (it switched off in one frame and the wallpaper
+     * flashed lighter just before the screen went dark).
+     */
+    private var fade = 0f
+    private var fadeAnim: android.animation.ValueAnimator? = null
+
+    private fun fadeTo(to: Float) {
+        fadeAnim?.cancel()
+        if (!isShown) { fade = to; invalidate(); return }
+        fadeAnim = android.animation.ValueAnimator.ofFloat(fade, to).apply {
+            duration = 400
+            addUpdateListener { fade = it.animatedValue as Float; invalidate() }
+            start()
+        }
+    }
+
+    init {
+        importantForAccessibility = IMPORTANT_FOR_ACCESSIBILITY_NO
+    }
+
+    /** The lock screen's root when this view sits outside it (under the status bar): its alpha is ours. */
+    var follow: View? = null
+    private val preDraw = ViewTreeObserver.OnPreDrawListener {
+        follow?.let { if (alpha != it.alpha) alpha = it.alpha }
+        true
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        unobserve = K.observe(context, K.COLOR_KEYS + K.LOCK_TEXT_COLOR) { recompute() }
+        viewTreeObserver.addOnPreDrawListener(preDraw)
+        updateListening()
+    }
+
+    override fun onDetachedFromWindow() {
+        viewTreeObserver.removeOnPreDrawListener(preDraw)
+        unobserve?.invoke()
+        unobserve = null
+        stopListening()
+        super.onDetachedFromWindow()
+    }
+
+    /** A new palette or theme: other colours and another deep tone. */
+    override fun onConfigurationChanged(newConfig: Configuration?) {
+        super.onConfigurationChanged(newConfig)
+        recompute()
+    }
+
+    private fun updateListening() {
+        val want = isAttachedToWindow && active
+        if (want == listening) return
+        if (!want) {
+            stopListening()
+            return
+        }
+        listening = true
+        try {
+            wm?.addOnColorsChangedListener(this, REGIONS.toList(), WallpaperManager.FLAG_LOCK)
+        } catch (e: RuntimeException) {
+            // no local colours: the whole wallpaper below stays the estimate
+        }
+        // until the regions report, the whole wallpaper (a binder call: not on the main thread)
+        Thread {
+            val all = wm?.getWallpaperColors(WallpaperManager.FLAG_LOCK) ?: wm?.getWallpaperColors(WallpaperManager.FLAG_SYSTEM)
+            val l = all?.let(::brightSpots) ?: return@Thread
+            main.post {
+                for (i in bright.indices) if (!sampled[i]) bright[i] = l
+                recompute()
+            }
+        }.start()
+    }
+
+    private fun stopListening() {
+        if (!listening) return
+        listening = false
+        try {
+            wm?.removeOnColorsChangedListener(this)
+        } catch (e: RuntimeException) {
+        }
+    }
+
+    override fun onColorsChanged(area: RectF?, colors: WallpaperColors?) {
+        val i = REGIONS.indexOfFirst { it == area }
+        if (i < 0 || colors == null) return
+        val l = brightSpots(colors)
+        main.post {
+            bright[i] = l
+            sampled[i] = true
+            recompute()
+        }
+    }
+
+    /** Luminance of the lightest 10 % of the area (by the colours' populations). */
+    private fun brightSpots(colors: WallpaperColors): Float {
+        val all = colors.allColors
+        if (all.isEmpty()) return C.luminance(colors.primaryColor.toArgb())
+        val total = all.values.sum().toFloat()
+        var acc = 0f
+        for ((color, n) in all.entries.sortedByDescending { C.luminance(it.key) }) {
+            acc += n
+            if (acc >= total * 0.1f) return C.luminance(color)
+        }
+        return 0f
+    }
+
+    private fun recompute() {
+        val mode = K.int(context.contentResolver, K.LOCK_TEXT_COLOR)
+        // the same rule as the clock (ClockEventController): light text with «Всегда светлый», or «По теме» in the dark
+        val lightText = mode == 2 || (mode == 0 && C.isDark())
+        if (lightText) {
+            dimming[0] = C.protectAlpha(context, bright[0], C.lockText(context), 4.5f, .86f)
+            dimming[1] = C.protectAlpha(context, bright[1], C.lockDigits(context), 3f, .78f)
+            dimming[2] = C.protectAlpha(context, bright[2], Color.WHITE, 4.5f, .86f)
+        } else {
+            dimming.fill(0f)
+        }
+        C.setBackdrop(bright[0] * (1 - dimming[0]), bright[1] * (1 - dimming[1]), bright[2] * (1 - dimming[2]))
+        val tint = C.protectTint(context)
+        fun k(a: Float) = ColorUtils.setAlphaComponent(tint, (a * 255).toInt().coerceIn(0, 255))
+        paint.shader = if (dimming.all { it < .005f }) null else LinearGradient(0f, 0f, 0f, height.coerceAtLeast(1).toFloat(),
+            intArrayOf(k(dimming[0]), k(dimming[0]), k(dimming[1]), k(dimming[1]), k(dimming[2]), k(dimming[2])),
+            STOPS, Shader.TileMode.CLAMP)
+        invalidate()
+    }
+
+    override fun onSizeChanged(w: Int, h: Int, oldw: Int, oldh: Int) {
+        super.onSizeChanged(w, h, oldw, oldh)
+        recompute()
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        if (fade <= 0f || paint.shader == null) return
+        paint.alpha = (fade * 255).toInt()
+        canvas.drawRect(0f, 0f, width.toFloat(), height.toFloat(), paint)
+    }
+
+    companion object {
+        // fractions of the screen, measured on the phone (lock screen 1080×2400): greeting + date, big clock, indication
+        private val REGIONS = arrayOf(RectF(.07f, .065f, .72f, .145f), RectF(.2f, .2f, .8f, .62f), RectF(.18f, .935f, .82f, .97f))
+        // where each block's dimming holds in the gradient (top band, clock, bottom band)
+        private val STOPS = floatArrayOf(0f, .142f, .225f, .608f, .9f, 1f)
+    }
+}

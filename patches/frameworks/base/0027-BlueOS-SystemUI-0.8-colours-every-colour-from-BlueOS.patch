+    val seed = seedColor
+        ?: return if (isDarkTheme) org.blueos.arona.BlueOSColorRoles.lockDigits(context) else getDefaultColor(context)
     val palette = ColorScheme(seed, isDarkTheme).accent1
     return if (isDarkTheme) palette.s100 else palette.s700
 }
 
+/** BlueOS 0.8: the stock Flex clocks' light digits follow «Цифры часов» in «Цвета» too (a picked clock color wins). */
+fun ThemeConfig.blueOSDefaultColor(context: Context): Int =
+    if (seedColor == null && isDarkTheme) org.blueos.arona.BlueOSColorRoles.lockDigits(context)
+    else getDefaultColor(context)
+
+/**
+ * BlueOS 0.8: AOD digits of every Flex clock — neutral grey at the AOD brightness, the same on any wallpaper
+ * (stock: the accent's tone 90, so a teal wallpaper made a teal AOD). «Как на блокировке» dims [lockColor] instead.
+ */
+fun ThemeConfig.blueOSAodColor(context: Context, lockColor: Int): Int =
+    org.blueos.arona.BlueOSColorRoles.aodColor(context, if (seedColor == null) lockColor else getAodColor(context))
+
 /** Horizontal radius of the halo, as a part of the width of the hours */
 internal const val HALO_RX_FRACTION = 0.3f
 

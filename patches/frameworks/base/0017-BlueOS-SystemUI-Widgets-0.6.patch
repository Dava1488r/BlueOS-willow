+
+package com.android.systemui.blueos.widgets
+
+import android.app.WallpaperColors
+import android.app.WallpaperManager
+import android.content.Context
+import android.content.Intent
+import android.database.ContentObserver
+import android.os.Handler
+import android.os.Looper
+import android.os.UserHandle
+import android.provider.Settings
+import android.widget.RemoteViews
+import com.android.systemui.res.R
+
+/**
+ * The shared look of all BlueOS widgets, here and in Clock, Calendar and Gallery: how transparent
+ * their cards are (set in Wallpaper & style) and, for widgets without a card, whether the
+ * wallpaper wants dark text. SystemUI always runs, so it watches both and tells the other apps.
+ */
+object BlueOSWidgetStyle {
+    /** Secure setting, 0..100: how transparent widget cards are. */
+    const val SETTING_TRANSPARENCY = "blueos_widget_transparency"
+    const val DEFAULT_TRANSPARENCY = 10
+
+    /** Explicit broadcast to the other apps' widget providers: redraw with the new style. */
+    const val ACTION_WIDGET_STYLE_CHANGED = "org.blueos.intent.action.WIDGET_STYLE_CHANGED"
+    private val WIDGET_PACKAGES =
+        listOf("com.android.deskclock", "org.lineageos.etar", "org.lineageos.glimpse")
+
+    private var started = false
+
+    fun start(context: Context) {
+        if (started) return
+        started = true
+        val app = context.applicationContext
+        app.contentResolver.registerContentObserver(
+            Settings.Secure.getUriFor(SETTING_TRANSPARENCY),
+            false,
+            object : ContentObserver(Handler(Looper.getMainLooper())) {
+                override fun onChange(selfChange: Boolean) {
+                    notifyChanged(app)
+                }
+            },
+            UserHandle.USER_ALL,
+        )
+    }
+
+    /** The transparency or the wallpaper colors changed: redraw every BlueOS widget. */
+    fun notifyChanged(context: Context) {
+        val app = context.applicationContext
+        refreshOwnWidgets(app)
+        for (pkg in WIDGET_PACKAGES) {
+            app.sendBroadcastAsUser(
+                Intent(ACTION_WIDGET_STYLE_CHANGED).setPackage(pkg),
+                UserHandle.CURRENT,
+            )
+        }
+    }
+
+    private fun refreshOwnWidgets(context: Context) {
+        BlueOSMediaWidget.start(context)
+        BlueOSMediaWidget.push(context)
+        BlueOSBatteryWidget.start(context)
+        BlueOSBatteryWidget.push(context)
+        BlueOSSummaryWidget.push(context)
+        BlueOSTogglesWidget.start(context)
+        BlueOSTogglesWidget.push(context)
+    }
+
+    /** 0..255 for the card layer (ImageView R.id.blueos_widget_bg) of the widget layouts. */
+    fun cardAlpha(context: Context): Int {
+        val transparency =
+            Settings.Secure.getIntForUser(
+                    context.contentResolver,
+                    SETTING_TRANSPARENCY,
+                    DEFAULT_TRANSPARENCY,
+                    UserHandle.USER_CURRENT,
+                )
+                .coerceIn(0, 100)
+        return (255 * (100 - transparency) + 50) / 100
+    }
+
+    fun applyCard(context: Context, rv: RemoteViews) {
+        rv.setInt(R.id.blueos_widget_bg, "setImageAlpha", cardAlpha(context))
+    }
+
+    /** Whether text drawn right on the home wallpaper (no card) should be dark. */
+    fun wallpaperWantsDarkText(context: Context): Boolean {
+        val colors =
+            WallpaperManager.getInstance(context).getWallpaperColors(WallpaperManager.FLAG_SYSTEM)
+        return colors != null &&
+            (colors.colorHints and WallpaperColors.HINT_SUPPORTS_DARK_TEXT) != 0
+    }

+/**
+ * BlueOS "Summary" widget, without a card: a greeting to Sensei by the time of day, the date and
+ * what's next (the next calendar event within a day, else the next alarm). Like the lock screen.
+ */
+class BlueOSSummaryWidgetProvider : AppWidgetProvider() {
+    override fun onReceive(context: Context, intent: Intent) {
+        super.onReceive(context, intent)
+        when (intent.action) {
+            BlueOSSummaryWidget.ACTION_REFRESH,
+            Intent.ACTION_TIME_CHANGED,
+            Intent.ACTION_TIMEZONE_CHANGED,
+            Intent.ACTION_LOCALE_CHANGED,
+            AlarmManager.ACTION_NEXT_ALARM_CLOCK_CHANGED -> BlueOSSummaryWidget.push(context)
+        }
+    }
+
+    override fun onUpdate(context: Context, wm: AppWidgetManager, widgetIds: IntArray) {
+        BlueOSSummaryWidget.push(context)
+    }
+
+    override fun onDisabled(context: Context) {
+        context.getSystemService(AlarmManager::class.java)
+            ?.cancel(BlueOSSummaryWidget.refreshIntent(context))
+    }
+}
+
+internal object BlueOSSummaryWidget {
+    const val ACTION_REFRESH = "org.blueos.systemui.summary.REFRESH"
+    private const val LOOK_AHEAD_MILLIS = DateUtils.DAY_IN_MILLIS
+    /** Hours where the greeting changes: morning, afternoon, evening, night. */
+    private val GREETING_HOURS = intArrayOf(5, 12, 17, 23)
+
+    private val executor = Executors.newSingleThreadExecutor()
+    private val mainHandler = Handler(Looper.getMainLooper())
+    private var observing = false
+
+    private class Event(val title: String, val begin: Long, val end: Long)
+
+    fun push(context: Context) {
+        val app = context.applicationContext
+        val wm = AppWidgetManager.getInstance(app)
+        val provider = ComponentName(app, BlueOSSummaryWidgetProvider::class.java)
+        if (wm.getAppWidgetIds(provider).isEmpty()) return
+        observeCalendar(app)
+        // The calendar query stays off the main thread
+        executor.execute {
+            val event = nextEvent(app)
+            val rv = build(app, event)
+            wm.updateAppWidget(provider, rv)
+            scheduleRefresh(app, event)
+        }
+    }
+
+    private fun build(context: Context, event: Event?): RemoteViews {
+        val darkText = BlueOSWidgetStyle.wallpaperWantsDarkText(context)
+        val rv =
+            RemoteViews(
+                context.packageName,
+                if (darkText) R.layout.blueos_summary_widget_dark_text
+                else R.layout.blueos_summary_widget_light_text,
+            )
+        rv.setTextViewText(R.id.blueos_summary_greeting, context.getString(greeting()))
+        val date = DateFormat.getBestDateTimePattern(Locale.getDefault(), "EEEMMMd")
+        rv.setCharSequence(R.id.blueos_summary_date, "setFormat12Hour", date)
+        rv.setCharSequence(R.id.blueos_summary_date, "setFormat24Hour", date)
+
+        val calendar =
+            Intent(Intent.ACTION_VIEW)
+                .setData(Uri.parse("content://com.android.calendar/time/${System.currentTimeMillis()}"))
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        var open = calendar
+        val next: String?
+        if (event != null) {
+            rv.setImageViewResource(R.id.blueos_summary_icon, R.drawable.blueos_ic_event)
+            next = "${eventTime(context, event)}  ${event.title}"
+        } else {
+            val alarm = context.getSystemService(AlarmManager::class.java)?.nextAlarmClock
+            next =
+                alarm?.let {
+                    val skeleton = if (DateFormat.is24HourFormat(context)) "EHm" else "Ehma"
+                    DateFormat.format(
+                            DateFormat.getBestDateTimePattern(Locale.getDefault(), skeleton),
+                            it.triggerTime,
+                        )
+                        .toString()
+                }
+            if (next != null) {
+                rv.setImageViewResource(R.id.blueos_summary_icon, R.drawable.blueos_ic_alarm)
+                open = Intent(AlarmClock.ACTION_SHOW_ALARMS).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+            }
+        }
+        val visibility = if (next != null) View.VISIBLE else View.GONE
+        rv.setViewVisibility(R.id.blueos_summary_icon, visibility)
+        rv.setViewVisibility(R.id.blueos_summary_next, visibility)
+        rv.setTextViewText(R.id.blueos_summary_next, next ?: "")
+        rv.setOnClickPendingIntent(
+            android.R.id.background,
+            PendingIntent.getActivity(
+                context,
+                0,
+                open,
+                PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+            ),
+        )
+        return rv
+    }
+
+    private fun greeting(): Int {
+        val hour = Calendar.getInstance().get(Calendar.HOUR_OF_DAY)
+        return when (hour) {
+            in 5 until 12 -> R.string.blueos_summary_morning
+            in 12 until 17 -> R.string.blueos_summary_day
+            in 17 until 23 -> R.string.blueos_summary_evening
+            else -> R.string.blueos_summary_night
+        }
+    }
+
+    /** "18:00–19:00" now or later today, "Tomorrow, 10:00" tomorrow. */
+    private fun eventTime(context: Context, event: Event): String {
+        val now = System.currentTimeMillis()
+        if (event.begin <= now || DateUtils.isToday(event.begin)) {
+            return DateUtils.formatDateRange(context, event.begin, event.end, DateUtils.FORMAT_SHOW_TIME)
+        }
+        return context.getString(
+            R.string.blueos_slice_event_tomorrow,
+            DateUtils.formatDateTime(context, event.begin, DateUtils.FORMAT_SHOW_TIME),
+        )
+    }
+
+    /** The next timed, visible event that hasn't ended, within a day. */
+    private fun nextEvent(context: Context): Event? {
+        if (
+            context.checkSelfPermission(Manifest.permission.READ_CALENDAR) !=
+                PackageManager.PERMISSION_GRANTED
+        ) {
+            return null
+        }
+        val now = System.currentTimeMillis()
+        val uri = Instances.CONTENT_URI.buildUpon()
+        ContentUris.appendId(uri, now - DateUtils.DAY_IN_MILLIS)
+        ContentUris.appendId(uri, now + LOOK_AHEAD_MILLIS)
+        return runCatching {
+                context.contentResolver
+                    .query(
+                        uri.build(),
+                        arrayOf(Instances.TITLE, Instances.BEGIN, Instances.END),
+                        "${Instances.VISIBLE}=1 AND ${Instances.ALL_DAY}=0 AND ${Instances.END}>?",
+                        arrayOf(now.toString()),
+                        "${Instances.BEGIN} ASC",
+                    )
+                    ?.use { c ->
+                        if (c.moveToFirst()) {
+                            Event(c.getString(0).orEmpty(), c.getLong(1), c.getLong(2))
+                        } else null
+                    }
+            }
+            .getOrNull()
+    }
+
+    private fun observeCalendar(context: Context) {
+        if (observing) return
+        observing = true
+        runCatching {
+            context.contentResolver.registerContentObserver(
+                CalendarContract.CONTENT_URI,
+                true,
+                object : ContentObserver(mainHandler) {
+                    override fun onChange(selfChange: Boolean) {
+                        push(context)
+                    }
+                },
+            )
+        }
+    }
+
+    /** At the next greeting change, when the event starts or ends, or at midnight. */
+    private fun scheduleRefresh(context: Context, event: Event?) {
+        val now = System.currentTimeMillis()
+        val cal = Calendar.getInstance()
+        var at = Long.MAX_VALUE
+        for (dayOffset in 0..1) {
+            for (hour in GREETING_HOURS) {
+                cal.timeInMillis = now
+                cal.add(Calendar.DAY_OF_YEAR, dayOffset)
+                cal.set(Calendar.HOUR_OF_DAY, hour)
+                cal.set(Calendar.MINUTE, 0)
+                cal.set(Calendar.SECOND, 1)
+                if (cal.timeInMillis > now) at = minOf(at, cal.timeInMillis)
+            }
+        }
+        cal.timeInMillis = now
+        cal.add(Calendar.DAY_OF_YEAR, 1)
+        cal.set(Calendar.HOUR_OF_DAY, 0)
+        cal.set(Calendar.MINUTE, 0)
+        cal.set(Calendar.SECOND, 1)
+        at = minOf(at, cal.timeInMillis)
+        if (event != null) {
+            if (event.begin > now) at = minOf(at, event.begin)
+            at = minOf(at, event.end + 1000)
+        }
+        context.getSystemService(AlarmManager::class.java)
+            ?.set(AlarmManager.RTC, at, refreshIntent(context))
+    }
+
+    fun refreshIntent(context: Context): PendingIntent =
+        PendingIntent.getBroadcast(
+            context,
+            0,
+            Intent(ACTION_REFRESH).setClass(context, BlueOSSummaryWidgetProvider::class.java),
+            PendingIntent.FLAG_IMMUTABLE,
+        )
+}

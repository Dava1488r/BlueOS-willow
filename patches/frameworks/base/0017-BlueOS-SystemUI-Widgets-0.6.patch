+
+package com.android.systemui.blueos.widgets
+
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.app.UiModeManager
+import android.appwidget.AppWidgetManager
+import android.appwidget.AppWidgetProvider
+import android.content.BroadcastReceiver
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.content.res.Configuration
+import android.database.ContentObserver
+import android.hardware.camera2.CameraCharacteristics
+import android.hardware.camera2.CameraManager
+import android.os.Handler
+import android.os.Looper
+import android.os.PowerManager
+import android.provider.Settings
+import android.util.Log
+import android.widget.RemoteViews
+import com.android.internal.view.RotationPolicy
+import com.android.systemui.res.R
+
+/**
+ * BlueOS quick toggles widget: flashlight, do not disturb, auto-rotate, dark theme and battery
+ * saver, like Quick Settings tiles on the home screen. SystemUI may switch all of them.
+ */
+class BlueOSTogglesWidgetProvider : AppWidgetProvider() {
+    override fun onReceive(context: Context, intent: Intent) {
+        super.onReceive(context, intent)
+        BlueOSTogglesWidget.start(context)
+        BlueOSTogglesWidget.onAction(context, intent.action)
+    }
+
+    override fun onUpdate(context: Context, wm: AppWidgetManager, widgetIds: IntArray) {
+        BlueOSTogglesWidget.start(context)
+        BlueOSTogglesWidget.push(context)
+    }
+}
+
+internal object BlueOSTogglesWidget {
+    private const val TAG = "BlueOSToggles"
+    private const val ACTION_PREFIX = "org.blueos.systemui.toggles."
+
+    private enum class Toggle(val viewId: Int) {
+        FLASHLIGHT(R.id.blueos_toggle_flashlight),
+        DND(R.id.blueos_toggle_dnd),
+        ROTATE(R.id.blueos_toggle_rotate),
+        DARK(R.id.blueos_toggle_dark),
+        SAVER(R.id.blueos_toggle_saver),
+    }
+
+    private val handler = Handler(Looper.getMainLooper())
+    private var appContext: Context? = null
+    private var torchCameraId: String? = null
+    private var torchOn = false
+
+    private val torchCallback =
+        object : CameraManager.TorchCallback() {
+            override fun onTorchModeChanged(cameraId: String, enabled: Boolean) {
+                if (cameraId != torchCameraId) return
+                torchOn = enabled
+                appContext?.let { push(it) }
+            }
+        }
+
+    private val receiver =
+        object : BroadcastReceiver() {
+            override fun onReceive(context: Context, intent: Intent) {
+                push(context)
+            }
+        }
+
+    fun start(context: Context) {
+        if (appContext != null) return
+        val app = context.applicationContext
+        appContext = app
+
+        val camera = app.getSystemService(CameraManager::class.java)
+        torchCameraId =
+            runCatching {
+                    camera?.cameraIdList?.firstOrNull { id ->
+                        val c = camera.getCameraCharacteristics(id)
+                        c.get(CameraCharacteristics.FLASH_INFO_AVAILABLE) == true &&
+                            c.get(CameraCharacteristics.LENS_FACING) ==
+                                CameraCharacteristics.LENS_FACING_BACK
+                    }
+                }
+                .getOrNull()
+        camera?.registerTorchCallback(torchCallback, handler)
+
+        app.registerReceiver(
+            receiver,
+            IntentFilter().apply {
+                addAction(NotificationManager.ACTION_INTERRUPTION_FILTER_CHANGED)
+                addAction(PowerManager.ACTION_POWER_SAVE_MODE_CHANGED)
+                addAction(Intent.ACTION_CONFIGURATION_CHANGED)
+            },
+            Context.RECEIVER_NOT_EXPORTED,
+        )
+        app.contentResolver.registerContentObserver(
+            Settings.System.getUriFor(Settings.System.ACCELEROMETER_ROTATION),
+            false,
+            object : ContentObserver(handler) {
+                override fun onChange(selfChange: Boolean) {
+                    push(app)
+                }
+            },
+        )
+    }
+
+    fun onAction(context: Context, action: String?) {
+        if (action == null || !action.startsWith(ACTION_PREFIX)) return
+        val toggle = runCatching { Toggle.valueOf(action.removePrefix(ACTION_PREFIX)) }.getOrNull()
+        try {
+            when (toggle) {
+                Toggle.FLASHLIGHT ->
+                    torchCameraId?.let {
+                        context.getSystemService(CameraManager::class.java)
+                            ?.setTorchMode(it, !torchOn)
+                    }
+                Toggle.DND -> {
+                    val nm = context.getSystemService(NotificationManager::class.java) ?: return
+                    val zen =
+                        if (nm.zenMode == Settings.Global.ZEN_MODE_OFF) {
+                            Settings.Global.ZEN_MODE_IMPORTANT_INTERRUPTIONS
+                        } else Settings.Global.ZEN_MODE_OFF
+                    nm.setZenMode(zen, null, TAG, /* fromUser= */ true)
+                }
+                Toggle.ROTATE ->
+                    RotationPolicy.setRotationLock(
+                        context,
+                        !RotationPolicy.isRotationLocked(context),
+                        TAG,
+                    )
+                Toggle.DARK ->
+                    context.getSystemService(UiModeManager::class.java)
+                        ?.setNightModeActivated(!isDark(context))
+                Toggle.SAVER -> {
+                    val pm = context.getSystemService(PowerManager::class.java) ?: return
+                    pm.setPowerSaveModeEnabled(!pm.isPowerSaveMode)
+                }
+                null -> return
+            }
+        } catch (e: RuntimeException) {
+            Log.w(TAG, "Can't switch $toggle", e)
+        }
+        // Most changes call back on their own; this one keeps the button snappy
+        handler.postDelayed({ push(context) }, 300)
+    }
+
+    private fun isDark(context: Context): Boolean =
+        (context.resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) ==
+            Configuration.UI_MODE_NIGHT_YES
+
+    private fun isOn(context: Context, toggle: Toggle): Boolean =
+        when (toggle) {
+            Toggle.FLASHLIGHT -> torchOn
+            Toggle.DND ->
+                context.getSystemService(NotificationManager::class.java)?.zenMode !=
+                    Settings.Global.ZEN_MODE_OFF
+            Toggle.ROTATE -> !RotationPolicy.isRotationLocked(context)
+            Toggle.DARK -> isDark(context)
+            Toggle.SAVER -> context.getSystemService(PowerManager::class.java)?.isPowerSaveMode == true
+        }
+
+    fun push(context: Context) {
+        val app = context.applicationContext
+        val wm = AppWidgetManager.getInstance(app)
+        val provider = ComponentName(app, BlueOSTogglesWidgetProvider::class.java)
+        if (wm.getAppWidgetIds(provider).isEmpty()) return
+
+        val rv = RemoteViews(app.packageName, R.layout.blueos_toggles_widget)
+        BlueOSWidgetStyle.applyCard(app, rv)
+        for (toggle in Toggle.entries) {
+            val on = isOn(app, toggle)
+            rv.setInt(
+                toggle.viewId,
+                "setBackgroundResource",
+                if (on) R.drawable.blueos_toggle_on else R.drawable.blueos_toggle_off,
+            )
+            rv.setColorStateList(
+                toggle.viewId,
+                "setImageTintList",
+                if (on) R.color.blueos_widget_on_primary else R.color.blueos_widget_on_surface,
+            )
+            rv.setOnClickPendingIntent(
+                toggle.viewId,
+                PendingIntent.getBroadcast(
+                    app,
+                    toggle.ordinal,
+                    Intent(ACTION_PREFIX + toggle.name)
+                        .setClass(app, BlueOSTogglesWidgetProvider::class.java),
+                    PendingIntent.FLAG_IMMUTABLE,
+                ),
+            )
+        }
+        rv.setViewVisibility(
+            R.id.blueos_toggle_flashlight,
+            if (torchCameraId != null) android.view.View.VISIBLE else android.view.View.GONE,
+        )
+        wm.updateAppWidget(provider, rv)
+    }
+}

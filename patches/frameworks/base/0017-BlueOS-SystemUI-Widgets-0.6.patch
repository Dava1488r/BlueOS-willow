+
+package com.android.systemui.blueos.widgets
+
+import android.app.Service
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.media.audiofx.Visualizer
+import android.os.Binder
+import android.os.Handler
+import android.os.HandlerThread
+import android.os.IBinder
+import android.os.Parcel
+import android.os.Process
+import android.os.SharedMemory
+import android.system.OsConstants
+import android.util.Log
+import android.widget.BlueOSVisualizerView
+import java.nio.ByteBuffer
+import kotlin.math.hypot
+import kotlin.math.log10
+import kotlin.math.pow
+
+/**
+ * The spectrum of what is playing for the BlueOS equalizer widgets ([BlueOSVisualizerView] in the
+ * launcher). It listens to the output mix (not the microphone) only while a visible, playing widget
+ * is attached, and writes the bands into read-only shared memory the view reads every frame. Only
+ * the default home app may attach.
+ */
+class BlueOSVisualizerService : Service() {
+    private lateinit var thread: HandlerThread
+    private lateinit var handler: Handler
+    private var shared: SharedMemory? = null
+    private var buffer: ByteBuffer? = null
+    private var visualizer: Visualizer? = null
+    private var fft = ByteArray(0)
+    private var samplingRateHz = 44_100f
+    private val clients = mutableSetOf<IBinder>()
+    private val levels = FloatArray(BlueOSVisualizerView.BANDS)
+    private var sequence = 0
+
+    private val poll =
+        object : Runnable {
+            override fun run() {
+                capture()
+                handler.postDelayed(this, POLL_MILLIS)
+            }
+        }
+
+    private val releaseLater = Runnable { releaseVisualizer() }
+
+    private val binder =
+        object : Binder() {
+            override fun onTransact(code: Int, data: Parcel, reply: Parcel?, flags: Int): Boolean {
+                when (code) {
+                    BlueOSVisualizerView.TRANSACTION_ATTACH -> {
+                        val token = data.readStrongBinder()
+                        val memory = if (token != null && isCallerAllowed()) attach(token) else null
+                        if (memory == null) {
+                            reply?.writeInt(0)
+                        } else {
+                            reply?.writeInt(1)
+                            memory.writeToParcel(reply ?: return true, 0)
+                        }
+                        return true
+                    }
+                    BlueOSVisualizerView.TRANSACTION_DETACH -> {
+                        data.readStrongBinder()?.let { token -> handler.post { detach(token) } }
+                        return true
+                    }
+                }
+                return super.onTransact(code, data, reply, flags)
+            }
+        }
+
+    override fun onCreate() {
+        super.onCreate()
+        thread = HandlerThread("BlueOSVisualizer", Process.THREAD_PRIORITY_DISPLAY)
+        thread.start()
+        handler = Handler(thread.looper)
+    }
+
+    override fun onBind(intent: Intent?): IBinder = binder
+
+    override fun onDestroy() {
+        handler.post {
+            clients.clear()
+            releaseVisualizer()
+            buffer?.let { SharedMemory.unmap(it) }
+            shared?.close()
+        }
+        thread.quitSafely()
+        super.onDestroy()
+    }
+
+    /** The home screen (default launcher) or SystemUI itself: the ones that show widgets. */
+    private fun isCallerAllowed(): Boolean {
+        val uid = Binder.getCallingUid()
+        if (uid == Process.myUid()) return true
+        val identity = Binder.clearCallingIdentity()
+        try {
+            val home =
+                packageManager.resolveActivity(
+                    Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_HOME),
+                    PackageManager.MATCH_DEFAULT_ONLY,
+                ) ?: return false
+            val homeUid = home.activityInfo?.applicationInfo?.uid ?: return false
+            return homeUid == uid
+        } finally {
+            Binder.restoreCallingIdentity(identity)
+        }
+    }
+
+    /** Runs on a binder thread; the work happens on the handler thread. */
+    private fun attach(token: IBinder): SharedMemory? {
+        var result: SharedMemory? = null
+        val done = java.util.concurrent.CountDownLatch(1)
+        handler.post {
+            try {
+                ensureShared()
+                if (clients.add(token)) {
+                    token.linkToDeath({ handler.post { detach(token) } }, 0)
+                }
+                handler.removeCallbacks(releaseLater)
+                startCapture()
+                result = shared
+            } catch (e: Exception) {
+                Log.w(TAG, "Can't attach a visualizer client", e)
+            } finally {
+                done.countDown()
+            }
+        }
+        done.await(2, java.util.concurrent.TimeUnit.SECONDS)
+        return result
+    }
+
+    private fun detach(token: IBinder) {
+        if (!clients.remove(token)) return
+        if (clients.isEmpty()) {
+            handler.removeCallbacks(poll)
+            levels.fill(0f)
+            writeLevels(0)
+            // Keep the effect a moment: the next track or a redraw re-attaches right away
+            handler.postDelayed(releaseLater, RELEASE_DELAY_MILLIS)
+        }
+    }
+
+    private fun ensureShared() {
+        if (shared != null) return
+        val memory = SharedMemory.create("blueos-visualizer", BlueOSVisualizerView.SHARED_SIZE)
+        buffer = memory.mapReadWrite()
+        // Clients may only read; our own mapping stays writable
+        memory.setProtect(OsConstants.PROT_READ)
+        shared = memory
+    }
+
+    private fun startCapture() {
+        if (visualizer == null) {
+            try {
+                // Session 0 = the output mix: whatever any app plays
+                val v = Visualizer(0)
+                // The setters return status codes, so no Kotlin property syntax here
+                v.setEnabled(false)
+                v.setCaptureSize(Visualizer.getCaptureSizeRange()[1].coerceAtMost(1024))
+                // Normalized: the bars move the same at any volume
+                v.setScalingMode(Visualizer.SCALING_MODE_NORMALIZED)
+                v.setMeasurementMode(Visualizer.MEASUREMENT_MODE_NONE)
+                v.setEnabled(true)
+                fft = ByteArray(v.captureSize)
+                samplingRateHz = v.samplingRate / 1000f
+                visualizer = v
+            } catch (e: RuntimeException) {
+                Log.w(TAG, "Visualizer unavailable", e)
+                writeLevels(BlueOSVisualizerView.FLAG_UNAVAILABLE)
+                return
+            }
+        }
+        handler.removeCallbacks(poll)
+        handler.post(poll)
+    }
+
+    private fun releaseVisualizer() {
+        handler.removeCallbacks(poll)
+        visualizer?.let {
+            runCatching { it.setEnabled(false) }
+            it.release()
+        }
+        visualizer = null
+    }
+
+    private fun capture() {
+        val v = visualizer ?: return
+        if (runCatching { v.getFft(fft) }.getOrDefault(Visualizer.ERROR) != Visualizer.SUCCESS) {
+            return
+        }
+        val bins = fft.size / 2
+        val binHz = samplingRateHz / fft.size
+        val bands = BlueOSVisualizerView.BANDS
+        for (band in 0 until bands) {
+            // Log-spaced bands from 40 Hz to 16 kHz, like the ear hears them
+            val lowHz = MIN_HZ * (MAX_HZ / MIN_HZ).pow(band / bands.toFloat())
+            val highHz = MIN_HZ * (MAX_HZ / MIN_HZ).pow((band + 1) / bands.toFloat())
+            val from = (lowHz / binHz).toInt().coerceIn(1, bins - 1)
+            val to = (highHz / binHz).toInt().coerceIn(from + 1, bins)
+            var peak = 0f
+            for (k in from until to) {
+                val re = fft[2 * k].toFloat()
+                val im = fft[2 * k + 1].toFloat()
+                peak = maxOf(peak, hypot(re, im))
+            }
+            // dB above the 8-bit noise floor, scaled to 0..1; highs get a little lift
+            val db = if (peak > 0f) 20f * log10(peak) else 0f
+            val lift = 1f + 0.6f * band / bands
+            levels[band] = ((db - FLOOR_DB) / RANGE_DB * lift).coerceIn(0f, 1f)
+        }
+        writeLevels(0)
+    }
+
+    private fun writeLevels(flags: Int) {
+        val b = buffer ?: return
+        for (i in levels.indices) {
+            b.putFloat(BlueOSVisualizerView.OFFSET_BANDS + i * 4, levels[i])
+        }
+        b.putInt(BlueOSVisualizerView.OFFSET_FLAGS, flags)
+        b.putInt(0, ++sequence)
+    }
+
+    private companion object {
+        const val TAG = "BlueOSVisualizer"
+        const val POLL_MILLIS = 25L
+        const val RELEASE_DELAY_MILLIS = 3_000L
+        const val MIN_HZ = 40f
+        const val MAX_HZ = 16_000f
+        const val FLOOR_DB = 6f
+        const val RANGE_DB = 36f
+    }
+}

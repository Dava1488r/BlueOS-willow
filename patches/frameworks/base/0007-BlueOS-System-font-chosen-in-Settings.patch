From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GDmio <zhalin66@gmail.com>
Date: Sat, 24 Oct 2026 18:07:33 +0200
Subject: [PATCH 07/31] BlueOS: System font chosen in Settings

SystemFonts loads /product/etc/blueos/fonts_customization_<font>.xml named by persist.sys.blueos.font (default M PLUS Rounded 1c) instead of the LineageOS file, and falls back to it if that fails. Generated by vendor/blueos/tools/make-fonts.py; applies after a reboot.

Change-Id: Ia018c2c070c0d4fc30135a2076a86c01a544c13e
---
 .../android/graphics/fonts/SystemFonts.java   | 49 ++++++++++++++-----
 1 file changed, 38 insertions(+), 11 deletions(-)

diff --git a/graphics/java/android/graphics/fonts/SystemFonts.java b/graphics/java/android/graphics/fonts/SystemFonts.java
index 399345abd8ab..d3fc1bb41aa7 100644
--- a/graphics/java/android/graphics/fonts/SystemFonts.java
+++ b/graphics/java/android/graphics/fonts/SystemFonts.java
@@ -66,6 +66,23 @@ public final class SystemFonts {
     /** @hide */
     public static final String OEM_FONT_DIR = "/product/fonts/";
 
+    // BlueOS: system font chosen in Settings > Display > Font (applies after a reboot).
+    // Each font has its own copy of fonts_customization.xml in which the system UI families
+    // (google-sans*, variable-*) point at that font, see vendor/blueos/tools/make-fonts.py.
+    private static final String BLUEOS_FONT_PROP = "persist.sys.blueos.font";
+    private static final String BLUEOS_FONT_DEFAULT = "mplusrounded1c";
+    private static final String BLUEOS_OEM_XML_FORMAT =
+            "/product/etc/blueos/fonts_customization_%s.xml";
+
+    private static String getOemXml() {
+        String font = android.os.SystemProperties.get(BLUEOS_FONT_PROP, BLUEOS_FONT_DEFAULT);
+        if (font.isEmpty() || !font.matches("[a-z0-9]+")) {
+            font = BLUEOS_FONT_DEFAULT;
+        }
+        final String xml = String.format(Locale.ROOT, BLUEOS_OEM_XML_FORMAT, font);
+        return new File(xml).isFile() ? xml : OEM_XML;
+    }
+
     private static final String DEVICE_FONTS_XML_DIR = "/system/etc/";
     private static final String DEVICE_FONT_DIR = "/system/fonts/";
 
@@ -352,7 +369,7 @@ public final class SystemFonts {
             long lastModifiedDate,
             int configVersion
     ) {
-        return getSystemFontConfigInternal(FONTS_XML, SYSTEM_FONT_DIR, OEM_XML, OEM_FONT_DIR,
+        return getSystemFontConfigInternal(FONTS_XML, SYSTEM_FONT_DIR, getOemXml(), OEM_FONT_DIR,
                 updatableFontMap, lastModifiedDate, configVersion);
     }
 
@@ -377,16 +394,16 @@ public final class SystemFonts {
      * @hide
      */
     public static @NonNull FontConfig getSystemPreinstalledFontConfig() {
-        return getSystemFontConfigInternal(FONTS_XML, SYSTEM_FONT_DIR, OEM_XML, OEM_FONT_DIR, null,
-                0, 0);
+        return getSystemFontConfigInternal(FONTS_XML, SYSTEM_FONT_DIR, getOemXml(), OEM_FONT_DIR,
+                null, 0, 0);
     }
 
     /**
      * @hide
      */
     public static @NonNull FontConfig getSystemPreinstalledFontConfigFromLegacyXml() {
-        return getSystemFontConfigInternal(LEGACY_FONTS_XML, SYSTEM_FONT_DIR, OEM_XML, OEM_FONT_DIR,
-                null, 0, 0);
+        return getSystemFontConfigInternal(LEGACY_FONTS_XML, SYSTEM_FONT_DIR, getOemXml(),
+                OEM_FONT_DIR, null, 0, 0);
     }
 
     /* package */ static @NonNull FontConfig getSystemFontConfigInternal(
@@ -399,17 +416,27 @@ public final class SystemFonts {
             int configVersion
     ) {
         try {
-            Log.i(TAG, "Loading font config from " + fontsXml);
+            Log.i(TAG, "Loading font config from " + fontsXml + ", " + oemXml);
             return FontListParser.parse(fontsXml, systemFontDir, oemXml, productFontDir,
                                                 updatableFontMap, lastModifiedDate, configVersion);
-        } catch (IOException e) {
+        } catch (IOException | XmlPullParserException | RuntimeException e) {
+            if (oemXml != null && !OEM_XML.equals(oemXml)) {
+                // BlueOS: a broken font choice must not leave the system without fonts
+                Log.e(TAG, "Failed to load " + oemXml + ", using " + OEM_XML, e);
+                return getSystemFontConfigInternal(fontsXml, systemFontDir, OEM_XML,
+                        productFontDir, updatableFontMap, lastModifiedDate, configVersion);
+            }
+            if (e instanceof XmlPullParserException) {
+                Log.e(TAG, "Failed to parse the system font configuration.", e);
+                return new FontConfig(Collections.emptyList(), Collections.emptyList(),
+                        Collections.emptyList(), Collections.emptyList(), 0, 0);
+            }
+            if (e instanceof RuntimeException) {
+                throw (RuntimeException) e;
+            }
             Log.e(TAG, "Failed to open/read system font configurations.", e);
             return new FontConfig(Collections.emptyList(), Collections.emptyList(),
                     Collections.emptyList(), Collections.emptyList(), 0, 0);
-        } catch (XmlPullParserException e) {
-            Log.e(TAG, "Failed to parse the system font configuration.", e);
-            return new FontConfig(Collections.emptyList(), Collections.emptyList(),
-                    Collections.emptyList(), Collections.emptyList(), 0, 0);
         }
     }
 

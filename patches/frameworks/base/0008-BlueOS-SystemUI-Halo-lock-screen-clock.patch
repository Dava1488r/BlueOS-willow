 import android.annotation.SuppressLint
 import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RectF
 import android.icu.text.NumberFormat
 import android.util.MathUtils.constrainedMap
 import android.view.View
@@ -108,8 +111,55 @@ class FlexClockViewGroup(clockCtx: FlexClockContext) :
                 child.draw(this)
             }
         }
+        if (isBlueOSHalo) drawHalo(canvas)
     }
 
+    // BlueOS Halo clock: a tilted halo over the hours, like the one over the "O" of the logo
+    private val isBlueOSHalo = clockCtx.isBlueOSHalo
+    private var isHaloDozing = false
+    private var haloLockscreenColor = Color.WHITE
+    private var haloAodColor = Color.WHITE
+    private val haloPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE }
+    private val haloOval = RectF()
+
+    private fun isHourView(id: Int) =
+        id == ClockViewIds.HOUR_DIGIT_PAIR ||
+            id == ClockViewIds.HOUR_FIRST_DIGIT ||
+            id == ClockViewIds.HOUR_SECOND_DIGIT
+
+    private fun isMinuteView(id: Int) =
+        id == ClockViewIds.MINUTE_DIGIT_PAIR ||
+            id == ClockViewIds.MINUTE_FIRST_DIGIT ||
+            id == ClockViewIds.MINUTE_SECOND_DIGIT
+
+    private fun drawHalo(canvas: Canvas) {
+        val hours = children.filter { isHourView(it.id) }.toList()
+        if (hours.isEmpty()) return
+        val left = hours.minOf { it.position.x }
+        val right = hours.maxOf { it.position.x + it.measuredSize.x }
+        val top = hours.minOf { it.position.y }
+        val height = hours.maxOf { it.measuredSize.y }
+        val rx = (right - left) * 0.3f
+        if (rx <= 0f || height <= 0f) return
+        val ry = rx * 0.29f
+        val cx = (left + right) / 2f
+        val cy = top + height * 0.12f
+        haloPaint.strokeWidth = rx * if (isHaloDozing) 0.08f else 0.18f
+        haloPaint.color = if (isHaloDozing) haloAodColor else haloLockscreenColor
+        haloOval.set(cx - rx, cy - ry, cx + rx, cy + ry)
+        canvas.withSave {
+            rotate(-10f, cx, cy)
+            drawOval(haloOval, haloPaint)
+        }
+    }
+
+    /** Accent tone that reads on the clock's background (light digits = dark background). */
+    private fun accentFor(digitColor: Int): Int =
+        context.getColor(
+            if (Color.luminance(digitColor) > 0.5f) android.R.color.system_accent1_200
+            else android.R.color.system_accent1_700
+        )
+
     override fun refreshTime() {
         logger.refreshTime()
         children.forEach { textView -> textView.refreshText() }
@@ -121,6 +171,16 @@ class FlexClockViewGroup(clockCtx: FlexClockContext) :
     }
 
     override fun updateColor(lockscreenColor: Int, aodColor: Int) {
+        if (isBlueOSHalo) {
+            haloLockscreenColor = accentFor(lockscreenColor)
+            haloAodColor = accentFor(aodColor)
+            children.forEach { view ->
+                if (isMinuteView(view.id)) view.updateColor(haloLockscreenColor, haloAodColor)
+                else view.updateColor(lockscreenColor, aodColor)
+            }
+            invalidate()
+            return
+        }
         children.forEach { view -> view.updateColor(lockscreenColor, aodColor) }
         invalidate()
     }
@@ -135,6 +195,10 @@ class FlexClockViewGroup(clockCtx: FlexClockContext) :
     }
 
     override fun animateDoze(isDozing: Boolean, isAnimated: Boolean) {
+        if (isBlueOSHalo && isHaloDozing != isDozing) {
+            isHaloDozing = isDozing
+            invalidate()
+        }
         fun executeDozeAnimation() {
             children.forEach { view -> view.animateDoze(isDozing, isAnimated) }
         }

diff --git a/packages/SystemUI/res/drawable/blueos_logo_shutdown_off.xml b/packages/SystemUI/res/drawable/blueos_logo_shutdown_off.xml
new file mode 100644
index 000000000000..0e761e341061
--- /dev/null
+++ b/packages/SystemUI/res/drawable/blueos_logo_shutdown_off.xml
@@ -0,0 +1,39 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- BlueOS power off: the halo disappears. Generated by vendor/blueos/tools/make-logo-assets.py. -->
+<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:aapt="http://schemas.android.com/aapt"
+    android:drawable="@drawable/blueos_logo_shutdown">
+    <target android:name="halo">
+        <aapt:attr name="android:animation">
+            <set android:ordering="sequentially">
+                <objectAnimator
+                    android:duration="350"
+                    android:interpolator="@android:interpolator/accelerate_decelerate"
+                    android:propertyName="translateY"
+                    android:startOffset="150"
+                    android:valueFrom="0"
+                    android:valueTo="-1.5"
+                    android:valueType="floatType" />
+                <objectAnimator
+                    android:duration="350"
+                    android:interpolator="@android:interpolator/accelerate_decelerate"
+                    android:propertyName="translateY"
+                    android:valueFrom="-1.5"
+                    android:valueTo="0"
+                    android:valueType="floatType" />
+            </set>
+        </aapt:attr>
+    </target>
+    <target android:name="halo_path">
+        <aapt:attr name="android:animation">
+            <objectAnimator
+                android:duration="600"
+                android:interpolator="@android:interpolator/accelerate_quad"
+                android:propertyName="strokeAlpha"
+                android:startOffset="850"
+                android:valueFrom="1"
+                android:valueTo="0"
+                android:valueType="floatType" />
+        </aapt:attr>
+    </target>
+</animated-vector>

+    // BlueOS Halo, small clock (one line, e.g. with notifications or on AOD): the halo goes
+    // above the hours, in room added on top of the text
+    private val hasSmallHalo: Boolean = isBlueOSHalo && !isLargeClock
+    private val haloPaint = Paint()
+    private val haloOval = RectF()
+
+    /** False when the user picked a clock color: then the halo uses that color. */
+    var haloUsesAccent = true
+
+    private val hoursWidth: Float
+        get() {
+            val time = text?.toString() ?: return 0f
+            val colon = time.indexOf(':')
+            return lockscreenPaint.measureText(if (colon > 0) time.substring(0, colon) else time.take(2))
+        }
+
+    override val extraTopSpace: Float
+        get() = if (hasSmallHalo) hoursWidth * HALO_RX_FRACTION * HALO_SPACE_FRACTION else 0f
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        if (!hasSmallHalo) return
+        val rx = hoursWidth * HALO_RX_FRACTION
+        if (rx <= 0f) return
+        val digitColor = if (isDozing) aodColor else lockscreenColor
+        drawHaloShape(canvas, hoursWidth / 2f, extraTopSpace / 2f, rx, isDozing, haloPaint,
+            haloOval, if (haloUsesAccent) haloAccentFor(context, digitColor) else digitColor)
+    }
+

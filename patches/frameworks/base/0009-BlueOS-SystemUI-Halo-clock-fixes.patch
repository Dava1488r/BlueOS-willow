+package com.android.systemui.shared.clocks.view
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RectF
+import androidx.core.graphics.withSave
+
+// BlueOS Halo clock: the tilted halo of the BlueOS logo, drawn over the hours.
+
+/** Horizontal radius of the halo, as a part of the width of the hours */
+internal const val HALO_RX_FRACTION = 0.3f
+
+/** Room above the hours, as a part of the radius: tilted height (0.67) + stroke + gaps */
+internal const val HALO_SPACE_FRACTION = 1.1f
+
+private const val HALO_RY_FRACTION = 0.29f // same proportions as in the logo
+private const val HALO_ANGLE = -10f
+
+internal fun drawHaloShape(
+    canvas: Canvas,
+    cx: Float,
+    cy: Float,
+    rx: Float,
+    isDozing: Boolean,
+    paint: Paint,
+    oval: RectF,
+    color: Int,
+) {
+    val ry = rx * HALO_RY_FRACTION
+    paint.style = Paint.Style.STROKE
+    paint.isAntiAlias = true
+    paint.strokeWidth = rx * if (isDozing) 0.08f else 0.18f
+    paint.color = color
+    oval.set(cx - rx, cy - ry, cx + rx, cy + ry)
+    canvas.withSave {
+        rotate(HALO_ANGLE, cx, cy)
+        drawOval(oval, paint)
+    }
+}
+
+/** Accent tone that reads on the clock's background (light digits = dark background). */
+internal fun haloAccentFor(context: Context, digitColor: Int): Int =
+    context.getColor(
+        if (Color.luminance(digitColor) > 0.5f) android.R.color.system_accent1_200
+        else android.R.color.system_accent1_700
+    )

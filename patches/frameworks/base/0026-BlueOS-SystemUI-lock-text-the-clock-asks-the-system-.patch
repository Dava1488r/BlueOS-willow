-     * date light (like the clock, ClockEventController), the light theme follows the wallpaper under them;
-     * «По обоям»: always the wallpaper (0.5–0.7.1: dark on a light wallpaper even in the dark theme).
+     * BlueOS 0.7.2: «Цвет текста на блокировке» — «Всегда светлый» (default): the greeting and the date light on
+     * any wallpaper in both themes, like the clock (ClockEventController decides the same way); «По теме»: the dark
+     * theme keeps them light, the light theme follows the wallpaper under them; «По обоям»: always the wallpaper
+     * (0.5–0.7.1: dark on a light wallpaper even in the dark theme).
      */
     private void applyTextColor() {
         if (mRegionSampler == null) return;
@@ -112,10 +113,11 @@ public class KeyguardSliceViewController extends ViewController<KeyguardSliceVie
         final boolean dark = (android.content.res.Resources.getSystem().getConfiguration().uiMode
                 & android.content.res.Configuration.UI_MODE_NIGHT_MASK)
                 == android.content.res.Configuration.UI_MODE_NIGHT_YES;
-        final boolean byTheme = org.blueos.arona.BlueOSSettings.getInt(
+        final int textColor = org.blueos.arona.BlueOSSettings.getInt(
                 mView.getContext().getContentResolver(),
-                org.blueos.arona.BlueOSSettings.LOCK_TEXT_COLOR) == 0;
-        mView.setTextColor(dark && byTheme ? Color.WHITE : mRegionSampler.currentForegroundColor());
+                org.blueos.arona.BlueOSSettings.LOCK_TEXT_COLOR);
+        final boolean light = textColor == 2 || (textColor == 0 && dark);
+        mView.setTextColor(light ? Color.WHITE : mRegionSampler.currentForegroundColor());
     }
 
     Observer<Slice> mObserver = new Observer<Slice>() {

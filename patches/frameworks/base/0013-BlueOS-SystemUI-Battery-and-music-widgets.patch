+
+package com.android.systemui.blueos.widgets
+
+import android.app.PendingIntent
+import android.appwidget.AppWidgetManager
+import android.appwidget.AppWidgetProvider
+import android.content.BroadcastReceiver
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.graphics.Bitmap
+import android.media.MediaMetadata
+import android.media.session.MediaController
+import android.media.session.MediaSessionManager
+import android.media.session.PlaybackState
+import android.os.Handler
+import android.os.Looper
+import android.os.PowerManager
+import android.os.SystemClock
+import android.widget.RemoteViews
+import com.android.systemui.res.R
+
+/**
+ * BlueOS music widget for any player: the active media session's art, title and artist, a
+ * progress bar and previous / play-pause / next. In SystemUI, which may read and control all
+ * media sessions (MEDIA_CONTENT_CONTROL) and always runs.
+ */
+class BlueOSMediaWidgetProvider : AppWidgetProvider() {
+    override fun onReceive(context: Context, intent: Intent) {
+        super.onReceive(context, intent)
+        BlueOSMediaWidget.start(context)
+        BlueOSMediaWidget.onAction(intent.action)
+    }
+
+    override fun onUpdate(context: Context, wm: AppWidgetManager, widgetIds: IntArray) {
+        BlueOSMediaWidget.start(context)
+        BlueOSMediaWidget.push(context)
+    }
+}
+
+internal object BlueOSMediaWidget {
+    private const val ACTION_PLAY_PAUSE = "org.blueos.systemui.media.PLAY_PAUSE"
+    private const val ACTION_PREVIOUS = "org.blueos.systemui.media.PREVIOUS"
+    private const val ACTION_NEXT = "org.blueos.systemui.media.NEXT"
+    private const val PROGRESS_MAX = 1000
+    private const val PROGRESS_TICK_MILLIS = 5_000L
+    private const val ART_SIZE_PX = 192
+
+    private val handler = Handler(Looper.getMainLooper())
+    private var appContext: Context? = null
+    private var controller: MediaController? = null
+
+    private val controllerCallback =
+        object : MediaController.Callback() {
+            override fun onPlaybackStateChanged(state: PlaybackState?) {
+                appContext?.let { push(it) }
+            }
+
+            override fun onMetadataChanged(metadata: MediaMetadata?) {
+                appContext?.let { push(it) }
+            }
+
+            override fun onSessionDestroyed() {
+                appContext?.let { pickController(it) }
+            }
+        }
+
+    private val sessionsListener =
+        MediaSessionManager.OnActiveSessionsChangedListener {
+            appContext?.let { pickController(it) }
+        }
+
+    private val progressTick = Runnable { appContext?.let { push(it) } }
+
+    // The progress bar only ticks while the screen is on
+    private val screenOnReceiver =
+        object : BroadcastReceiver() {
+            override fun onReceive(context: Context, intent: Intent) {
+                push(context)
+            }
+        }
+
+    fun start(context: Context) {
+        if (appContext != null) return
+        val app = context.applicationContext
+        appContext = app
+        app.getSystemService(MediaSessionManager::class.java)
+            ?.addOnActiveSessionsChangedListener(sessionsListener, null, handler)
+        app.registerReceiver(
+            screenOnReceiver,
+            IntentFilter(Intent.ACTION_SCREEN_ON),
+            Context.RECEIVER_NOT_EXPORTED,
+        )
+        pickController(app)
+    }
+
+    /** The playing session, or else the most recent one. */
+    private fun pickController(context: Context) {
+        val sessions =
+            runCatching {
+                    context
+                        .getSystemService(MediaSessionManager::class.java)
+                        ?.getActiveSessions(null)
+                }
+                .getOrNull()
+                .orEmpty()
+        val next =
+            sessions.firstOrNull { it.playbackState?.state == PlaybackState.STATE_PLAYING }
+                ?: sessions.firstOrNull()
+        if (next?.sessionToken != controller?.sessionToken) {
+            controller?.unregisterCallback(controllerCallback)
+            controller = next
+            next?.registerCallback(controllerCallback, handler)
+        }
+        push(context)
+    }
+
+    fun onAction(action: String?) {
+        val current = controller ?: return
+        val controls = current.transportControls
+        when (action) {
+            ACTION_PLAY_PAUSE ->
+                if (current.playbackState?.state == PlaybackState.STATE_PLAYING) controls.pause()
+                else controls.play()
+            ACTION_PREVIOUS -> controls.skipToPrevious()
+            ACTION_NEXT -> controls.skipToNext()
+        }
+    }
+
+    fun push(context: Context) {
+        handler.removeCallbacks(progressTick)
+        val app = context.applicationContext
+        val wm = AppWidgetManager.getInstance(app)
+        val provider = ComponentName(app, BlueOSMediaWidgetProvider::class.java)
+        if (wm.getAppWidgetIds(provider).isEmpty()) return
+
+        val current = controller
+        val metadata = current?.metadata
+        val state = current?.playbackState
+        val playing = state?.state == PlaybackState.STATE_PLAYING
+        val title =
+            metadata?.getString(MediaMetadata.METADATA_KEY_TITLE)
+                ?: metadata?.description?.title?.toString()
+
+        val rv = RemoteViews(app.packageName, R.layout.blueos_media_widget)
+        if (title.isNullOrEmpty()) {
+            rv.setTextViewText(R.id.blueos_media_title, app.getString(R.string.blueos_media_widget_idle))
+            rv.setTextViewText(R.id.blueos_media_artist, "")
+        } else {
+            rv.setTextViewText(R.id.blueos_media_title, title)
+            rv.setTextViewText(
+                R.id.blueos_media_artist,
+                metadata?.getString(MediaMetadata.METADATA_KEY_ARTIST)
+                    ?: metadata?.getString(MediaMetadata.METADATA_KEY_ALBUM_ARTIST)
+                    ?: metadata?.description?.subtitle
+                    ?: "",
+            )
+        }
+
+        val art = metadata?.let { albumArt(it) }
+        if (art != null) {
+            rv.setImageViewBitmap(R.id.blueos_media_art, art)
+        } else {
+            rv.setImageViewResource(R.id.blueos_media_art, R.drawable.blueos_ic_music_note)
+        }
+
+        val duration = metadata?.getLong(MediaMetadata.METADATA_KEY_DURATION) ?: 0L
+        val position = state?.let { currentPosition(it) } ?: 0L
+        val progress =
+            if (duration > 0) (position.coerceIn(0, duration) * PROGRESS_MAX / duration).toInt()
+            else 0
+        rv.setProgressBar(R.id.blueos_media_progress, PROGRESS_MAX, progress, false)
+
+        rv.setImageViewResource(
+            R.id.blueos_media_play_pause,
+            if (playing) R.drawable.blueos_ic_pause else R.drawable.blueos_ic_play,
+        )
+        rv.setContentDescription(
+            R.id.blueos_media_play_pause,
+            app.getString(
+                if (playing) R.string.blueos_media_widget_pause else R.string.blueos_media_widget_play
+            ),
+        )
+        rv.setOnClickPendingIntent(R.id.blueos_media_play_pause, action(app, ACTION_PLAY_PAUSE, 1))
+        rv.setOnClickPendingIntent(R.id.blueos_media_previous, action(app, ACTION_PREVIOUS, 2))
+        rv.setOnClickPendingIntent(R.id.blueos_media_next, action(app, ACTION_NEXT, 3))
+        current?.sessionActivity?.let { rv.setOnClickPendingIntent(android.R.id.background, it) }
+
+        wm.updateAppWidget(provider, rv)
+
+        val interactive = app.getSystemService(PowerManager::class.java)?.isInteractive == true
+        if (playing && duration > 0 && interactive) {
+            handler.postDelayed(progressTick, PROGRESS_TICK_MILLIS)
+        }
+    }
+
+    private fun currentPosition(state: PlaybackState): Long {
+        if (state.state != PlaybackState.STATE_PLAYING) return state.position
+        val elapsed = SystemClock.elapsedRealtime() - state.lastPositionUpdateTime
+        return state.position + (elapsed * state.playbackSpeed).toLong()
+    }
+
+    /** The album art, scaled down: widget views travel to the launcher through binder. */
+    private fun albumArt(metadata: MediaMetadata): Bitmap? {
+        val art =
+            metadata.getBitmap(MediaMetadata.METADATA_KEY_ALBUM_ART)
+                ?: metadata.getBitmap(MediaMetadata.METADATA_KEY_ART)
+                ?: metadata.getBitmap(MediaMetadata.METADATA_KEY_DISPLAY_ICON)
+                ?: return null
+        if (art.width <= ART_SIZE_PX && art.height <= ART_SIZE_PX) return art
+        val scale = ART_SIZE_PX.toFloat() / maxOf(art.width, art.height)
+        return Bitmap.createScaledBitmap(
+            art,
+            (art.width * scale).toInt().coerceAtLeast(1),
+            (art.height * scale).toInt().coerceAtLeast(1),
+            true,
+        )
+    }
+
+    private fun action(context: Context, action: String, requestCode: Int): PendingIntent =
+        PendingIntent.getBroadcast(
+            context,
+            requestCode,
+            Intent(action).setClass(context, BlueOSMediaWidgetProvider::class.java),
+            PendingIntent.FLAG_IMMUTABLE,
+        )
+}

+package com.android.systemui.blueos.widgets
+
+import android.annotation.SuppressLint
+import android.app.PendingIntent
+import android.appwidget.AppWidgetManager
+import android.appwidget.AppWidgetProvider
+import android.bluetooth.BluetoothClass
+import android.bluetooth.BluetoothDevice
+import android.bluetooth.BluetoothManager
+import android.content.BroadcastReceiver
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.os.BatteryManager
+import android.view.View
+import android.widget.RemoteViews
+import com.android.systemui.res.R
+import java.text.NumberFormat
+
+/**
+ * BlueOS battery widget: the phone's charge as a ring, plus connected Bluetooth headphones. It
+ * lives in SystemUI because SystemUI always runs and can follow the battery without waking an app.
+ */
+class BlueOSBatteryWidgetProvider : AppWidgetProvider() {
+    override fun onUpdate(context: Context, wm: AppWidgetManager, widgetIds: IntArray) {
+        BlueOSBatteryWidget.start(context)
+        BlueOSBatteryWidget.push(context)
+    }
+}
+
+internal object BlueOSBatteryWidget {
+    private const val ACTION_BT_BATTERY_LEVEL_CHANGED =
+        "android.bluetooth.device.action.BATTERY_LEVEL_CHANGED"
+
+    private var started = false
+    private var level = -1
+    private var plugged = false
+
+    private val receiver =
+        object : BroadcastReceiver() {
+            override fun onReceive(context: Context, intent: Intent) {
+                if (intent.action == Intent.ACTION_BATTERY_CHANGED) {
+                    val scale = intent.getIntExtra(BatteryManager.EXTRA_SCALE, 100)
+                    val newLevel =
+                        intent.getIntExtra(BatteryManager.EXTRA_LEVEL, 0) * 100 /
+                            scale.coerceAtLeast(1)
+                    val newPlugged = intent.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0) != 0
+                    // The battery broadcast also fires for voltage and temperature changes
+                    if (newLevel == level && newPlugged == plugged) return
+                    level = newLevel
+                    plugged = newPlugged
+                }
+                push(context)
+            }
+        }
+
+    fun start(context: Context) {
+        if (started) return
+        started = true
+        val filter =
+            IntentFilter().apply {
+                addAction(Intent.ACTION_BATTERY_CHANGED)
+                addAction(ACTION_BT_BATTERY_LEVEL_CHANGED)
+                addAction(BluetoothDevice.ACTION_ACL_CONNECTED)
+                addAction(BluetoothDevice.ACTION_ACL_DISCONNECTED)
+            }
+        // Exported: the headset battery broadcasts come from the Bluetooth app, not the system
+        val app = context.applicationContext
+        app.registerReceiver(receiver, filter, Context.RECEIVER_EXPORTED)?.let {
+            receiver.onReceive(app, it)
+        }
+    }
+
+    fun push(context: Context) {
+        val app = context.applicationContext
+        val wm = AppWidgetManager.getInstance(app)
+        val provider = ComponentName(app, BlueOSBatteryWidgetProvider::class.java)
+        if (wm.getAppWidgetIds(provider).isEmpty() || level < 0) return
+
+        val rv = RemoteViews(app.packageName, R.layout.blueos_battery_widget)
+        rv.setProgressBar(R.id.blueos_battery_ring, 100, level, false)
+        rv.setTextViewText(R.id.blueos_battery_level, percent(level))
+        rv.setViewVisibility(R.id.blueos_battery_charging, if (plugged) View.VISIBLE else View.GONE)
+
+        val headset = headsetBatteryLevel(app)
+        rv.setViewVisibility(R.id.blueos_headset, if (headset >= 0) View.VISIBLE else View.GONE)
+        if (headset >= 0) rv.setTextViewText(R.id.blueos_headset_level, percent(headset))
+
+        val usage = Intent(Intent.ACTION_POWER_USAGE_SUMMARY)
+        rv.setOnClickPendingIntent(
+            android.R.id.background,
+            PendingIntent.getActivity(app, 0, usage, PendingIntent.FLAG_IMMUTABLE),
+        )
+        wm.updateAppWidget(provider, rv)
+    }
+
+    private fun percent(value: Int): String =
+        NumberFormat.getPercentInstance().format(value / 100.0)
+
+    /** Charge of the first connected audio device that reports one, or -1. */
+    @SuppressLint("MissingPermission")
+    private fun headsetBatteryLevel(context: Context): Int =
+        runCatching {
+                context
+                    .getSystemService(BluetoothManager::class.java)
+                    ?.adapter
+                    ?.bondedDevices
+                    ?.filter {
+                        it.isConnected &&
+                            it.bluetoothClass?.majorDeviceClass ==
+                                BluetoothClass.Device.Major.AUDIO_VIDEO
+                    }
+                    ?.map { it.batteryLevel }
+                    ?.firstOrNull { it >= 0 }
+            }
+            .getOrNull() ?: -1
+}
diff --git a/packages/SystemUI/src/com/android/systemui/blueos/widgets/BlueOSMediaWidgetProvider.kt b/packages/SystemUI/src/com/android/systemui/blueos/widgets/BlueOSMediaWidgetProvider.kt

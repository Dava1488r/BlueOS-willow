diff --git a/packages/SystemUI/res/layout/blueos_battery_widget.xml b/packages/SystemUI/res/layout/blueos_battery_widget.xml
new file mode 100644
index 000000000000..48c06949d300
--- /dev/null
+++ b/packages/SystemUI/res/layout/blueos_battery_widget.xml
@@ -0,0 +1,78 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- BlueOS battery widget: phone charge ring, charging bolt, Bluetooth headphones -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@android:id/background"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@drawable/blueos_widget_card"
+    android:gravity="center"
+    android:orientation="vertical"
+    android:padding="10dp">
+
+    <FrameLayout
+        android:layout_width="72dp"
+        android:layout_height="72dp">
+
+        <ProgressBar
+            android:id="@+id/blueos_battery_ring"
+            style="?android:attr/progressBarStyleHorizontal"
+            android:layout_width="match_parent"
+            android:layout_height="match_parent"
+            android:indeterminate="false"
+            android:max="100"
+            android:progressDrawable="@drawable/blueos_battery_ring" />
+
+        <TextView
+            android:id="@+id/blueos_battery_level"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_gravity="center"
+            android:fontFamily="blueos-clock"
+            android:fontVariationSettings="'wght' 600"
+            android:includeFontPadding="false"
+            android:singleLine="true"
+            android:textColor="@color/blueos_widget_on_surface"
+            android:textSize="16sp" />
+    </FrameLayout>
+
+    <LinearLayout
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="6dp"
+        android:gravity="center_vertical"
+        android:orientation="horizontal">
+
+        <ImageView
+            android:id="@+id/blueos_battery_charging"
+            android:layout_width="14dp"
+            android:layout_height="14dp"
+            android:contentDescription="@string/blueos_battery_widget_charging"
+            android:src="@drawable/blueos_ic_bolt"
+            android:visibility="gone" />
+
+        <LinearLayout
+            android:id="@+id/blueos_headset"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="6dp"
+            android:gravity="center_vertical"
+            android:orientation="horizontal"
+            android:visibility="gone">
+
+            <ImageView
+                android:layout_width="14dp"
+                android:layout_height="14dp"
+                android:contentDescription="@string/blueos_battery_widget_headphones"
+                android:src="@drawable/blueos_ic_headphones" />
+
+            <TextView
+                android:id="@+id/blueos_headset_level"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_marginStart="3dp"
+                android:singleLine="true"
+                android:textColor="@color/blueos_widget_on_surface_variant"
+                android:textSize="12sp" />
+        </LinearLayout>
+    </LinearLayout>
+</LinearLayout>
diff --git a/packages/SystemUI/res/layout/blueos_media_widget.xml b/packages/SystemUI/res/layout/blueos_media_widget.xml
new file mode 100644
index 000000000000..c3eadd692136
--- /dev/null
+++ b/packages/SystemUI/res/layout/blueos_media_widget.xml
@@ -0,0 +1,100 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- BlueOS music widget: art, title, artist, progress, previous / play-pause / next -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@android:id/background"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@drawable/blueos_widget_card"
+    android:gravity="center_vertical"
+    android:orientation="vertical"
+    android:padding="14dp">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:gravity="center_vertical"
+        android:orientation="horizontal">
+
+        <ImageView
+            android:id="@+id/blueos_media_art"
+            android:layout_width="48dp"
+            android:layout_height="48dp"
+            android:background="@drawable/blueos_media_art_bg"
+            android:clipToOutline="true"
+            android:contentDescription="@null"
+            android:scaleType="centerCrop"
+            android:src="@drawable/blueos_ic_music_note" />
+
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="12dp"
+            android:orientation="vertical">
+
+            <TextView
+                android:id="@+id/blueos_media_title"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:ellipsize="end"
+                android:singleLine="true"
+                android:text="@string/blueos_media_widget_idle"
+                android:textColor="@color/blueos_widget_on_surface"
+                android:textSize="14sp" />
+
+            <TextView
+                android:id="@+id/blueos_media_artist"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:ellipsize="end"
+                android:singleLine="true"
+                android:textColor="@color/blueos_widget_on_surface_variant"
+                android:textSize="12sp" />
+        </LinearLayout>
+    </LinearLayout>
+
+    <ProgressBar
+        android:id="@+id/blueos_media_progress"
+        style="?android:attr/progressBarStyleHorizontal"
+        android:layout_width="match_parent"
+        android:layout_height="4dp"
+        android:layout_marginTop="12dp"
+        android:indeterminate="false"
+        android:max="1000"
+        android:progressDrawable="@drawable/blueos_media_progress" />
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="8dp"
+        android:gravity="center"
+        android:orientation="horizontal">
+
+        <ImageView
+            android:id="@+id/blueos_media_previous"
+            android:layout_width="40dp"
+            android:layout_height="40dp"
+            android:background="?android:attr/selectableItemBackgroundBorderless"
+            android:contentDescription="@string/blueos_media_widget_previous"
+            android:padding="8dp"
+            android:src="@drawable/blueos_ic_skip_previous" />
+
+        <ImageView
+            android:id="@+id/blueos_media_play_pause"
+            android:layout_width="44dp"
+            android:layout_height="44dp"
+            android:layout_marginHorizontal="24dp"
+            android:background="@drawable/blueos_media_play_bg"
+            android:contentDescription="@string/blueos_media_widget_play"
+            android:padding="10dp"
+            android:src="@drawable/blueos_ic_play" />
+
+        <ImageView
+            android:id="@+id/blueos_media_next"
+            android:layout_width="40dp"
+            android:layout_height="40dp"
+            android:background="?android:attr/selectableItemBackgroundBorderless"
+            android:contentDescription="@string/blueos_media_widget_next"
+            android:padding="8dp"
+            android:src="@drawable/blueos_ic_skip_next" />
+    </LinearLayout>
+</LinearLayout>

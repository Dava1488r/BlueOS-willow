From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GDmio <zhalin66@gmail.com>
Date: Sat, 24 Oct 2026 12:56:07 +0200
Subject: [PATCH 06/30] BlueOS: SystemUI: Follow the chosen low battery sound

The battery notification channel baked Settings.Global.LOW_BATTERY_SOUND in once. Its id now follows the sound and the channel is recreated when the setting changes.

Change-Id: I54ec2a80b7a914f1f13292110ad5eeda3afa7600
---
 .../systemui/util/NotificationChannels.java   | 40 +++++++++++++++++--
 1 file changed, 36 insertions(+), 4 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/util/NotificationChannels.java b/packages/SystemUI/src/com/android/systemui/util/NotificationChannels.java
index 1976a084647e..51851397da27 100644
--- a/packages/SystemUI/src/com/android/systemui/util/NotificationChannels.java
+++ b/packages/SystemUI/src/com/android/systemui/util/NotificationChannels.java
@@ -18,9 +18,13 @@ import android.app.NotificationChannel;
 import android.app.NotificationManager;
 import android.content.Context;
 import android.content.pm.PackageManager;
+import android.database.ContentObserver;
 import android.media.AudioAttributes;
 import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
 import android.provider.Settings;
+import android.text.TextUtils;
 
 import com.android.internal.annotations.VisibleForTesting;
 import com.android.systemui.CoreStartable;
@@ -30,6 +34,7 @@ import com.android.systemui.screenrecord.notification.ScreenRecordingServiceNoti
 import com.android.wm.shell.pip.tv.TvPipNotificationController;
 
 import java.util.Arrays;
+import java.util.Objects;
 
 import javax.inject.Inject;
 
@@ -43,6 +48,7 @@ public class NotificationChannels implements CoreStartable {
     static String GENERAL     = "GEN";
     public static String STORAGE     = "DSK";
     public static String BATTERY     = "BAT";
+    private static final String BATTERY_CHANNEL_PREFIX = "BAT_";
     public static String TVPIP       = TvPipNotificationController.NOTIFICATION_CHANNEL; // "TVPIP"
     public static String HINTS       = "HNT";
     public static String INSTANT     = "INS";
@@ -57,15 +63,33 @@ public class NotificationChannels implements CoreStartable {
 
     public static void createAll(Context context) {
         final NotificationManager nm = context.getSystemService(NotificationManager.class);
+        final String soundPath = Settings.Global.getString(context.getContentResolver(),
+                Settings.Global.LOW_BATTERY_SOUND);
+        // BlueOS: a channel's sound can't change once it exists, so the battery channel id
+        // follows the low battery sound chosen in Settings > Sound > Charging sounds
+        BATTERY = BATTERY_CHANNEL_PREFIX + Integer.toHexString(Objects.hashCode(soundPath));
+        for (NotificationChannel channel : nm.getNotificationChannels()) {
+            final String id = channel.getId();
+            if ((id.equals("BAT") || id.startsWith(BATTERY_CHANNEL_PREFIX))
+                    && !id.equals(BATTERY)) {
+                nm.deleteNotificationChannel(id);
+            }
+        }
         final NotificationChannel batteryChannel = new NotificationChannel(BATTERY,
                 context.getString(R.string.notification_channel_battery),
                 NotificationManager.IMPORTANCE_MAX);
-        final String soundPath = Settings.Global.getString(context.getContentResolver(),
-                Settings.Global.LOW_BATTERY_SOUND);
-        batteryChannel.setSound(Uri.parse("file://" + soundPath), new AudioAttributes.Builder()
+        final AudioAttributes batteryAudio = new AudioAttributes.Builder()
                 .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
                 .setUsage(AudioAttributes.USAGE_NOTIFICATION_EVENT)
-                .build());
+                .build();
+        if (TextUtils.isEmpty(soundPath) || "silent".equals(soundPath)) {
+            batteryChannel.setSound(null, batteryAudio);
+        } else {
+            // a file path (SettingsProvider default) or a media URI from the sound picker
+            final Uri soundUri = Uri.parse(soundPath);
+            batteryChannel.setSound(soundUri.isAbsolute() ? soundUri
+                    : Uri.parse("file://" + soundPath), batteryAudio);
+        }
         batteryChannel.setBlockable(true);
 
         final NotificationChannel alerts = new NotificationChannel(
@@ -152,6 +176,14 @@ public class NotificationChannels implements CoreStartable {
     public void start() {
         createAll(mContext);
         cleanUp();
+        mContext.getContentResolver().registerContentObserver(
+                Settings.Global.getUriFor(Settings.Global.LOW_BATTERY_SOUND), false,
+                new ContentObserver(new Handler(Looper.getMainLooper())) {
+                    @Override
+                    public void onChange(boolean selfChange) {
+                        createAll(mContext);
+                    }
+                });
     }
 
     private void cleanUp() {

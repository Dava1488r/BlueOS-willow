diff --git a/packages/SystemUI/src/com/android/systemui/blueos/media/BlueOSMediaGlass.kt b/packages/SystemUI/src/com/android/systemui/blueos/media/BlueOSMediaGlass.kt
new file mode 100644
index 000000000000..e00607b3c8f8
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/blueos/media/BlueOSMediaGlass.kt
@@ -0,0 +1,138 @@
+package com.android.systemui.blueos.media
+
+import android.content.Context
+import android.content.res.ColorStateList
+import android.content.res.Configuration
+import android.graphics.Color
+import android.graphics.drawable.Drawable
+import android.graphics.drawable.GradientDrawable
+import android.graphics.drawable.LayerDrawable
+import android.view.View
+import android.widget.ImageView
+import android.widget.TextView
+import com.android.systemui.media.controls.ui.view.MediaViewHolder
+import com.android.systemui.res.R
+import java.util.WeakHashMap
+import org.blueos.arona.BlueOSSettings as K
+
+/**
+ * BlueOS 0.7.2: a track without a cover gets the home widgets' glass — the wallpaper blurred under the card,
+ * a see-through card of the Monet surface colour (the widgets' transparency slider), a thin edge, text and
+ * buttons in the system palette. Before, Android took the colours of the app's icon, and the near-black icon of
+ * «Музыка» made a black player. With a cover nothing changes (the cover and its colours, as before).
+ */
+object BlueOSMediaGlass {
+    class Colors(
+        val fill: Int, val edge: Int, val fg: Int, val fg2: Int, val primary: Int, val onPrimary: Int,
+        val chip: Int, val onChip: Int, val rest: Int,
+    )
+
+    private fun dark(c: Context) =
+        (c.resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES
+    private fun alpha(color: Int, a: Float) = (color and 0x00ffffff) or ((a.coerceIn(0f, 1f) * 255).toInt() shl 24)
+
+    @JvmStatic
+    fun colors(c: Context): Colors {
+        val d = dark(c)
+        fun col(light: Int, dark: Int) = c.getColor(if (d) dark else light)
+        val opacity = 1f - K.int(c.contentResolver, K.WIDGET_TRANSPARENCY).coerceIn(0, 100) / 100f
+        val card = col(android.R.color.system_surface_container_light, android.R.color.system_surface_container_dark)
+        val onS = col(android.R.color.system_on_surface_light, android.R.color.system_on_surface_dark)
+        val onSV = col(android.R.color.system_on_surface_variant_light, android.R.color.system_on_surface_variant_dark)
+        return Colors(
+            fill = alpha(card, 0.65f * opacity),                     // = the widgets' glass
+            edge = alpha(onS, 0.16f),
+            fg = onS, fg2 = onSV,
+            primary = col(android.R.color.system_primary_light, android.R.color.system_primary_dark),
+            onPrimary = col(android.R.color.system_on_primary_light, android.R.color.system_on_primary_dark),
+            chip = col(android.R.color.system_secondary_container_light, android.R.color.system_secondary_container_dark),
+            onChip = col(android.R.color.system_on_secondary_container_light,
+                android.R.color.system_on_secondary_container_dark),
+            rest = alpha(onSV, 0.3f),
+        )
+    }
+
+    /** What the views had before the glass, to give it back when a cover arrives. */
+    private class Original(
+        val title: ColorStateList?, val artist: ColorStateList?, val elapsed: ColorStateList?, val total: ColorStateList?,
+        val actions: List<ColorStateList?>, val progress: ColorStateList?, val thumb: ColorStateList?,
+        val playerBg: Drawable?, val albumFg: Drawable?,
+    )
+    private val originals = WeakHashMap<View, Original>()
+
+    private fun actions(h: MediaViewHolder): List<ImageView> =
+        listOf(h.actionPrev, h.actionNext, h.action0, h.action1, h.action2, h.action3, h.action4)
+
+    /**
+     * Dresses the player for [g] (a track without a cover) or gives back its own look (null). Called on the main
+     * thread after the colour scheme was updated; the blur needs the window, so it waits for the attach.
+     */
+    @JvmStatic
+    fun apply(h: MediaViewHolder, g: Colors?) {
+        val player: View = h.player
+        val texts = listOf(h.titleText, h.artistText, h.scrubbingElapsedTimeView, h.scrubbingTotalTimeView)
+        if (g == null) {
+            val o = originals.remove(player) ?: return
+            listOf(o.title, o.artist, o.elapsed, o.total).forEachIndexed { i, c -> c?.let { texts[i].setTextColor(it) } }
+            actions(h).forEachIndexed { i, b -> b.imageTintList = o.actions[i] }
+            h.seekBar.progressTintList = o.progress
+            h.seekBar.thumbTintList = o.thumb
+            player.background = o.playerBg
+            h.albumView.foreground = o.albumFg
+            return
+        }
+        if (!originals.containsKey(player)) {
+            originals[player] = Original(
+                h.titleText.textColors, h.artistText.textColors,
+                h.scrubbingElapsedTimeView.textColors, h.scrubbingTotalTimeView.textColors,
+                actions(h).map { it.imageTintList }, h.seekBar.progressTintList, h.seekBar.thumbTintList,
+                player.background, h.albumView.foreground)
+        }
+        val c = player.context
+        h.titleText.setTextColor(g.fg)
+        h.artistText.setTextColor(g.fg2)
+        h.scrubbingElapsedTimeView.setTextColor(g.fg2)
+        h.scrubbingTotalTimeView.setTextColor(g.fg2)
+        val buttons = ColorStateList(
+            arrayOf(intArrayOf(-android.R.attr.state_enabled), intArrayOf()),
+            intArrayOf(alpha(g.fg, 0.38f), g.fg))
+        actions(h).forEach { it.imageTintList = buttons }
+        h.seekBar.progressTintList = ColorStateList.valueOf(g.primary)
+        h.seekBar.thumbTintList = ColorStateList.valueOf(g.primary)
+        val r = c.resources.getDimension(R.dimen.notification_corner_radius)
+        h.albumView.foreground = GradientDrawable().apply {
+            cornerRadius = r
+            setColor(Color.TRANSPARENT)
+            setStroke(c.resources.displayMetrics.density.toInt().coerceAtLeast(1), g.edge)
+        }
+        val base = originals[player]?.playerBg
+        fun blur() {
+            val d = blurDrawable(player, r) ?: return
+            player.background = if (base == null) d else LayerDrawable(arrayOf(d, base))
+        }
+        if (player.isAttachedToWindow) blur()
+        else player.addOnAttachStateChangeListener(object : View.OnAttachStateChangeListener {
+            override fun onViewAttachedToWindow(v: View) {
+                v.removeOnAttachStateChangeListener(this)
+                if (originals.containsKey(v)) blur()
+            }
+            override fun onViewDetachedFromWindow(v: View) {}
+        })
+    }
+
+    /** The widgets' blur: «Размытие под виджетами», glass always a little (BlueOSMaterial.blurRadius). */
+    private fun blurDrawable(view: View, cornerRadius: Float): Drawable? {
+        val c = view.context
+        val p = maxOf(K.int(c.contentResolver, K.WIDGET_BLUR).coerceIn(0, 100), 15)
+        val radius = (p / 100f * 50f * c.resources.displayMetrics.density).toInt()
+        return try {
+            view.viewRootImpl?.createBackgroundBlurDrawable()?.apply {
+                setBlurRadius(radius)
+                setCornerRadius(cornerRadius)
+                setColor(Color.TRANSPARENT)
+            }
+        } catch (t: Throwable) {
+            null
+        }
+    }
+}

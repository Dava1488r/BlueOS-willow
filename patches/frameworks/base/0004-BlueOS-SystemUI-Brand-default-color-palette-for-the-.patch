                 Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES,
-                currentUser);
+                currentUser));
         if (DEBUG) Log.d(TAG, "updateThemeOverlays. Setting: " + overlayPackageJson);
         final Map<String, OverlayIdentifier> categoryToPackage = new ArrayMap<>();

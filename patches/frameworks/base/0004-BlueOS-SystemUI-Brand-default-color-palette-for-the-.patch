 import android.os.UserHandle;
 import android.os.UserManager;
 import android.provider.Settings;
@@ -128,6 +129,8 @@ import javax.inject.Inject;
 public class ThemeOverlayController implements CoreStartable, Dumpable {
     protected static final String TAG = "ThemeOverlayController";
     private static final boolean DEBUG = false;
+    // BlueOS brand color "Голубой BA"
+    private static final String BLUEOS_DEFAULT_SEED_COLOR = "128AFA";
 
     private static final String KEY_COLOR_PALETTE_VERSION = "global_color_palette_version";
 
@@ -357,6 +360,13 @@ public class ThemeOverlayController implements CoreStartable, Dumpable {
         String overlayPackageJson = mSecureSettings.getStringForUser(
                 Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES,
                 currentUser);
+        if (TextUtils.isEmpty(overlayPackageJson)) {
+            // BlueOS: first wallpaper event on fresh data - store the brand color as a preset
+            // so the wallpaper doesn't take over and Wallpaper & style shows it as chosen
+            overlayPackageJson = withBlueOSDefaultColors(overlayPackageJson);
+            mSecureSettings.putStringForUser(Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES,
+                    overlayPackageJson, UserHandle.USER_CURRENT);
+        }
         boolean isDestinationBoth = (flags == (WallpaperManager.FLAG_SYSTEM
                 | WallpaperManager.FLAG_LOCK));
         boolean isDestinationHomeOnly = (flags == WallpaperManager.FLAG_SYSTEM);
@@ -726,6 +736,50 @@ public class ThemeOverlayController implements CoreStartable, Dumpable {
         assignColorsToOverlay(mDynamicOverlay, DynamicColors.getFixedColorsMapped());
         // Custom Colors
         assignColorsToOverlay(mDynamicOverlay, DynamicColors.getCustomColorsMapped());
+
+        publishBootAnimationColors();
+    }
+
+    /**
+     * BlueOS: hand the palette to the boot animation ("dynamic_colors" in its desc.txt, see
+     * frameworks/base/cmds/bootanimation/FORMAT.md). The BlueOS animations use:
+     * 1 = accent on a light background, 2 = accent on a dark background,
+     * 3 = text on a light background, 4 = white.
+     */
+    private void publishBootAnimationColors() {
+        final MaterialDynamicColors dynamicColors = new MaterialDynamicColors();
+        final int[] colors = {
+                dynamicColors.primary().getArgb(mLightColorScheme.getMaterialScheme()),
+                dynamicColors.primary().getArgb(mDarkColorScheme.getMaterialScheme()),
+                dynamicColors.onSurface().getArgb(mLightColorScheme.getMaterialScheme()),
+                Color.WHITE,
+        };
+        for (int i = 0; i < colors.length; i++) {
+            final String key = "persist.bootanim.color" + (i + 1);
+            final String value = String.valueOf(colors[i]);
+            if (value.equals(SystemProperties.get(key))) continue;
+            try {
+                SystemProperties.set(key, value);
+            } catch (RuntimeException e) {
+                Log.w(TAG, "Can't set " + key, e);
+            }
+        }
+    }
+
+    /**
+     * BlueOS: until the user picks colors in Wallpaper & style, the system uses the brand
+     * color ("Голубой BA") instead of the wallpaper's.
+     */
+    private static String withBlueOSDefaultColors(String overlayPackageJson) {
+        if (!TextUtils.isEmpty(overlayPackageJson)) return overlayPackageJson;
+        try {
+            return new JSONObject()
+                    .put(OVERLAY_COLOR_SOURCE, COLOR_SOURCE_PRESET)
+                    .put(OVERLAY_CATEGORY_SYSTEM_PALETTE, BLUEOS_DEFAULT_SEED_COLOR)
+                    .toString();
+        } catch (JSONException e) {
+            return overlayPackageJson;
+        }
     }
 
     private void assignColorsToOverlay(FabricatedOverlay overlay,
@@ -785,9 +839,9 @@ public class ThemeOverlayController implements CoreStartable, Dumpable {

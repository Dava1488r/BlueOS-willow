+    /**
+     * 0.7.1: what the chip must not cover, measured from the real views (in chip-layer px): every visible piece
+     * of the lock screen (clock incl. its halo, greeting, date, fingerprint, shortcuts, indication) and the
+     * notification cards that are really there.
+     */
+    private fun avoidRects(): List<RectF> {
+        val out = mutableListOf<RectF>()
+        val origin = IntArray(2).also { chipLayer.getLocationInWindow(it) }
+        val loc = IntArray(2)
+        fun add(v: View, h: Float, extraTop: Float) {
+            v.getLocationInWindow(loc)
+            val x = (loc[0] - origin[0]).toFloat()
+            val y = (loc[1] - origin[1]).toFloat()
+            out += RectF(x, y - extraTop, x + v.width, y + h)
+        }
+        val root = parent as? ViewGroup ?: return out
+        for (i in 0 until root.childCount) {
+            val v = root.getChildAt(i)
+            if (v === this || !v.isShown || v.alpha < 0.05f || v.width == 0 || v.height == 0) continue
+            if (v.width >= root.width * 0.9f && v.height >= root.height * 0.6f) continue      // full-screen layers
+            val name = if (v.id != View.NO_ID) runCatching { resources.getResourceEntryName(v.id) }.getOrNull() else null
+            if (name == "nssl_placeholder") continue                    // an empty box; the real cards are below
+            add(v, v.height.toFloat(), if (name?.startsWith("lockscreen_clock_view") == true) 40 * dp else 0f)
+        }
+        rootView.findViewById<ViewGroup>(R.id.notification_stack_scroller)?.let { nssl ->
+            for (i in 0 until nssl.childCount) {
+                val c = nssl.getChildAt(i) as? ExpandableView ?: continue
+                if (c.visibility != VISIBLE || c.actualHeight <= 0 || c.alpha < 0.05f) continue
+                add(c, c.actualHeight.toFloat(), 0f)
+            }
+        }
+        return out
+    }
 

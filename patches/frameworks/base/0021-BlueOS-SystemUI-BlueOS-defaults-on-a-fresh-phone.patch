+package com.android.systemui.blueos
+
+import android.app.UiModeManager
+import android.content.Context
+import android.provider.Settings
+import android.util.Log
+import org.json.JSONObject
+
+/**
+ * BlueOS defaults that live in settings rather than resources: applied once, on a fresh phone
+ * (before the setup wizard finishes), so an update never overrides what the user chose.
+ * Light theme, the brand palette "Голубой BA" with "Яркие цвета", always-on display, widget
+ * cards 15 % transparent.
+ */
+object BlueOSDefaults {
+    private const val TAG = "BlueOSDefaults"
+    private const val KEY_APPLIED = "blueos_defaults_version"
+    private const val VERSION = 1
+
+    fun applyOnce(context: Context) {
+        val cr = context.contentResolver
+        if (Settings.Secure.getInt(cr, KEY_APPLIED, 0) >= VERSION) return
+        val fresh = Settings.Secure.getInt(cr, Settings.Secure.USER_SETUP_COMPLETE, 0) == 0
+        if (fresh) {
+            try {
+                if (Settings.Secure.getString(
+                        cr, Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES).isNullOrEmpty()) {
+                    Settings.Secure.putString(
+                        cr,
+                        Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES,
+                        JSONObject()
+                            .put("android.theme.customization.system_palette", "128AFA")
+                            .put("android.theme.customization.accent_color", "128AFA")
+                            .put("android.theme.customization.color_source", "preset")
+                            .put("android.theme.customization.color_index", "1")
+                            .put("android.theme.customization.theme_style", "VIBRANT")
+                            .toString(),
+                    )
+                }
+                Settings.Secure.putInt(cr, Settings.Secure.DOZE_ALWAYS_ON, 1)
+                Settings.Secure.putInt(cr, "blueos_widget_transparency", 15)
+                context
+                    .getSystemService(UiModeManager::class.java)
+                    ?.setNightMode(UiModeManager.MODE_NIGHT_NO)
+            } catch (e: RuntimeException) {
+                Log.w(TAG, "Can't apply the defaults", e)
+                return
+            }
+        }
+        // Updated phones keep their settings; mark them too, so this never runs again
+        Settings.Secure.putInt(cr, KEY_APPLIED, VERSION)
+    }
+}

diff --git a/packages/SystemUI/src/com/android/systemui/blueos/lockscreen/BlueOSCharacterSection.kt b/packages/SystemUI/src/com/android/systemui/blueos/lockscreen/BlueOSCharacterSection.kt
new file mode 100644
index 000000000000..5675e7419c30
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/blueos/lockscreen/BlueOSCharacterSection.kt
@@ -0,0 +1,325 @@
+package com.android.systemui.blueos.lockscreen
+
+import android.animation.ValueAnimator
+import android.content.Context
+import android.graphics.RectF
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.service.notification.NotificationListenerService.RankingMap
+import android.service.notification.StatusBarNotification
+import android.view.Choreographer
+import android.view.MotionEvent
+import android.view.View
+import android.view.animation.PathInterpolator
+import android.widget.FrameLayout
+import androidx.constraintlayout.widget.ConstraintLayout
+import androidx.constraintlayout.widget.ConstraintSet
+import com.android.systemui.dagger.qualifiers.Application
+import com.android.systemui.keyguard.domain.interactor.KeyguardInteractor
+import com.android.systemui.keyguard.shared.model.KeyguardSection
+import com.android.systemui.power.domain.interactor.PowerInteractor
+import com.android.systemui.res.R
+import com.android.systemui.shared.clocks.view.BlueOSHaloLive
+import com.android.systemui.statusbar.NotificationListener
+import java.util.Calendar
+import javax.inject.Inject
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.launch
+import org.blueos.arona.AronaReplies
+import org.blueos.arona.AronaTouch
+import org.blueos.arona.AronaView
+import org.blueos.arona.BlueOSMotion
+import org.blueos.arona.BlueOSSettings as K
+import org.blueos.arona.ReplyChip
+
+/**
+ * BlueOS 0.7: live Arona on the lock screen (approved mockup 2). Added first to the keyguard root, so the
+ * clock, fingerprint circle, shortcuts — and the notifications (drawn above the keyguard root) — are over her.
+ * Modes: next to the clock, by the fingerprint, lobby, dynamic (grows with taps/pats) and custom.
+ */
+class BlueOSCharacterSection
+@Inject
+constructor(
+    private val keyguardInteractor: KeyguardInteractor,
+    private val powerInteractor: PowerInteractor,
+    notificationListener: NotificationListener,
+    @Application private val scope: CoroutineScope,
+) : KeyguardSection() {
+    private var host: AronaHost? = null
+    private val jobs = mutableListOf<Job>()
+
+    init {
+        notificationListener.addNotificationHandler(object : NotificationListener.NotificationHandler {
+            override fun onNotificationPosted(sbn: StatusBarNotification, rankingMap: RankingMap?) {
+                if (!sbn.isOngoing && !sbn.notification.isGroupSummary) host?.onNotification()
+            }
+            override fun onNotificationRemoved(sbn: StatusBarNotification, rankingMap: RankingMap?) {}
+            override fun onNotificationRemoved(sbn: StatusBarNotification, rankingMap: RankingMap?, reason: Int) {}
+            override fun onNotificationRankingUpdate(rankingMap: RankingMap?) {}
+            override fun onNotificationsInitialized() {}
+        })
+    }
+
+    override fun addViews(constraintLayout: ConstraintLayout) {
+        if (constraintLayout.findViewById<View>(R.id.blueos_arona_host) != null) return
+        val h = AronaHost(constraintLayout.context).apply { id = R.id.blueos_arona_host }
+        constraintLayout.addView(h, 0)         // lowest: everything else on the lock screen is above her
+        host = h
+    }
+
+    override fun bindData(constraintLayout: ConstraintLayout) {
+        jobs.forEach { it.cancel() }
+        jobs.clear()
+        jobs += scope.launch { keyguardInteractor.isDozing.collect { host?.dozing = it } }
+        jobs += scope.launch { keyguardInteractor.isKeyguardShowing.collect { host?.showing = it } }
+        jobs += scope.launch { powerInteractor.isAwake.collect { host?.awake = it } }
+    }
+
+    override fun applyConstraints(constraintSet: ConstraintSet) {
+        val id = R.id.blueos_arona_host
+        constraintSet.apply {
+            constrainWidth(id, ConstraintSet.MATCH_CONSTRAINT)
+            constrainHeight(id, ConstraintSet.MATCH_CONSTRAINT)
+            connect(id, ConstraintSet.TOP, ConstraintSet.PARENT_ID, ConstraintSet.TOP)
+            connect(id, ConstraintSet.BOTTOM, ConstraintSet.PARENT_ID, ConstraintSet.BOTTOM)
+            connect(id, ConstraintSet.START, ConstraintSet.PARENT_ID, ConstraintSet.START)
+            connect(id, ConstraintSet.END, ConstraintSet.PARENT_ID, ConstraintSet.END)
+        }
+    }
+
+    override fun removeViews(constraintLayout: ConstraintLayout) {
+        jobs.forEach { it.cancel() }
+        jobs.clear()
+        host?.release()
+        constraintLayout.findViewById<View>(R.id.blueos_arona_host)?.let { constraintLayout.removeView(it) }
+        host = null
+    }
+}
+
+/** Full-screen, transparent host: Arona + her reply chip. Touches that miss her pass through. */
+private class AronaHost(context: Context) : FrameLayout(context), BlueOSMotion.Listener, Choreographer.FrameCallback {
+    private val cr = context.contentResolver
+    private val dp = resources.displayMetrics.density
+    private val handler = Handler(Looper.getMainLooper())
+    private val arona = AronaView(context)
+    private val chip = ReplyChip(context)
+    private val touch = AronaTouch(arona, this, chip, avoid = ::avoidRects, isNight = ::night, touched = ::touched)
+    private val unobserve: () -> Unit
+    private var motion: (() -> Unit)? = null
+
+    // where she stands, as fractions of the screen: centre x, top, height (measured on the phone, mockup 2)
+    private data class Place(val cx: Float, val top: Float, val h: Float)
+    private val clock = Place(926f / 1080, 150f / 2400, 470f / 2400)
+    private val fingerprint = Place(866f / 1080, 1475f / 2400, 700f / 2400)
+    private val lobby = Place(540f / 1080, 640f / 2400, 2700f / 2400)
+    private var shown = clock
+    private var anim: ValueAnimator? = null
+
+    // dynamic mode
+    private var touches = 0
+    private var level = 0
+    private val shrink = Runnable { setLevel(0) }
+    private val quick = ArrayDeque<Long>()
+    private var lastGreeting = 0L
+
+    var dozing = false
+        set(v) { field = v; update() }
+    var showing = false
+        set(v) { field = v; update() }
+    var awake = true
+        set(v) {
+            val woke = v && !field
+            field = v
+            if (!v) setLevel(0)                                          // screen off: back to small
+            update()
+            if (woke) onWake()
+        }
+
+    init {
+        clipChildren = false
+        addView(arona, LayoutParams(0, 0))
+        addView(chip, LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT))
+        arona.tilt = { if (K.on(cr, K.ARONA_TILT)) BlueOSMotion.tilt else null }
+        arona.onReady = { update() }
+        unobserve = K.observe(context, listOf(K.ARONA_SHOW, K.ARONA_MODE, K.ARONA_CUSTOM, K.ARONA_SLEEP, K.ARONA_AOD)) {
+            setLevel(0); update()
+        }
+    }
+
+    fun release() {
+        unobserve()
+        motion?.invoke()
+        motion = null
+        Choreographer.getInstance().removeFrameCallback(this)
+    }
+
+    private fun mode() = K.int(cr, K.ARONA_MODE)
+
+    private fun night(): Boolean {
+        if (!K.on(cr, K.ARONA_SLEEP)) return false
+        val h = Calendar.getInstance().get(Calendar.HOUR_OF_DAY)
+        return h >= 23 || h < 7
+    }
+
+    private fun target(): Place = when (mode()) {
+        0 -> clock
+        1 -> fingerprint
+        2 -> lobby
+        4 -> K.string(cr, K.ARONA_CUSTOM, "").split(';').mapNotNull { it.toFloatOrNull() }
+            .takeIf { it.size == 3 }?.let { Place(it[0], it[1], it[2]) } ?: Place(0.52f, 0.46f, 0.46f)
+        else -> listOf(clock, fingerprint, lobby)[level]
+    }
+
+    private fun update() {
+        // the host stays for the halo's touch even when Arona is off
+        visibility = if (showing) VISIBLE else INVISIBLE
+        val show = K.on(cr, K.ARONA_SHOW) && showing && (!dozing || K.on(cr, K.ARONA_AOD))
+        arona.visibility = if (show) VISIBLE else INVISIBLE
+        arona.frozen = dozing
+        // AOD: a still, faint silhouette in the palette's light accent (follows any wallpaper)
+        arona.silhouette = if (dozing) (context.getColor(android.R.color.system_accent1_100) and 0x00ffffff) or 0x38000000 else null
+        arona.setSleeping(night())
+        moveTo(target())
+        // sensors only while the lock screen is visible and the screen is on (Arona and the halo use them)
+        val sensors = showing && awake && !dozing
+        if (sensors && motion == null) {
+            motion = BlueOSMotion.acquire(context, this)
+            Choreographer.getInstance().postFrameCallback(this)
+        } else if (!sensors && motion != null) {
+            motion?.invoke()
+            motion = null
+            Choreographer.getInstance().removeFrameCallback(this)
+            arona.translationX = 0f
+            arona.translationY = 0f
+        }
+    }
+
+    private fun moveTo(p: Place) {
+        if (p == shown && arona.layoutParams.height > 0) return
+        val from = shown
+        shown = p
+        anim?.cancel()
+        if (width == 0 || arona.layoutParams.height == 0) { layoutArona(p); return }
+        anim = ValueAnimator.ofFloat(0f, 1f).apply {
+            duration = 900
+            interpolator = PathInterpolator(.3f, 1.15f, .4f, 1f)
+            addUpdateListener {
+                val f = it.animatedValue as Float
+                layoutArona(Place(from.cx + (p.cx - from.cx) * f, from.top + (p.top - from.top) * f, from.h + (p.h - from.h) * f))
+            }
+            start()
+        }
+    }
+
+    private fun layoutArona(p: Place) {
+        if (width == 0) return
+        val vp = arona.viewport
+        val h = (p.h * height).toInt()
+        val w = (h * vp.w / vp.h).toInt()
+        val lp = arona.layoutParams as LayoutParams
+        lp.width = w
+        lp.height = h
+        lp.leftMargin = (p.cx * width - w / 2f).toInt()
+        lp.topMargin = (p.top * height).toInt()
+        arona.layoutParams = lp
+    }
+
+    override fun onSizeChanged(w: Int, h: Int, oldw: Int, oldh: Int) {
+        super.onSizeChanged(w, h, oldw, oldh)
+        post { layoutArona(shown) }
+    }
+
+    // the clock digits and the halo must stay readable (uiautomator, 1080x2400)
+    private fun avoidRects(): List<RectF> = listOf(RectF(74f, 179f, 657f, 478f), RectF(450f, 172f, 650f, 268f))
+        .map { RectF(it.left / 1080 * width, it.top / 2400 * height, it.right / 1080 * width, it.bottom / 2400 * height) }
+
+    override fun onTouchEvent(e: MotionEvent): Boolean {
+        if (visibility != VISIBLE || dozing) return false
+        // a tap on the halo makes it swing (no sound)
+        if (e.actionMasked == MotionEvent.ACTION_DOWN && K.on(cr, K.HALO_LIVE) && K.on(cr, K.HALO_TOUCH)) {
+            val halo = avoidRects()[1]
+            halo.inset(-24 * dp, -24 * dp)
+            if (halo.contains(e.x, e.y)) {
+                BlueOSHaloLive.swing(if (e.x < halo.centerX()) -1 else 1)
+                return true
+            }
+        }
+        if (arona.visibility != VISIBLE) return false
+        val local = MotionEvent.obtain(e)
+        local.offsetLocation(-arona.left.toFloat() - arona.translationX, -arona.top.toFloat() - arona.translationY)
+        val handled = touch.onTouch(local)
+        local.recycle()
+        return handled
+    }
+
+    private fun touched() {
+        val now = SystemClock.uptimeMillis()
+        quick.addLast(now)
+        while (quick.isNotEmpty() && now - quick.first() > 4000) quick.removeFirst()
+        if (quick.size >= 9) {                                           // poked too often: she's annoyed
+            quick.clear()
+            handler.postDelayed({ touch.say(AronaReplies.Kind.ANGRY) }, 350)
+        }
+        if (mode() != 3) return
+        touches++
+        handler.removeCallbacks(shrink)
+        handler.postDelayed(shrink, 30_000)                              // 30 s without her → small again
+        val lvl = if (touches >= 6) 2 else if (touches >= 3) 1 else 0
+        if (lvl > level) {
+            setLevel(lvl)
+            handler.postDelayed({ touch.say(AronaReplies.Kind.GROW) }, 700)
+        }
+    }
+
+    private fun setLevel(l: Int) {
+        if (l == 0) touches = 0
+        level = l
+        if (mode() == 3) moveTo(target())
+    }
+
+    fun onNotification() {
+        if (arona.visibility != VISIBLE || dozing || !awake || !showing) return
+        if (mode() == 3) setLevel(0)                                     // make room for the notification
+        if (K.on(cr, K.ARONA_NOTIF)) touch.say(AronaReplies.Kind.NOTIFICATION)   // chip only, never a sound
+    }
+
+    private fun onWake() {
+        BlueOSHaloLive.sparkle()
+        if (arona.visibility != VISIBLE || dozing || night()) return
+        val now = SystemClock.elapsedRealtime()
+        if (now - lastGreeting < 2 * 3600_000L && lastGreeting != 0L) return     // greets at most every 2 h
+        lastGreeting = now
+        handler.postDelayed({ touch.say(AronaReplies.Kind.WAKE) }, 400)
+    }
+
+    override fun onShake() {
+        if (!K.on(cr, K.SHAKE_ARONA) || arona.visibility != VISIBLE) return
+        arona.dizzy()
+        handler.postDelayed({ touch.say(AronaReplies.Kind.SHAKE) }, 600)
+    }
+
+    override fun onFall() {
+        BlueOSHaloLive.fall()                                            // halos go out and flicker, in place
+        if (!K.on(cr, K.FALL_ARONA) || arona.visibility != VISIBLE) return
+        arona.startle()
+        handler.postDelayed({ touch.say(AronaReplies.Kind.FALL) }, 250)
+    }
+
+    // inertia: she lags a little behind the phone's motion and springs back
+    override fun doFrame(frameTimeNanos: Long) {
+        if (motion == null) return
+        val on = K.on(cr, K.INERTIA)
+        arona.translationX = if (on) BlueOSMotion.jigX * 0.6f * dp else 0f
+        arona.translationY = if (on) BlueOSMotion.jigY * 0.6f * dp else 0f
+        Choreographer.getInstance().postFrameCallback(this)
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        motion?.invoke()
+        motion = null
+        Choreographer.getInstance().removeFrameCallback(this)
+    }
+}

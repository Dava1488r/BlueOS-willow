+import java.net.HttpURLConnection
+import java.net.URL
+import java.util.Locale
+import org.blueos.arona.BlueOSSettings
+import org.json.JSONObject
+
+/**
+ * BlueOS 0.7 weather for the lock clock, the «Сводка»/«Дата»/«Погода» widgets and Arona's weather lines.
+ * Google Weather on the phone doesn't share its data, so we ask Open-Meteo (free, no key) for the
+ * approximate location (rounded to 0.1° ≈ 10 km) every 45 min and when the screen turns on with stale data,
+ * and publish the result as JSON in Settings.Secure [BlueOSSettings.WEATHER].
+ */
+object BlueOSWeather {
+    private const val TAG = "BlueOSWeather"
+    private const val PERIOD = 45 * 60_000L
+
+    private var started = false
+    private lateinit var ctx: Context
+    private lateinit var bg: Handler
+    private var lastFetch = 0L
+
+    fun start(context: Context) {
+        if (started) return
+        started = true
+        ctx = context.applicationContext
+        bg = Handler(HandlerThread("BlueOSWeather").apply { start() }.looper)
+        bg.post(::refresh)
+        // other apps' widgets (Calendar's «Дата») follow the weather and its switches
+        BlueOSSettings.observe(ctx, listOf(BlueOSSettings.WEATHER, BlueOSSettings.WEATHER_DATE, BlueOSSettings.WEATHER_F)) {
+            com.android.systemui.blueos.widgets.BlueOSWidgetStyle.notifyChanged(ctx)
+        }
+        ctx.registerReceiver(object : BroadcastReceiver() {
+            override fun onReceive(c: Context, i: Intent) {
+                if (SystemClock.elapsedRealtime() - lastFetch > PERIOD) bg.post(::refresh)
+            }
+        }, IntentFilter(Intent.ACTION_SCREEN_ON))
+    }
+
+    private fun refresh() {
+        bg.removeCallbacksAndMessages(null)
+        bg.postDelayed(::refresh, PERIOD)
+        val loc = location() ?: run { Log.i(TAG, "no location yet"); return }
+        val lat = String.format(Locale.US, "%.1f", loc.latitude)
+        val lon = String.format(Locale.US, "%.1f", loc.longitude)
+        val url = URL("https://api.open-meteo.com/v1/forecast?latitude=$lat&longitude=$lon" +
+            "&current=temperature_2m,apparent_temperature,weather_code,is_day" +
+            "&daily=temperature_2m_max,temperature_2m_min&timezone=auto&forecast_days=1")
+        try {
+            val conn = url.openConnection() as HttpURLConnection
+            conn.connectTimeout = 10_000
+            conn.readTimeout = 10_000
+            val body = conn.inputStream.bufferedReader().use { it.readText() }
+            conn.disconnect()
+            val j = JSONObject(body)
+            val cur = j.getJSONObject("current")
+            val daily = j.getJSONObject("daily")
+            val out = JSONObject()
+                .put("t", cur.getDouble("temperature_2m"))
+                .put("feels", cur.getDouble("apparent_temperature"))
+                .put("code", cur.getInt("weather_code"))
+                .put("day", cur.optInt("is_day", 1))
+                .put("hi", daily.getJSONArray("temperature_2m_max").getDouble(0))
+                .put("lo", daily.getJSONArray("temperature_2m_min").getDouble(0))
+                .put("ts", System.currentTimeMillis())
+            // the icon's resource id in SystemUI, for widgets of other apps (Calendar's «Дата»)
+            out.put("iconRes", org.blueos.arona.Weather(out.getDouble("t"), out.getInt("code"), 0.0, 0.0, 0.0,
+                out.getInt("day") == 1, 0L).icon)
+            Settings.Secure.putString(ctx.contentResolver, BlueOSSettings.WEATHER, out.toString())
+            lastFetch = SystemClock.elapsedRealtime()
+        } catch (e: Exception) {
+            Log.w(TAG, "weather fetch failed: $e")
+            bg.postDelayed(::refresh, 10 * 60_000L)     // retry sooner on a network error
+        }
+    }
+
+    private fun location(): Location? {
+        if (ctx.checkSelfPermission(Manifest.permission.ACCESS_COARSE_LOCATION) != PackageManager.PERMISSION_GRANTED) return null
+        val lm = ctx.getSystemService(LocationManager::class.java) ?: return null
+        return try {
+            listOf(LocationManager.FUSED_PROVIDER, LocationManager.NETWORK_PROVIDER, LocationManager.PASSIVE_PROVIDER, LocationManager.GPS_PROVIDER)
+                .mapNotNull { runCatching { lm.getLastKnownLocation(it) }.getOrNull() }
+                .maxByOrNull { it.time }
+                ?: run {
+                    // nothing cached yet: ask once, the next refresh will use it
+                    lm.getCurrentLocation(LocationManager.FUSED_PROVIDER, null, ctx.mainExecutor) { l ->
+                        if (l != null) bg.post(::refresh)
+                    }
+                    null
+                }
+        } catch (e: Exception) {
+            Log.w(TAG, "location: $e")
+            null
+        }
+    }
+}

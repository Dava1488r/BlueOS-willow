+/**
+ * BlueOS 0.7: the live halo of the Halo clock (switches in Обои и стиль → Экран блокировки → Живые часы).
+ * Breathes in the accent colour, floats a little, a gleam runs around it when the minute changes, glows
+ * brighter while charging, swings when touched (no sound), leans with the phone, lags behind its motion,
+ * goes out and flickers back after a fall. Draws only while a halo view is attached and awake.
+ */
+object BlueOSHaloLive : android.view.Choreographer.FrameCallback {
+    private val views = mutableSetOf<View>()
+    private var running = false
+    private var last = 0L
+    private var t = 0f
+    private var swingA = 0f
+    private var swingV = 0f
+    private var tiltA = 0f
+    private var sparkleT = -1f
+    private var minute = -1
+    private var blackoutT = -1f
+    private var charging = false
+    private var chargeCheckedAt = 0L
+    private var ctx: Context? = null
+    private val glowPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val sparkPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+
+    var active = false; private set
+    var dx = 0f; private set
+    var dy = 0f; private set
+    var angle = 0f; private set
+    var blackout = 1f; private set
+
+    private fun on(key: String) = ctx?.let { org.blueos.arona.BlueOSSettings.on(it.contentResolver, key) } ?: false
+
+    fun register(view: View) {
+        ctx = view.context.applicationContext
+        views += view
+        if (!running) {
+            running = true
+            last = 0L
+            android.view.Choreographer.getInstance().postFrameCallback(this)
+        }
+    }
+
+    fun unregister(view: View) {
+        views -= view
+        if (views.isEmpty()) {
+            running = false
+            active = false
+            android.view.Choreographer.getInstance().removeFrameCallback(this)
+            idle.removeCallbacks(wake)
+        }
+    }
+
+    /** Touch on the halo: a swing to that side (−1 / +1). */
+    fun swing(dir: Int) { swingV += 220f * dir }
+
+    /** The phone fell: the halo goes out and flickers back in place. */
+    fun fall() { if (on(org.blueos.arona.BlueOSSettings.FALL_HALO)) blackoutT = 0f }
+
+    /** A gleam runs around the halo (also when the screen turns on). */
+    fun sparkle() { if (on(org.blueos.arona.BlueOSSettings.HALO_SPARK)) sparkleT = 0f }
+
+    private val idle = android.os.Handler(android.os.Looper.getMainLooper())
+    private val wake = Runnable { if (running) { last = 0L; android.view.Choreographer.getInstance().postFrameCallback(this) } }
+
+    override fun doFrame(frameTimeNanos: Long) {
+        if (!running) return
+        val c = ctx
+        // AOD / screen off: no per-frame redraws (battery); look again in a second
+        val interactive = c?.getSystemService(android.os.PowerManager::class.java)?.isInteractive ?: false
+        active = interactive && c != null && on(org.blueos.arona.BlueOSSettings.HALO_LIVE)
+        if (!active) {
+            idle.removeCallbacks(wake)
+            idle.postDelayed(wake, 1000)
+            return
+        }
+        val dt = if (last == 0L) 0f else ((frameTimeNanos - last) / 1e9f).coerceIn(0f, 0.05f)
+        last = frameTimeNanos
+        step(c!!, dt)
+        views.forEach { if (it.isShown) it.invalidate() }
+        android.view.Choreographer.getInstance().postFrameCallback(this)
+    }
+
+    private fun step(c: Context, dt: Float) {
+        t += dt
+        val k = org.blueos.arona.BlueOSSettings
+        val float = on(k.HALO_FLOAT)
+        // swing (spring) + tilt lean + inertia (capped ±5 dp)
+        swingV += (-swingA * 90f - swingV * 3.4f) * dt
+        swingA += swingV * dt
+        val tilt = if (on(k.HALO_TILT)) org.blueos.arona.BlueOSMotion.tilt[0] * 7f else 0f
+        tiltA += (tilt - tiltA) * (1f - kotlin.math.exp(-dt * 4f))
+        val dp = c.resources.displayMetrics.density
+        val jx = if (on(k.INERTIA)) (org.blueos.arona.BlueOSMotion.jigX * 0.6f).coerceIn(-5f, 5f) else 0f
+        val jy = if (on(k.INERTIA)) (org.blueos.arona.BlueOSMotion.jigY * 0.6f).coerceIn(-4f, 4f) else 0f
+        val bob = if (float) kotlin.math.sin(t * 2f * Math.PI.toFloat() / 5.5f) * 1.4f else 0f
+        val rot = if (float) kotlin.math.sin(t * 2f * Math.PI.toFloat() / 7f) * 2f else 0f
+        dx = jx * dp
+        dy = (bob + jy) * dp
+        angle = swingA + tiltA + rot - jx * 1.5f
+        // a gleam when the minute changes
+        val m = (System.currentTimeMillis() / 60_000L).toInt()
+        if (minute != -1 && m != minute) sparkle()
+        minute = m
+        if (sparkleT >= 0f) { sparkleT += dt / 1.1f; if (sparkleT > 1f) sparkleT = -1f }
+        // fall: out for ~0.8 s, then flicker back
+        blackout = if (blackoutT < 0f) 1f else {
+            blackoutT += dt
+            val p = blackoutT / 2.3f
+            when {
+                p > 1f -> { blackoutT = -1f; 1f }
+                p < 0.42f -> 0f
+                p < 0.5f -> 0.85f
+                p < 0.56f -> 0.1f
+                p < 0.66f -> 0.9f
+                p < 0.72f -> 0.25f
+                else -> 1f
+            }
+        }
+        val now = android.os.SystemClock.uptimeMillis()
+        if (now - chargeCheckedAt > 5000) {
+            chargeCheckedAt = now
+            val bat = c.registerReceiver(null, android.content.IntentFilter(android.content.Intent.ACTION_BATTERY_CHANGED))
+            charging = (bat?.getIntExtra(android.os.BatteryManager.EXTRA_PLUGGED, 0) ?: 0) != 0
+        }
+    }
+
+    /** Glow: a soft, breathing stroke in the accent colour under the halo (brighter while charging). */
+    internal fun drawGlow(canvas: Canvas, oval: RectF, base: Paint, color: Int) {
+        val c = ctx ?: return
+        val k = org.blueos.arona.BlueOSSettings
+        val charge = charging && on(k.HALO_CHARGE)
+        val g = when {
+            charge -> 0.75f + 0.25f * kotlin.math.sin(t * 2f * Math.PI.toFloat() / 2.4f)
+            on(k.HALO_GLOW) -> 0.5f + 0.5f * kotlin.math.sin(t * 2f * Math.PI.toFloat() / 4f)
+            else -> return
+        }
+        val accent = c.getColor(android.R.color.system_accent1_200)
+        glowPaint.style = Paint.Style.STROKE
+        glowPaint.strokeWidth = base.strokeWidth * (1.6f + g)
+        glowPaint.color = withVisibility(accent, (if (charge) 0.55f else 0.35f) * g * blackout * Color.alpha(color) / 255f)
+        glowPaint.maskFilter = android.graphics.BlurMaskFilter(base.strokeWidth * (0.8f + g * 1.4f), android.graphics.BlurMaskFilter.Blur.NORMAL)
+        canvas.drawOval(oval, glowPaint)
+    }
+
+    /** The minute gleam: a short bright arc running once around the halo. */
+    internal fun drawSparkle(canvas: Canvas, oval: RectF, base: Paint) {
+        if (sparkleT < 0f) return
+        val c = ctx ?: return
+        val a = kotlin.math.sin(sparkleT * Math.PI.toFloat())
+        sparkPaint.style = Paint.Style.STROKE
+        sparkPaint.strokeCap = Paint.Cap.ROUND
+        sparkPaint.strokeWidth = base.strokeWidth * 0.8f
+        sparkPaint.color = withVisibility(c.getColor(android.R.color.system_accent1_10), a * blackout * base.alpha / 255f)
+        canvas.drawArc(oval, -200f + sparkleT * 360f, 32f, false, sparkPaint)
     }
 }
 
+/** Makes this halo view live while it is attached (BlueOS 0.7). */
+internal fun View.liveHalo() {
+    addOnAttachStateChangeListener(
+        object : View.OnAttachStateChangeListener {
+            override fun onViewAttachedToWindow(v: View) = BlueOSHaloLive.register(v)
+            override fun onViewDetachedFromWindow(v: View) = BlueOSHaloLive.unregister(v)
+        }
+    )
+}

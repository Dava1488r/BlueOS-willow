From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GDmio <zhalin66@gmail.com>
Date: Sat, 24 Oct 2026 12:55:20 +0200
Subject: [PATCH 05/30] BlueOS: power: Sounds for unplugging and a full battery

Unplugging played the charging started sound again. It now plays Settings.Global blueos_charging_stopped_sound (default Emoticon_Sweat), and blueos_battery_full_sound (default Emoticon_Steam) plays when the battery reaches 100% while charging. Both obey the charging sounds switch.

Change-Id: I89f9d260ad0705540cc5b4ba85c67a87ce27532e
---
 .../com/android/server/power/Notifier.java    | 62 ++++++++++++++++---
 .../server/power/PowerManagerService.java     |  6 ++
 2 files changed, 61 insertions(+), 7 deletions(-)

diff --git a/services/core/java/com/android/server/power/Notifier.java b/services/core/java/com/android/server/power/Notifier.java
index e334af48138b..bfb55934a153 100644
--- a/services/core/java/com/android/server/power/Notifier.java
+++ b/services/core/java/com/android/server/power/Notifier.java
@@ -59,6 +59,7 @@ import android.os.WorkSource;
 import android.os.WorkSource.WorkChain;
 import android.provider.Settings;
 import android.telephony.TelephonyManager;
+import android.text.TextUtils;
 import android.util.ArrayMap;
 import android.util.EventLog;
 import android.util.Slog;
@@ -127,6 +128,16 @@ public class Notifier {
     private static final int MSG_SCREEN_POLICY = 7;
     private static final int MSG_WIRED_CHARGING_DISCONNECTED = 8;
     private static final int MSG_WIRELESS_CHARGING_INTERRUPTED = 9;
+    private static final int MSG_BATTERY_FULL = 10;
+
+    // BlueOS: own sounds for unplugging and for a full battery (Settings.Global, a file path or
+    // "silent"; chosen in Settings > Sound > Charging sounds)
+    private static final String BLUEOS_CHARGING_STOPPED_SOUND = "blueos_charging_stopped_sound";
+    private static final String BLUEOS_BATTERY_FULL_SOUND = "blueos_battery_full_sound";
+    private static final String BLUEOS_DEFAULT_CHARGING_STOPPED_SOUND =
+            "/product/media/audio/notifications/Emoticon_Sweat.ogg";
+    private static final String BLUEOS_DEFAULT_BATTERY_FULL_SOUND =
+            "/product/media/audio/notifications/Emoticon_Steam.ogg";
 
     private static final long[] CHARGING_VIBRATION_TIME = {
             40, 40, 40, 40, 40, 40, 40, 40, 40, // ramp-up sampling rate = 40ms
@@ -1105,6 +1116,22 @@ public class Notifier {
         mHandler.sendMessage(msg);
     }
 
+    /**
+     * BlueOS: called when the battery got full while charging - to provide user feedback
+     * (sound only).
+     */
+    public void onBatteryFull(@UserIdInt int userId) {
+        if (DEBUG) {
+            Slog.d(TAG, "onBatteryFull");
+        }
+
+        mSuspendBlocker.acquire();
+        Message msg = mHandler.obtainMessage(MSG_BATTERY_FULL);
+        msg.setAsynchronous(true);
+        msg.arg1 = userId;
+        mHandler.sendMessage(msg);
+    }
+
     /**
      * Called when the screen policy changes.
      */
@@ -1291,6 +1318,13 @@ public class Notifier {
     };
 
     private void playChargingStartedFeedback(@UserIdInt int userId, boolean wireless) {
+        playChargingFeedback(userId, wireless ? Settings.Global.WIRELESS_CHARGING_STARTED_SOUND
+                : Settings.Global.CHARGING_STARTED_SOUND, null /* defaultSound */,
+                true /* vibrate */, "Charging started");
+    }
+
+    private void playChargingFeedback(@UserIdInt int userId, String soundSetting,
+            String defaultSound, boolean allowVibration, String reason) {
         if (!isChargingFeedbackEnabled(userId)) {
             return;
         }
@@ -1304,19 +1338,22 @@ public class Notifier {
         // vibrate & play sound on a background thread
         mBackgroundExecutor.execute(() -> {
             // vibrate
-            final boolean vibrate = Settings.Secure.getIntForUser(mContext.getContentResolver(),
+            final boolean vibrate = allowVibration && Settings.Secure.getIntForUser(
+                    mContext.getContentResolver(),
                     Settings.Secure.CHARGING_VIBRATION_ENABLED, 1, userId) != 0;
             if (vibrate) {
                 mVibrator.vibrate(Process.SYSTEM_UID, mContext.getOpPackageName(),
-                        CHARGING_VIBRATION_EFFECT, /* reason= */ "Charging started",
+                        CHARGING_VIBRATION_EFFECT, reason,
                         HARDWARE_FEEDBACK_VIBRATION_ATTRIBUTES);
             }
 
             // play sound
-            final String soundPath = Settings.Global.getString(mContext.getContentResolver(),
-                    wireless ? Settings.Global.WIRELESS_CHARGING_STARTED_SOUND
-                            : Settings.Global.CHARGING_STARTED_SOUND);
-            if ("silent".equals(soundPath)) {
+            String soundPath = Settings.Global.getString(mContext.getContentResolver(),
+                    soundSetting);
+            if (TextUtils.isEmpty(soundPath)) {
+                soundPath = defaultSound;
+            }
+            if (soundPath == null || "silent".equals(soundPath)) {
                 mIsPlayingChargingStartedFeedback.set(false);
                 return;
             }
@@ -1353,7 +1390,15 @@ public class Notifier {
     }
 
     private void showChargingStopped(@UserIdInt int userId, boolean wireless) {
-        playChargingStartedFeedback(userId, wireless);
+        // BlueOS: a sound of its own instead of the "charging started" one
+        playChargingFeedback(userId, BLUEOS_CHARGING_STOPPED_SOUND,
+                BLUEOS_DEFAULT_CHARGING_STOPPED_SOUND, true /* vibrate */, "Charging stopped");
+        mSuspendBlocker.release();
+    }
+
+    private void showBatteryFull(@UserIdInt int userId) {
+        playChargingFeedback(userId, BLUEOS_BATTERY_FULL_SOUND,
+                BLUEOS_DEFAULT_BATTERY_FULL_SOUND, false /* vibrate */, "Battery full");
         mSuspendBlocker.release();
     }
 
@@ -1667,6 +1712,9 @@ public class Notifier {
                 case MSG_WIRED_CHARGING_STARTED:
                     showWiredChargingStarted(msg.arg1);
                     break;
+                case MSG_BATTERY_FULL:
+                    showBatteryFull(msg.arg1);
+                    break;
                 case MSG_SCREEN_POLICY:
                     screenPolicyChanging(msg.arg1, msg.arg2);
                     break;

--- a/services/core/java/com/android/server/power/PowerManagerService.java
+++ b/services/core/java/com/android/server/power/PowerManagerService.java
@@ -3074,6 +3074,12 @@ public final class PowerManagerService extends SystemService
                 }
             }
 
+            // BlueOS: sound when the battery gets full while charging
+            if (mBootCompleted && wasPowered && mIsPowered
+                    && oldBatteryLevel > 0 && oldBatteryLevel < 100 && mBatteryLevel >= 100) {
+                mNotifier.onBatteryFull(mUserId);
+            }
+
             if (mBatterySaverSupported) {
                 mBatterySaverStateMachine.setBatteryStatus(mIsPowered, mBatteryLevel,
                         mBatteryLevelLow);

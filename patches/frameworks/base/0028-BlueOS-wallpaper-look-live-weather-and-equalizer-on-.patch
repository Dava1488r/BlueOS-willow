+        for (i in target.indices) {
+            val v = b.getFloat(BlueOSVisualizerView.OFFSET_BANDS + i * 4)
+            target[i] = v
+            if (v > 0.02f) silent = false
+        }
+        if (!silent) { silentSince = 0L; return true }
+        if (silentSince == 0L) silentSince = now
+        return now - silentSince < 1500
+    }
+
+    /** The widgets' made-up spectrum: a 120 bpm kick, hi-hats and a slow melody. */
+    private fun fake(now: Long) {
+        val t = now / 1000f
+        val kick = kotlin.math.exp(-((t % 0.5f) / 0.11f))
+        val hat = kotlin.math.exp(-(((t + 0.25f) % 0.5f) / 0.05f))
+        for (i in target.indices) {

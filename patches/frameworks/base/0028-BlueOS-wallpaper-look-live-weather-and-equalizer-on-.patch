+    companion object {
+        private const val TAG = "BlueOSWallWeather"
+        private const val NONE = 0
+        private const val RAIN = 1
+        private const val SNOW = 2
+        private const val FOG = 3
+        private const val CLOUDS = 4
+        private const val SUN = 5
+        // vsync is 16.7 ms: < 30 → every 2nd frame (30 fps), < 62 → every 4th (15 fps)
+        private const val FRAME_MS_FAST = 30L
+        private const val FRAME_MS_SLOW = 62L
+        private const val CALM_MS = 600L
+        private const val FADE_MS = 350L
+        private val SRGB: ColorSpace = ColorSpace.get(ColorSpace.Named.SRGB)
+
+        /** Light shafts from the sun: strong while a cloud covers it (light breaking through), a hint in the open. */
+        private const val SHAFTS = """
+            uniform float2 uRes; uniform float2 uSun; uniform float uT; uniform float uOcc; uniform float uAmt;
+            float h1(float x) { return fract(sin(x * 127.1) * 43758.5453); }
+            float n1(float x) { float i = floor(x); float f = fract(x); f = f * f * (3.0 - 2.0 * f); return mix(h1(i), h1(i + 1.0), f); }
+            half4 main(float2 p) {
+                float2 d = p - uSun;
+                float r = length(d) / uRes.y;
+                float a = atan(d.y, d.x);
+                float rays = n1(a * 14.0 + uT * 0.15) * 0.6 + n1(a * 31.0 - uT * 0.1) * 0.4;
+                rays = smoothstep(0.35, 1.0, rays);
+                float s = rays * exp(-r * 2.8) * (0.12 + 1.0 * uOcc) * 0.5 + exp(-r * 9.0) * (1.0 - uOcc * 0.85) * 0.4;
+                s = clamp(s * uAmt, 0.0, 1.0);
+                return half4(half3(1.0, 0.92, 0.75) * s, s);
+            }
+        """
+    }
+}

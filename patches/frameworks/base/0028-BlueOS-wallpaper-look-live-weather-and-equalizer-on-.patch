+    private fun publishTopBlock() {
+        if (!org.blueos.arona.BlueOSBeat.wantTopBlock || !showing || dozing) return
+        val now = SystemClock.uptimeMillis()
+        if (now - topBlockAt < 300) return
+        topBlockAt = now
+        val root = parent as? ViewGroup ?: return
+        val loc = IntArray(2)
+        var out: RectF? = null
+        for (i in 0 until root.childCount) {
+            val v = root.getChildAt(i)
+            if (v === this || !v.isShown || v.alpha < 0.05f || v.width == 0 || v.height == 0) continue
+            if (v.height > root.height * 0.5f) continue                         // full-screen layers
+            v.getLocationOnScreen(loc)
+            if (loc[1] < 40 * dp || loc[1] > root.height * 0.4f) continue      // the status bar; the lower half
+            val r = RectF(loc[0].toFloat(), loc[1].toFloat(), (loc[0] + v.width).toFloat(), (loc[1] + v.height).toFloat())
+            if (out == null) out = r else out.union(r)
+        }
+        org.blueos.arona.BlueOSBeat.topBlock = out
+    }
 

+            for (i in target.indices) {
+                val t = target[i]
+                val k = if (t > beat.shown[i]) 0.55f else 0.14f
+                beat.shown[i] += (t - beat.shown[i]) * (1f - (1f - k).pow(dt))
+                if (beat.shown[i] > 0.004f) moving = true
+            }
+            // the low end: the first quarter of the bands
+            var low = 0f
+            for (i in 0 until 8) low += beat.shown[i]
+            beat.energy = (low / 8f).coerceIn(0f, 1f)
+            if (beat.playing || moving) {
+                handler.postDelayed(this, TICK_MS)
+            } else {
+                beat.shown.fill(0f)
+                beat.energy = 0f
+                ticking = false
+                beat.changed()
+            }
+        }
+    }
+
+    /** From the service; false when there's nothing real (no service, or a long silence while «playing»). */
+    private fun read(now: Long): Boolean {
+        val b = buffer ?: return false
+        if ((b.getInt(BlueOSVisualizerView.OFFSET_FLAGS) and BlueOSVisualizerView.FLAG_UNAVAILABLE) != 0) return false

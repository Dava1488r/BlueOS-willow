+/**
+ * BlueOS 0.8: the wallpaper's own look, drawn by the static wallpaper (ImageWallpaper) itself.
+ *
+ * - «Размытие / Затемнение обоев» (Цвета → Обои): the picture is blurred and dimmed ONCE on the GPU, one copy for the
+ *   home screen and one for the lock screen, and that copy is what the wallpaper shows; lock ↔ home cross-fades.
+ *   Before, the launcher and the shade blurred whatever was behind their windows every frame — the weather got
+ *   blurred with the picture, SurfaceFlinger re-blurred the whole screen 30 times a second (the lag), and after an
+ *   app closed the blur came back seconds later.
+ * - «Живая погода на обоях»: while the weather from the «Погода» widget asks for it, the picture is drawn every frame
+ *   with the weather in it — Google's own shaders from AOSP (rain on the glass, snow, fog, clouds, sun: the Pixel
+ *   weather wallpapers) plus BlueOS's: storm flashes, a blizzard, and for «Малооблачно» a sun that drifting clouds
+ *   cover now and then, light shafts breaking through the gaps (approved mockup mockups/blueos-weather.html). The
+ *   weather lies OVER the blurred picture, under every widget. Only while the wallpaper is visible and the screen on;
+ *   rain and snow ~30 fps, slow clouds / fog / sun ~15 fps, held still while the launcher or the shade moves
+ *   ([busy]). Off = the plain picture as before.
+ * - «Эквалайзер на обоях»: while music plays, bars or a wave along the bottom of the screen, or a glow from below
+ *   ([org.blueos.arona.BlueOSBeat]) — over the picture and the weather, under the widgets; on the lock screen also a
+ *   wave right under the clock. In the «Эквалайзер» colour role.
+ *
+ * Settings and the weather loop run on the engine's own thread ([handler]); [render] locks the wallpaper surface,
+ * draws, posts. The engine's own frames come through [drawInto] from its loader thread — state is under [lock], and
+ * [render] is never called while holding it (the engine takes its surface lock first).
+ */
+class BlueOSWallpaperWeather(
+    private val context: Context,
+    private val handler: Handler,
+    private val render: (draw: (Canvas) -> Unit) -> Boolean,
+    private val needBitmap: () -> Unit,
+) : Choreographer.FrameCallback {
+    private val cr = context.contentResolver
+    private val lock = Any()
+    private val executor = Executor { handler.post(it) }
+    private var choreographer: Choreographer? = null
+    private val unobserve = mutableListOf<() -> Unit>()
+
+    private var sharp: Bitmap? = null
+    private var foreground: Bitmap? = null
+    private var homeBmp: Bitmap? = null
+    private var lockBmp: Bitmap? = null
+    private var shown: Bitmap? = null
+    private var fadeFrom: Bitmap? = null
+    private var fadeStart = 0L
+    private var locked = false
+    private var size = SizeF(0f, 0f)
+    private var effect: WeatherEffect? = null
+    private var plan: Plan? = null
+    private var effectKind = NONE
+    private var visible = false
+    private var screenOn = true
+    private var running = false
+    private var lastFrame = 0L
+    private var t = 0f
+    private var nextStrike = 4f
+    private var strikeAt = -10f
+
+    /** What the weather asks for: one of Google's effects, how strong, and BlueOS's extras on top. */
+    private data class Plan(val kind: Int, val intensity: Float, val storm: Boolean = false, val shafts: Boolean = false)
+
+    /** The picture's look on one screen: blur in screen px, dimming 0…0.8. */
+    private data class Look(val blur: Float, val dim: Float) {
+        val plain get() = blur < 1f && dim <= 0f
+    }
+
+    /** Home screen: its blur + dimming. Lock screen: its own blur, or the home one with «Всегда»; never dimmed. */
+    private fun looks(): Pair<Look, Look> {
+        val home = Look(K.wallBlurPx(context, K.HOME_WALL_BLUR).toFloat(), K.wallDim(cr, K.HOME_WALL_DIM))
+        val always = K.int(cr, K.HOME_WALL_BLUR_MODE) == 1
+        val lockBlur = max(K.wallBlurPx(context, K.LOCK_WALL_BLUR).toFloat(), if (always) home.blur else 0f)
+        return home to Look(lockBlur, 0f)
+    }
+
+    /** On: we need the picture (the engine hands a copy over when it loads it). */
+    val wanted get() = K.on(cr, K.WALL_WEATHER) || K.int(cr, K.WALL_EQ) != 0 ||
+        looks().let { !it.first.plain || !it.second.plain }
+
+    // «Эквалайзер на обоях», read once per change (not per frame)
+    private val beat = org.blueos.arona.BlueOSBeat
+    @Volatile private var eqWhere = 0
+    @Volatile private var eqStyle = 0
+    @Volatile private var eqUnderClock = false
+    @Volatile private var eqStr = .6f
+    private var eqColor = 0
+    private var eqColorLocked = false
+    private var eqColorAt = 0L
+
+    private fun readEq() {
+        eqWhere = K.int(cr, K.WALL_EQ)
+        eqStyle = K.int(cr, K.WALL_EQ_STYLE)
+        eqUnderClock = K.int(cr, K.WALL_EQ_LOCK_POS) == 1
+        eqStr = K.int(cr, K.WALL_EQ_STR).coerceIn(20, 100) / 100f
+        beat.wantTopBlock = eqUnderClock && (eqWhere and 2) != 0
+        eqColorAt = 0L
+    }
+
+    /** The equalizer belongs on the screen showing now (home = bit 1, lock = bit 2). */
+    private fun eqHere() = (eqWhere and if (locked) 2 else 1) != 0
+
+    private val beatListener = Runnable { handler.post { updateRunning() } }
+
+    private val displayListener = object : DisplayManager.DisplayListener {
+        override fun onDisplayAdded(id: Int) {}
+        override fun onDisplayRemoved(id: Int) {}
+        override fun onDisplayChanged(id: Int) {
+            val d = context.display ?: return
+            if (id != d.displayId) return
+            // the always-on display keeps the wallpaper «visible» — nothing to animate there
+            val on = d.state == Display.STATE_ON
+            if (on == screenOn) return
+            screenOn = on
+            if (!on) finishFade()
+            updateRunning()
+        }
+    }
+
+    fun attach() {
+        readEq()
+        unobserve += K.observe(context, listOf(K.WEATHER, K.WALL_WEATHER, K.WALL_WEATHER_STR)) {
+            handler.post { update(reprocess = false) }
+        }
+        unobserve += K.observe(context, listOf(K.WALL_EQ, K.WALL_EQ_STYLE, K.WALL_EQ_LOCK_POS, K.WALL_EQ_STR, K.COLOR_EQ)) {
+            readEq()
+            handler.post { update(reprocess = false) }
+        }
+        beat.addListener(beatListener)
+        unobserve += { beat.removeListener(beatListener) }
+        unobserve += K.observe(context,
+            listOf(K.HOME_WALL_BLUR, K.HOME_WALL_DIM, K.HOME_WALL_BLUR_MODE, K.LOCK_WALL_BLUR)) {
+            handler.post { update(reprocess = true) }
+        }
+        context.getSystemService(DisplayManager::class.java)?.registerDisplayListener(displayListener, handler)
+        handler.post { update(reprocess = false) }
+    }
+
+    fun detach() {
+        unobserve.forEach { it() }
+        unobserve.clear()
+        context.getSystemService(DisplayManager::class.java)?.unregisterDisplayListener(displayListener)
+        handler.post {
+            setRunning(false)
+            synchronized(lock) {
+                releaseEffect()
+                sharp = null; foreground = null; homeBmp = null; lockBmp = null; shown = null; fadeFrom = null
+            }
+        }
+    }
+
+    /**
+     * The picture, as the engine loaded it — copied now (the engine recycles its own after drawing) and its home /
+     * lock looks made right away, so the engine's own frame that follows is already the right one.
+     */
+    fun setBitmap(picture: Bitmap, surfaceWidth: Int, surfaceHeight: Int) {
+        val copy = try { picture.copy(Bitmap.Config.ARGB_8888, false) } catch (e: Throwable) { null } ?: return
+        val (home, lck) = make(copy)
+        synchronized(lock) {
+            sharp = copy
+            // no cut-out of a person here (Pixel segments the photo): the whole picture stays behind the weather
+            foreground = Bitmap.createBitmap(copy.width, copy.height, Bitmap.Config.ALPHA_8)
+            size = SizeF(surfaceWidth.toFloat(), surfaceHeight.toFloat())
+            homeBmp = home
+            lockBmp = lck
+            releaseEffect()
+            snapShown()
+        }
+        handler.post { update(reprocess = false) }
+    }
+
+    /** The lock screen shows (or the unlock is under way = home). */
+    fun setLocked(l: Boolean) {
+        handler.post {
+            synchronized(lock) {
+                if (locked == l) return@post
+                locked = l
+                eqColorAt = 0L
+                // the look may stay the same while the equalizer comes or goes: run / draw anyway
+                val to = target()
+                if (to != null && to !== shown) {
+                    if (visible && screenOn && shown != null) {
+                        fadeFrom = shown
+                        shown = to
+                        fadeStart = SystemClock.uptimeMillis()
+                    } else {
+                        snapShown()
+                    }
+                }
+            }
+            updateRunning()
+            if (!running) render(::drawFrame)
+        }
+    }
+
+    fun setVisible(v: Boolean) {
+        handler.post {
+            visible = v
+            if (!v) finishFade()
+            updateRunning()
+        }
+    }
+
+    /** The engine's own frame: false = nothing of ours to draw, it draws the plain picture itself. */
+    fun drawInto(canvas: Canvas): Boolean {
+        synchronized(lock) {
+            if (sharp == null) return false
+            drawFrame(canvas)
+            return true
+        }
+    }
+
+    private fun currentPlan(): Plan? {
+        if (!K.on(cr, K.WALL_WEATHER)) return null
+        val w = Weather.read(cr)?.takeIf { it.fresh } ?: return null
+        val s = K.int(cr, K.WALL_WEATHER_STR).coerceIn(10, 100) / 100f
+        return when (w.kind) {
+            Weather.Kind.CLEAR -> if (w.day) Plan(SUN, s) else null
+            Weather.Kind.CLOUDY -> when (w.code) {
+                45, 48 -> Plan(FOG, s)
+                2 -> Plan(CLOUDS, .55f * s, shafts = w.day)
+                else -> Plan(CLOUDS, s)
+            }
+            Weather.Kind.RAIN -> Plan(RAIN, s * when (w.code) {
+                51, 53, 56, 61, 80 -> .55f
+                55, 57, 63, 66, 81 -> .8f
+                else -> 1f
+            })
+            Weather.Kind.STORM -> Plan(RAIN, s, storm = true)
+            // a blizzard is the heavy snow at full strength
+            Weather.Kind.SNOW -> Plan(SNOW, s * if (w.code == 75 || w.code == 86) 1f else .7f)
+        }
+    }
+
+    private fun update(reprocess: Boolean) {
+        if (!wanted) {
+            // back to the plain picture once, then let it go
+            val had = synchronized(lock) {
+                if (sharp == null) return@synchronized false
+                releaseEffect()
+                plan = null
+                homeBmp = sharp; lockBmp = sharp
+                snapShown()
+                true
+            }
+            if (!had) return
+            setRunning(false)
+            render(::drawFrame)
+            synchronized(lock) { sharp = null; foreground = null; homeBmp = null; lockBmp = null; shown = null }
+            return
+        }
+        val src = synchronized(lock) { sharp }
+        if (src == null) { needBitmap(); return }
+        if (reprocess) {
+            val (home, lck) = make(src)
+            synchronized(lock) { homeBmp = home; lockBmp = lck; snapShown() }
+        }
+        val p = currentPlan()
+        synchronized(lock) {
+            plan = p
+            if (p == null) {
+                releaseEffect()
+            } else {
+                if (effect == null || effectKind != p.kind) {
+                    releaseEffect()
+                    effect = create(p.kind, shown ?: src, foreground ?: return@synchronized)
+                    effectKind = p.kind
+                }
+                effect?.setIntensity(p.intensity)
+            }
+        }
+        updateRunning()
+        if (!running) render(::drawFrame)
+    }
+
+    // ------------------------------------------------------------- the picture's home / lock looks
+
+    private fun target(): Bitmap? = (if (locked) lockBmp else homeBmp) ?: sharp
+
+    /** Straight to the current look, no fade (under [lock]). */
+    private fun snapShown() {
+        fadeFrom = null
+        val to = target() ?: return
+        shown = to
+        foreground?.let { effect?.setBitmaps(it, to) }
+    }
+
+    private fun finishFade() = synchronized(lock) {
+        if (fadeFrom != null) snapShown()
+    }
+
+    private fun make(src: Bitmap): Pair<Bitmap, Bitmap> {
+        val (home, lck) = looks()
+        val h = process(src, home)
+        return h to if (lck == home) h else process(src, lck)
+    }
+
+    /** The picture blurred and dimmed, once, on the GPU (the result is a hardware bitmap); the picture itself if plain. */
+    private fun process(src: Bitmap, look: Look): Bitmap {
+        if (look.plain) return src
+        return try {
+            val w = src.width
+            val h = src.height
+            // the setting is in screen pixels; the picture is fitted to the screen's height
+            val screenH = context.resources.displayMetrics.heightPixels.coerceAtLeast(1)
+            val r = look.blur * h / screenH
+            val buffer = HardwareBuffer.create(w, h, HardwareBuffer.RGBA_8888, 1,
+                HardwareBuffer.USAGE_GPU_SAMPLED_IMAGE or HardwareBuffer.USAGE_GPU_COLOR_OUTPUT)
+            val renderer = HardwareBufferRenderer(buffer)
+            val node = RenderNode("BlueOSWallLook").apply { setPosition(0, 0, w, h) }
+            renderer.setContentRoot(node)
+            if (r >= 1f) node.setRenderEffect(RenderEffect.createBlurEffect(r, r, Shader.TileMode.CLAMP))
+            val c = node.beginRecording()
+            c.drawBitmap(src, 0f, 0f, null)
+            if (look.dim > 0f) c.drawColor(Color.argb((look.dim * 255).toInt().coerceIn(0, 255), 0, 0, 0))
+            node.endRecording()
+            val done = CountDownLatch(1)
+            var ok = false
+            renderer.obtainRenderRequest().setColorSpace(SRGB).draw(Executor { it.run() }) { result ->
+                ok = result.status == HardwareBufferRenderer.RenderResult.SUCCESS &&
+                    result.fence.await(Duration.ofSeconds(2))
+                done.countDown()
+            }
+            done.await(3, TimeUnit.SECONDS)
+            renderer.close()
+            // the bitmap holds its own reference to the buffer
+            val bmp = if (ok) Bitmap.wrapHardwareBuffer(buffer, SRGB) else null
+            buffer.close()
+            bmp ?: src
+        } catch (e: Throwable) {
+            Log.w(TAG, "wallpaper look failed", e)
+            src
+        }
+    }
+
+    // ------------------------------------------------------------- the weather
+
+    private fun create(kind: Int, bg: Bitmap, fg: Bitmap): WeatherEffect? = try {
+        val a = context.assets
+        val d = context.resources.displayMetrics.density
+        when (kind) {
+            RAIN -> RainEffect(rainConfig = RainEffectConfig(a, d), foreground = fg, background = bg, intensity = 0f,
+                initialSurfaceSize = size, mainExecutor = executor, isPanAndZoomInExtendedWallpaperEffectsEnabled = false)
+            SNOW -> SnowEffect(snowConfig = SnowEffectConfig(a, d), foreground = fg, background = bg, intensity = 0f,
+                initialSurfaceSize = size, mainExecutor = executor, isPanAndZoomInExtendedWallpaperEffectsEnabled = false)
+            FOG -> FogEffect(fogConfig = FogEffectConfig(a, d), foreground = fg, background = bg, intensity = 0f,
+                initialSurfaceSize = size, isPanAndZoomInExtendedWallpaperEffectsEnabled = false)
+            CLOUDS -> CloudsEffect(cloudsConfig = CloudsEffectConfig(a, d), foreground = fg, background = bg, intensity = 0f,
+                initialSurfaceSize = size, isPanAndZoomInExtendedWallpaperEffectsEnabled = false)
+            SUN -> SunEffect(sunConfig = SunEffectConfig(a, d), foreground = fg, background = bg, intensity = 0f,
+                initialSurfaceSize = size, isPanAndZoomInExtendedWallpaperEffectsEnabled = false)
+            else -> null
+        }
+    } catch (e: Throwable) {
+        // never take the wallpaper down with it: the plain picture stays
+        Log.w(TAG, "weather effect $kind failed", e)
+        null
+    }
+
+    private fun releaseEffect() {
+        effect?.release()
+        effect = null
+        effectKind = NONE
+    }
+
+    private fun updateRunning() {
+        val busy = synchronized(lock) { effect != null || fadeFrom != null || (sharp != null && eqHere() && beat.visible) }
+        setRunning(visible && screenOn && busy)
+    }
+
+    private fun setRunning(want: Boolean) {
+        if (want == running) return
+        running = want
+        val c = choreographer ?: Choreographer.getInstance().also { choreographer = it }
+        if (want) {
+            lastFrame = 0L
+            c.postFrameCallback(this)
+        } else {
+            c.removeFrameCallback(this)
+        }
+    }
+
+    /**
+     * 0.8: the launcher or the shade is moving (pages, «Все приложения», an app opening, the shade pulled — they move
+     * the wallpaper's offsets / zoom): the weather holds its frame until it's calm again, so they get the GPU. With
+     * clouds running, 68 % of the launcher's frames were late while swiping pages (3–19 % without).
+     */
+    fun busy() { calmAt = SystemClock.uptimeMillis() + CALM_MS }
+
+    @Volatile private var calmAt = 0L
+
+    override fun doFrame(frameTimeNanos: Long) {
+        if (!running) return
+        val c = choreographer ?: return
+        val fading = synchronized(lock) { fadeFrom != null }
+        if (!fading && SystemClock.uptimeMillis() < calmAt) {
+            // held still: the time doesn't run either, it goes on from the same frame afterwards
+            lastFrame = frameTimeNanos
+            c.postFrameCallback(this)
+            return
+        }
+        // a lock ↔ home fade at the full frame rate; then rain / snow ~30 fps, the slow ones ~15 fps
+        val minMs = synchronized(lock) {
+            when {
+                fadeFrom != null -> 0L
+                effectKind == RAIN || effectKind == SNOW || (eqHere() && beat.visible) -> FRAME_MS_FAST
+                else -> FRAME_MS_SLOW
+            }
+        }
+        val dtMs = if (lastFrame == 0L) 0L else (frameTimeNanos - lastFrame) / 1_000_000L
+        if (lastFrame != 0L && dtMs < minMs) { c.postFrameCallback(this); return }
+        lastFrame = frameTimeNanos
+        t += dtMs.coerceAtMost(100L) / 1000f
+        synchronized(lock) { effect?.update(dtMs.coerceAtMost(100L), frameTimeNanos) }
+        if (!render(::drawFrame)) { running = false; return }
+        if (synchronized(lock) { effect == null && fadeFrom == null && !(eqHere() && beat.visible) }) {
+            running = false
+            return
+        }
+        c.postFrameCallback(this)
+    }
+
+    private val dst = Rect()
+    private val paint = Paint()
+    private val picPaint = Paint(Paint.FILTER_BITMAP_FLAG)
+
+    /**
+     * One frame: the weather effect (it draws the picture too), or the plain picture without one. A lock ↔ home fade
+     * mixes the two looks; with weather the effect switches its picture halfway, so the weather never blinks out.
+     */
+    private fun drawFrame(canvas: Canvas) = synchronized(lock) {
+        val cur = shown ?: sharp ?: return@synchronized
+        val from = fadeFrom
+        val k = if (from == null) 1f else ((SystemClock.uptimeMillis() - fadeStart) / FADE_MS.toFloat()).coerceIn(0f, 1f)
+        val fading = from != null && k < 1f
+        if (!fading) fadeFrom = null
+        dst.set(0, 0, canvas.width, canvas.height)
+        val e = effect
+        if (e == null) {
+            if (fading) {
+                canvas.drawBitmap(from!!, null, dst, picPaint)
+                picPaint.alpha = (k * 255).toInt()
+                canvas.drawBitmap(cur, null, dst, picPaint)
+                picPaint.alpha = 255
+            } else {
+                canvas.drawBitmap(cur, null, dst, picPaint)
+            }
+            if (eqHere()) drawEq(canvas)
+            return@synchronized
+        }
+        foreground?.let { e.setBitmaps(it, if (fading && k < .5f) from!! else cur) }
+        e.draw(canvas)
+        if (fading) {
+            picPaint.alpha = ((if (k < .5f) k else 1f - k) * 255).toInt()
+            canvas.drawBitmap(if (k < .5f) cur else from!!, null, dst, picPaint)
+            picPaint.alpha = 255
+        }
+        plan?.let { p ->
+            if (p.shafts) shafts(canvas, p.intensity / .55f)
+            if (p.storm) flash(canvas, p.intensity)
+        }
+        if (eqHere()) drawEq(canvas)
+    }
+
+    // ------------------------------------------------------------- «Эквалайзер на обоях»
+
+    private val eqPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val eqPath = android.graphics.Path()
+
+    private fun drawEq(canvas: Canvas) {
+        if (!beat.visible) return
+        val now = SystemClock.uptimeMillis()
+        if (now - eqColorAt > 1000 || eqColorLocked != locked) {
+            // the palette / theme may change any moment; a second late is fine
+            eqColor = org.blueos.arona.BlueOSColorRoles.eqOnWallpaper(context, locked)
+            eqColorLocked = locked
+            eqColorAt = now
+        }
+        val m = context.resources.displayMetrics
+        val s = canvas.height / m.heightPixels.coerceAtLeast(1).toFloat()   // the surface is the picture's size
+        val dp = m.density * s
+        val w = canvas.width.toFloat()
+        val h = canvas.height.toFloat()
+        val str = eqStr
+        val block = beat.topBlock
+        if (locked && eqUnderClock && block != null) {
+            // under the clock, greeting and date: a short wave as wide as they are
+            val ox = (w - m.widthPixels * s) / 2f
+            val left = ox + block.left * s
+            val right = ox + maxOf(block.right, block.left + 200f * m.density) * s
+            wave(canvas, left, right, block.bottom * s + 30 * dp, (16 + 22 * str) * dp, 1f, 2.5f * dp)
+            return
+        }
+        when (eqStyle) {
+            1 -> wave(canvas, 0f, w, h - (70 + 40 * str) * dp, (24 + 60 * str) * dp, 1f, 3f * dp)
+            2 -> glow(canvas, w, h, dp, str)
+            else -> bars(canvas, w, h, dp, str)
+        }
+    }
+
+    /** Classic bars standing on the bottom edge, bass on the left. */
+    private fun bars(canvas: Canvas, w: Float, h: Float, dp: Float, str: Float) {
+        val barW = 7 * dp
+        val gap = 5 * dp
+        val count = ((w - 24 * dp + gap) / (barW + gap)).toInt().coerceAtLeast(4)
+        val used = count * barW + (count - 1) * gap
+        var x = (w - used) / 2f + barW / 2f
+        val maxH = (90 + 170 * str) * dp
+        eqPaint.style = Paint.Style.STROKE
+        eqPaint.strokeCap = Paint.Cap.ROUND
+        eqPaint.strokeWidth = barW
+        eqPaint.shader = null
+        eqPaint.color = withAlpha(eqColor, .45f + .4f * str)
+        val bottom = h - 6 * dp - barW / 2f
+        for (i in 0 until count) {
+            val len = maxOf(.001f, beat.level(i / (count - 1f)) * maxH)
+            canvas.drawLine(x, bottom, x, bottom - len, eqPaint)
+            x += barW + gap
+        }
+    }
+
+    /** Two lines of a wave between [left] and [right] around [cy] (as the widgets' wave). */
+    private fun wave(canvas: Canvas, left: Float, right: Float, cy: Float, amp: Float, alpha: Float, stroke: Float) {
+        val t = SystemClock.uptimeMillis() / 1000f
+        val w = right - left
+        val unit = stroke / 3f                                         // ≈ 1 dp
+        eqPaint.style = Paint.Style.STROKE
+        eqPaint.strokeCap = Paint.Cap.ROUND
+        eqPaint.shader = null
+        for (line in 0..1) {
+            eqPath.reset()
+            val steps = maxOf(24, (w / (4 * unit)).toInt())
+            for (i in 0..steps) {
+                val f = i / steps.toFloat()
+                val env = sin(PI.toFloat() * f)
+                val lvl = if (line == 0) beat.level(f) else beat.level(1f - f)
+                val ph = if (line == 0) f * w / (14 * unit) + t * 7f else f * w / (20 * unit) - t * 5f
+                val y = cy + sin(ph) * env * lvl * amp * if (line == 0) 1f else .75f
+                if (i == 0) eqPath.moveTo(left + f * w, y) else eqPath.lineTo(left + f * w, y)
+            }
+            eqPaint.strokeWidth = if (line == 0) stroke else stroke * .66f
+            eqPaint.color = withAlpha(eqColor, (if (line == 0) .9f else .45f) * alpha)
+            canvas.drawPath(eqPath, eqPaint)
+        }
+    }
+
+    /** A soft light rising from the bottom edge, higher where the spectrum is — and with every kick. */
+    private fun glow(canvas: Canvas, w: Float, h: Float, dp: Float, str: Float) {
+        val e = beat.energy
+        val top = h - (120 + 260 * str) * dp * (.35f + .65f * e)
+        eqPaint.style = Paint.Style.FILL
+        eqPaint.shader = android.graphics.LinearGradient(0f, h, 0f, top,
+            intArrayOf(withAlpha(eqColor, (.35f + .45f * e) * (.5f + .5f * str)), withAlpha(eqColor, 0f)), null,
+            Shader.TileMode.CLAMP)
+        canvas.drawRect(0f, top, w, h, eqPaint)
+        eqPaint.shader = null
+        // the spectrum as a soft skyline in it
+        eqPath.reset()
+        eqPath.moveTo(0f, h)
+        val steps = 48
+        val maxH = (60 + 140 * str) * dp
+        for (i in 0..steps) {
+            val f = i / steps.toFloat()
+            eqPath.lineTo(f * w, h - beat.level(f) * maxH)
+        }
+        eqPath.lineTo(w, h)
+        eqPath.close()
+        eqPaint.color = withAlpha(eqColor, .22f + .2f * str)
+        canvas.drawPath(eqPath, eqPaint)
+    }
+
+    private fun withAlpha(c: Int, a: Float) = (c and 0x00ffffff) or ((a.coerceIn(0f, 1f) * 255).toInt() shl 24)
+
+    // ------------------------------------------------------------- «Малооблачно»: the sun behind passing clouds
+
+    private val shaftShader by lazy { RuntimeShader(SHAFTS) }
+    private val shaftPaint by lazy { Paint().apply { shader = shaftShader; blendMode = BlendMode.SCREEN } }
+
+    private fun shafts(canvas: Canvas, amt: Float) {
+        val w = canvas.width.toFloat()
+        val h = canvas.height.toFloat()
+        // a cloud drifts over the sun about every 20 s and stays a few seconds
+        val occ = smooth(.25f, .85f, .5f + .5f * sin(t * 2f * PI.toFloat() / 21f)) * (.75f + .25f * sin(t * .37f))
+        // the whole picture a little dimmer while the sun is covered
+        paint.color = Color.argb((occ * .14f * amt * 255).toInt().coerceIn(0, 255), 0, 0, 0)
+        canvas.drawRect(0f, 0f, w, h, paint)
+        shaftShader.setFloatUniform("uRes", w, h)
+        shaftShader.setFloatUniform("uSun", w * .82f, h * .07f)
+        shaftShader.setFloatUniform("uT", t)
+        shaftShader.setFloatUniform("uOcc", occ)
+        shaftShader.setFloatUniform("uAmt", amt.coerceIn(0f, 1.2f))
+        canvas.drawRect(0f, 0f, w, h, shaftPaint)
+    }
+
+    // ------------------------------------------------------------- «Гроза»: the sky lights up from inside the clouds
+
+    private fun flash(canvas: Canvas, amt: Float) {
+        if (t > nextStrike) { strikeAt = t; nextStrike = t + 5f + (Math.random() * 7).toFloat() }
+        val d = t - strikeAt
+        val f = exp(-((d - .05f) * (d - .05f)) / .0012f) * .9f + exp(-((d - .3f) * (d - .3f)) / .004f) * .6f +
+            if (d > 0f && d < 1.2f) exp(-d * 3.5f) * .15f else 0f
+        val a = (f * .55f * amt).coerceIn(0f, .8f)
+        if (a < .01f) return
+        paint.color = Color.argb((a * 255).toInt(), 214, 222, 255)
+        canvas.drawRect(0f, 0f, canvas.width.toFloat(), canvas.height.toFloat(), paint)
+    }
+
+    private fun smooth(e0: Float, e1: Float, x: Float): Float {
+        val k = ((x - e0) / (e1 - e0)).coerceIn(0f, 1f)
+        return k * k * (3 - 2 * k)
+    }

<?xml version="1.0" encoding="utf-8"?>
<!--
    BlueOS: runtime permissions granted by default (on fresh data).
    SystemUI reads the calendar for the next event in the lock screen "what's next" card,
    the approximate location for the weather (0.7, Open-Meteo) and the step detector
    (so walking/running is not taken for shaking the phone).
    The launcher uses the step detector for the same reason (live widgets, Arona widget).
-->
<exceptions>
    <exception package="com.android.systemui">
        <permission name="android.permission.READ_CALENDAR" fixed="false" />
        <permission name="android.permission.ACCESS_COARSE_LOCATION" fixed="false" />
        <permission name="android.permission.ACTIVITY_RECOGNITION" fixed="false" />
    </exception>
    <exception package="com.android.launcher3">
        <permission name="android.permission.ACTIVITY_RECOGNITION" fixed="false" />
    </exception>
</exceptions>
